(tc90 "Fender<sup>TM</sup> TC-90 Thinline")
(tc90_desc
   "Com corpo semissólido de recorte duplo e ferragens cromadas fumê, a TC-90 é muito elegante e fará sua ex se arrepender de ter trocado você por um assistente jurídico."
)
(tc_deploy "Você deve ativar o Overdrive!")
(tc_drums_collect_overdrive "Deve coletar todo o Overdrive")
(tc_hopo_all "Deve executar hammer-on ou pull-off nas notas corretas")
(tc_rg_roll_all "Deve acertar todas as notas tocadas com tremolo")
(tc_rg_trill_all "Deve acertar todas as notas de trinado")
(tc_rk_whammy
