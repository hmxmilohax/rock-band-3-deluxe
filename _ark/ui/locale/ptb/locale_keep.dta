(thermalshirt_threadbare "Térmica GoTag")
(thermalshirt_threadbare_desc "Pegou! Esta térmica é totalmente \qa da vez!\q")
(thermalundertee_amsterdamcuckoo "Cuco de Amsterdã")
(thermalundertee_amsterdamcuckoo_desc
   "CUCO! CUCO! CUCO! CUCO! CUCO! CUCO!"
)
(thermalundertee_berlinwall "Tijolo no Muro de Berlim")
(thermalundertee_berlinwall_desc "Ei! Professores! Deixem esta camisa em paz!")
(thermalundertee_bostonlobstah "Lagostah de Boston")
(thermalundertee_bostonlobstah_desc
   "O babador pode parecer ridículo, mas vai proteger sua camiseta novinha de toda aquela manteiga."
)
(thermalundertee_dublinup "Dublin em Dobro!")
(thermalundertee_dublinup_desc
   "Ora, por Deus, esta é uma bela camiseta mesmo."
)
(thermalundertee_fenderbirds "Térmica Fender<sup>TM</sup>")
(thermalundertee_fenderbirds_desc
   "A Fender<sup>TM</sup> sempre manteve seu som descolado, e agora vai manter você aquecido!"
)
(thermalundertee_laretro "Camiseta Hollywood em Vinil")
(thermalundertee_laretro_desc
   "O que seria de uma visita a Hollywoodland sem uma camiseta comemorativa?"
)
(thermalundertee_moped "Devoto de Ciclomotores")
(thermalundertee_moped_desc
   "Eles são bonitinhos, rápidos e baratos - os ciclomotores, não seus colegas de banda."
)
(thermalundertee_nyliberty "Em Punk Nós Confiamos")
(thermalundertee_nyliberty_desc
   "Dê-nos seus pobres, suas camisetas, suas massas de moshers ansiando por bater cabeça..."
)
(thermalundertee_panther "Pantera Cibernética")
(thermalundertee_panther_desc
   "O que é mais ameaçador que uma pantera? Sim. Isso mesmo. Uma pantera cibernética."
)
(thermalundertee_reykjavikhekla "Mas que Hekla?")
(thermalundertee_reykjavikhekla_desc
   "Cada camiseta foi resgatada da boca de Hekla, o vulcão mais ativo da Islândia!"
)
(thermalundertee_reykjavikviking "Reykjaviking")
(thermalundertee_reykjavikviking_desc
   "Usar esta camiseta faz você se sentir como se tivesse feito sua própria viagem pessoal a Valhalla."
)
(thermalundertee_romestatue "A Vênus de Chitarra")
(thermalundertee_romestatue_desc
   "Até deusas do amor precisam estourar os alto-falantes de um amplificador de vez em quando."
)
(thermalundertee_sanfranciscobigone "O Grande!")
(thermalundertee_sanfranciscobigone_desc
   "Seu último show atingiu 8,5 na escala Richter!"
)
(thermalundertee_seattlecoffee "Homem do Café de Seattle")
(thermalundertee_seattlecoffee_desc "Café quente? Ah, simmm!")
(thermalundertee_seattleumbrellas "Chuva Sobre Você")
(thermalundertee_seattleumbrellas_desc
   "Sem estes guarda-chuvas, a chuva de Seattle vai encharcar seu cavanhaque e sua camisa de flanela."
)
(thermalundertee_thermal "Therma-stat")
(thermalundertee_thermal_desc
   "Sua mãe sempre disse para você se vestir em camadas. Nada destaca melhor sua camiseta favorita do que esta térmica."
)
(thicksweater_damaged "Suéter Desfeito")
(thicksweater_damaged_desc
   "Se quiser destruir seu suéter, faça buracos nele e prenda tudo de volta com alfinetes."
)
(thighboots_leather "Botas Altíssimas até as Coxas")
(thighboots_leather_desc
   "Estas ousadas botas são tão poderosas que talvez você precise adotar um novo apelido, como \qMadame Dangereux\q ou \qA Caça-Cretinos.\q"
)
(thighhighheel_pvc "Stilettos da Dominadora")
(thighhighheel_pvc_desc
   "Domine seus fãs com estas formidáveis botas de salto alto."
)
(thintank_amsterdamwindmill "O Moinho")
(thintank_amsterdamwindmill_desc
   "Seja moendo produtos agrícolas ou fazendo sua melhor imitação de astro do rock de arena, o Moinho é realmente icônico."
)
(thintank_ludwig "Regata Ludwig®")
(thintank_ludwig_desc
   "Ama seu kit Ludwig? Mostre ao mundo usando esta regata!"
)
(thintank_parisbikes "Bicyclettes de Paris")
(thintank_parisbikes_desc "Uma lembrança da sua própria Tour de France.")
(thintank_printed "Passeio Mágico de Regata")
(thintank_printed_desc
   "Você nunca sabe o que pode encontrar quando usa esta pequena regata."
)
(thintank_riokidney "Regata Rio")
(thintank_riokidney_desc "Quando seu amor sorrir para você, vá para o Rio.")
(thintank_solid "Regata Camden Calling")
(thintank_solid_desc
   "Esta linda regata vai levar você direto ao topo do dial."
)
(thintank_vater "Regata Vater Drumsticks")
(thintank_vater_desc
   "Marque o ritmo com suas baquetas Vater usando esta linda regata."
)
(thrash "Thrash")
(tiedshirt_plaid "Reputação Xadrez")
(tiedshirt_plaid_desc
   "Você pode fazer o que quiser com esta parte de cima ousada."
)
(tiedshirt_plain "Noites de Cetim Apertado")
(tiedshirt_plain_desc
   "Sua mãe não ensinou a diferença entre \qatenção boa\q e \qatenção ruim\q?"
)
(tiedtallboots_suede "Princesa Guerreira")
(tiedtallboots_suede_desc "Calce estas botas e mostre sua espada para eles!")
(tiedtube_cotton "Bandeau Ballet")
(tiedtube_cotton_desc
   "Este sensual top bandeau vai fazer a plateia dar piruetas pelo seu battement fondu. Mmm... fondu."
)
(tie_token "Empate!")
(tightcottonpants_pattern "Doce & Tartan")
(tightcottonpants_pattern_desc
   "Como é doce usar estas calças de algodão com um caimento impecável."
)
(tightdistressedpants_jeans "Especiais de Seattle")
(tightdistressedpants_jeans_desc
   "Assim como os anos 90, o grunge e a flanela, estes jeans nos levam de volta a uma época em que era descolado nunca lavar o cabelo."
)
(tighterpants_plaidpunx "Calças Wreckless")
(tighterpants_plaidpunx_desc
   "Abandone imprudentemente todas as suas ideias preconcebidas sobre estilo. Com estas calças, você vai se destacar até na roda punk mais lotada."
)
(tightjeans_denim "Abraça-Bumbum")
(tightjeans_denim_desc
   "Você não passa todo esse tempo na academia à toa -- balance o que sua mãe (e seu personal trainer) lhe deram com estes jeans justos."
)
(tightjeans_faded "Tragically Hipsters")
(tightjeans_faded_desc
   "Procurando um lugar onde tudo acontece? Estes jeans de cintura baixa são esse lugar!"
)
(tightpants_checkered "Damas ou Xadrez")
(tightpants_checkered_desc
   "Seja a rainha do tabuleiro sem precisar penhorar suas coisas! Estas calças xadrez vão dar um xeque-mate depois do show!"
)
(tightpants_sequins "Lantejoulencial")
(tightpants_sequins_desc
   "Lantejoulas brilhantes transformam estas calças numa bola de discoteca de puro poder metálico!"
)
(tightpants_skeletonprint "Calças Esqueléticas")
(tightpants_skeletonprint_desc
   "Estas calças que afinam a silhueta trazem detalhes sinistros que brilham no escuro. Use-as com a Camiseta Esquelética para obter o efeito máximo."
)
(timberlandboots_muddy "Nubucks")
(timberlandboots_muddy_desc
   "Nada melhor para carregar equipamentos pela lama e pelo granizo. E, pelo visto, também são muito boas para fazer trilhas."
)
(tirearmor_rubber "Armadura de Pneus")
(tirearmor_rubber_desc
   "Combine agressividade bruta com compromisso com a reciclagem usando esta feroz armadura feita de pneus de trailers."
)
