(beat_replay "Repetir batida")
(bedazzledversaillesjacket_sparkly "Vestígios Régios")
(bedazzledversaillesjacket_sparkly_desc
   "Um vestígio de sua glória passada (ou futura?). Fica resplandecente em você."
)
(bellbottoms_jeans "Calças Boca de Sino")
(bellbottoms_jeans_desc
   "Você deveria estar dançando (yeah) com estas calças boca de sino retro deliciosas."
)
(beltedspandex_lycra "Perneiras da Fera")
(beltedspandex_lycra_desc
   "Meias cano alto POR FORA das perneiras justas - o conjunto ideal para executar um chute tesoura deslumbrante."
)
(beltedtee_fishnetsleeves "Belo Filé")
(beltedtee_fishnetsleeves_desc
   "Dê um peixe a alguém e ele comerá por um dia. Dê a ele este top e ele terá que lutar contra os peixes."
)
(beltskirt_denim "Gênio Jeans")
(beltskirt_denim_desc "Use o visual DIY com esta mini reestruturada.")
(berlin "Berlim")
(berzerkerboot_spiked "Lobo Pisoteador")
(berzerkerboot_spiked_desc
   "Estas botas pesadas são o calçado perfeito para sair pela estrada e procurar aventura."
)
(best_percentage "Melhor")
(beta57_resource "Shure Beta 57")
(beta57_resource_desc
   "A grade de aço do Shure Beta 57 resiste ao desgaste e aos abusos... ao contrário do seu baixista chorão ultra sensível."
)
(beta87_resource "Shure Beta 87A")
(beta87_resource_desc
   "Além de ter uma resposta de frequência particularmente suave, o Shure Beta 87A opera com alimentação fantasma, o que deve adicionar um pouco de mistério e intriga até mesmo à performance mais direta. Alimentação fantasma!"
)
(bigger_riff "Riff Grandioso")
(bigstraps_rubber "De Volta às Alças")
(bigstraps_rubber_desc
   "Você chegou ao mapa! Viajando pelo mundo ou pela sua masmorra favorita, este top vai te servir bem."
)
(bigzipperpants_denim "Denim Preto Kohl")
(bigzipperpants_denim_desc
   "Você escreve no seu diário com delineador preto."
)
(big_club "Clube Grande")
(big_riff_1 "Riff Grande 1")
(big_riff_2 "Riff Grande 2")
(big_rock_ending "Final Triunfante!")
(bikershortsflannel_spandex "Calças Curtas Minhas")
(bikershortsflannel_spandex_desc
   "Com esta combinação atemporal, você vai sentir que está batendo, batendo, batendo nas portas do céu."
)
(bikinichain_camo "Garota Panzer")
(bikinichain_camo_desc
   "Em cima de um tanque ou na frente do palco, este top de biquíni vai te manter fresca enquanto parece gostosa!"
)
(bikinichain_chainmail "Corrente é")
(bikinichain_chainmail_desc
   "O tempo pode te acorrentar, mas você pode traçar a corrente. Vire-se e encare a corrente."
)
(bikinichain_lace "Rastro de Renda")
(bikinichain_lace_desc
   "Este biquíni com acabamento em renda é perfeito para a praia, ou para o porão, se você quiser manter seu belo palor."
)
(bikinichain_leopard "Você Jane")
(bikinichain_leopard_desc
   "Seja a Rainha da Selva com este top de biquíni delicado e doce."
)
(bikinichain_metal "Peitoral")
(bikinichain_metal_desc
   "Mantenha-se atualizada com as tendências de armaduras com este top de biquíni pequeno e protetor."
)
(bikinichain_print "Divisor de Átomos")
(bikinichain_print_desc
   "Cuidado: top de biquíni causa radiação extrema de... gostosura!"
)
(bikinichain_skull "Caveira Cruzada")
(bikinichain_skull_desc
   "Represente seu apreço pela cultura pirata, sem toda a navegação, caminhar sobre pranchas e escorbuto!"
)
(bikinichain_solid "Biquíni Sólido")
(bikinichain_solid_desc
   "Você não está usando este top de biquíni para exibir seus atributos; sob aquelas luzes quentes de palco, é a única escolha \qsólida\q se você quiser evitar manchas de suor do tamanho de bandejas de salgadinhos."
)
