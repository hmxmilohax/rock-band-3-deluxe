(barbarianbelt_iron "Cinto do Usurpador")
(barbarianbelt_iron_desc
   "Às vezes, a dominação total é a única maneira de conquistar a lealdade da multidão. Mostre a esses tolos quem é o Rei."
)
(barbedwirepants_denim "Farpos Torcidos")
(barbedwirepants_denim_desc
   "Os detalhes em arame farpado ao redor das pernas desta calças jeans combinam com os que envolvem seu coração."
)
(baseballteetorn_stitched "Camiseta Overlock de Coração Aberto")
(baseballteetorn_stitched_desc
   "Esta camiseta passou pela faca para que você possa parar corações sempre que a vestir."
)
(baseballtee_10k "Corrida Divertida de 10K")
(baseballtee_10k_desc
   "Finja que participou de uma corrida beneficente e ganhe pontos de \qboa moça\q com esta útil camiseta de brechó."
)
(baseballtee_ernieball "Camiseta Ernie Ball")
(baseballtee_ernieball_desc
   "Esta camiseta Ernie Ball fará você se sentir uma estrela... sem compromisso."
)
(baseballtee_fender "Camiseta Fender<sup>TM</sup>")
(baseballtee_fenderpheonix "Camiseta Baseball Phoenix Fender<sup>TM</sup>")
(baseballtee_fenderpheonix_desc
   "Como uma fênix renascendo das cinzas, seu jeito de tocar guitarra também renasceu das cinzas de professores de guitarra tragicamente ruins."
)
(baseballtee_fenderstars "Camiseta Baseball Estrelas Fender<sup>TM</sup>")
(baseballtee_fenderstars_desc
   "A Fender<sup>TM</sup> ajudou a transformar você em uma estrela, então demonstre seu carinho com esta excelente camiseta baseball."
)
(baseballtee_fender_desc
   "Apaixonado pela sua Fender<sup>TM</sup>? Sua camiseta também está!"
)
(baseballtee_ludwigdragon "Camiseta Baseball Dragão Ludwig®")
(baseballtee_ludwigdragon_desc
   "Eles nunca vão arrastar você para longe do seu kit Ludwig -- deixe isso claro com esta camiseta baseball de dragão da Ludwig!"
)
(baseballtee_ludwigfloral "Camiseta Baseball Floral Ludwig®")
(baseballtee_ludwigfloral_desc
   "Mostre seu amor crescente pela Ludwig com esta camiseta baseball floral."
)
(baseballtee_madridcrest "Brasão da Espanha")
(baseballtee_madridcrest_desc
   "Outro termo para tourada é \qtauromaquia.\q E outro termo para \qnos odiamos completamente\q é \qdiferenças criativas.\q"
)
(baseballtee_montrealfrench "Parlez-vous Québécois?")
(baseballtee_montrealfrench_desc
   "Montréal: uma cidade de tremenda história e beleza. E também poutine!"
)
(baseballtee_musclecar "Muscle Car")
(baseballtee_musclecar_desc
   "A potência bruta de um muscle car clássico é mais intoxicante do que uma longa noite no camarim."
)
(baseballtee_promark "Camiseta Baseball Promark<sup>TM</sup>")
(baseballtee_promark_desc
   "A Promark<sup>TM</sup> tem sido boa com você -- retribua o favor com esta camiseta baseball radical."
)
(baseballtee_reykjavikelf "Travessia de Elfos em Reykjavik")
(baseballtee_reykjavikelf_desc
   "Olhe para os dois lados antes de atravessar a Austurstraeti."
)
(baseballtee_seattledrums "Pratos Espaciais de Seattle")
(baseballtee_seattledrums_desc
   "Nenhuma bateria está completa sem um hi-hat de 184 metros."
)
(baseballtee_solid "Garota Americana")
(baseballtee_solid_desc
   "Vai com calma, baby. Você pode aguentar a noite toda com esta camiseta confortável."
)
(baseballtee_sydneykanga "Joey de Bolso")
(baseballtee_sydneykanga_desc
   "O Joey de Bolso é o segundo marsupial australiano mais letal. O primeiro, é claro, é o Urso-da-Queda."
)
(basictee_austinbullets "Não Mexa com o Texas")
(basictee_austinbullets_desc "Sim, esses são buracos de bala serigrafados.")
(basictee_bigapple "Nova Iorque Engraçada")
(basictee_bigapple_desc
   "Os nova-iorquinos realmente odeiam o termo \qBig Apple\q - então é divertido dizer isso a eles O TEMPO TODO."
)
(basictee_broadcast "66.6 FM WHMX")
(basictee_broadcast_desc
   "Transmita seu amor por rádios universitárias estranhas e obscuras com esta camiseta descolada."
)
(basictee_chicagomob "Irmãos de Chicago")
(basictee_chicagomob_desc "\qNós temos seus instrumentos bem aqui, viu!\q")
(basictee_chopper "Motocicletas Rossi")
(basictee_chopper_desc
   "Não é necessário possuir uma motocicleta real para usar a camiseta."
)
(basictee_dwdrums "Camiseta DW Drums")
(basictee_dwdrums_desc
   "As baterias DW sempre trataram você bem, e esta camiseta bonita e confortável também vai!"
)
(basictee_dwwings "Camiseta DW Wings")
(basictee_dwwings_desc
   "Não sabe o que vai tocar no solo de bateria hoje? Apenas improvise enquanto veste esta camiseta estilosa da DW."
)
(basictee_eh "Camiseta Electro-Harmonix<sup>TM</sup>")
(basictee_eh_desc
   "Represente seus pedais de efeito favoritos com esta camiseta simples."
)
(basictee_emg "Camiseta EMG")
(basictee_emg_desc
   "Você não teria ido longe na sua carreira musical sem a EMG -- então não vá longe sem esta camiseta."
)
(basictee_ernieballcrest "Camiseta Brasão Ernie Ball")
(basictee_ernieballcrest_desc
   "A Ernie Ball se tornou como uma família para você - então use o brasão da Ernie Ball com orgulho!"
)
(basictee_ernieballheart "Camiseta Coração Ernie Ball")
(basictee_ernieballheart_desc
   "O pioneiro das cordas de guitarra rock and roll quer que você toque com o coração na manga! Ou na camiseta, como preferir."
)
(basictee_fenderskull "Camiseta Caveira Fender<sup>TM</sup>")
(basictee_fenderskull_desc
   "Coloque isso na cabeça dos seus fãs -- você é uma garota Fender<sup>TM</sup> para sempre."
)
(basictee_freaks "Bebê de Coney Island")
(basictee_freaks_desc
   "E você pensou que o único \qshow de horrores\q na sua vida era a coleção de ex-namoradas abertamente hostis do baterista."
)
(basictee_gretschdrums "Camiseta Gretsch<sup>TM</sup> Drums")
(basictee_gretschdrums_desc
   "Faça uma propaganda da Gretsch com esta camiseta incrível."
)
(basictee_londonguard "Guarda do Palácio Rockingham")
(basictee_londonguard_desc
   "Eles estão trocando a guarda no Palácio Rockingham, vá perguntar à Alice."
)
(basictee_louvre "Paris é para Louvre")
(basictee_louvre_desc
   "Finalmente revelado: o trocadilho que fez Mona Lisa sorrir."
)
(basictee_ludwigsticks "Camiseta Ludwig®")
(basictee_ludwigsticks_desc
   "Mostre sua devoção à Ludwig Drums com esta camiseta estilosa."
)
(basictee_matroishka "Matroishka de Moscou")
(basictee_matroishka_desc
   "Todos os gêneros musicais felizes e aninhados, como em uma campanha de arrecadação contra a fome mundial."
)
(basictee_of "Quedas de Oconto")
(basictee_of_desc
   "Represente a \qjoia do Centro-Oeste\q com esta joia nostálgica."
)
(basictee_parisian "Camiseta Oui Oui Paris")
(basictee_parisian_desc "Oh-ho-ho-ho, esta camiseta é magnífica.")
(basictee_pearlwings "Camiseta Pearl")
(basictee_pearlwings_desc
   "Mostre ao mundo o quanto você ama sua bateria Pearl com esta camiseta estilosa."
)
(basictee_phase "Camiseta Phase")
(basictee_phase_desc "Sua música é o jogo!")
(basictee_proliferation "Camiseta Proliferação Nuclear")
(basictee_proliferation_desc
   "Esta banda perdeu parte de sua base de fãs ao criar o primeiro álbum infantil educativo de grindcore do mundo, \qVamos Contar Todos Muito Muito Rápido.\q"
)
(basictee_rbbass "Camiseta Baixo")
(basictee_rbbass_desc
   "Mostre sua lealdade ao seu instrumento ou músico favorito com esta camiseta com o logo do baixo."
)
(basictee_rbdrums "Camiseta Bateria")
(basictee_rbdrums_desc
   "Mostre sua lealdade ao seu instrumento ou músico favorito com esta camiseta com o logo da bateria."
)
(basictee_rbfour "Camiseta Todos os Quatro")
(basictee_rbfour_desc "Não consegue decidir? Leve todos os quatro!")
