(main_menu_welcome
   "Bem-vindo ao Rock Band 3!  Sua banda está pronta para começar sua carreira. Você pode personalizar o nome dela e a sua aparência agora, ou você pode ir direto para a ação (você pode voltar e personalizar sua banda sempre que quiser)."
)
(main_playerprofile_button "Minha Banda")
(main_riff "Riff Principal")
(main_riff_1 "Riff Principal 1")
(main_riff_2 "Riff Principal 2")
(main_riff_3 "Riff Principal 3")
