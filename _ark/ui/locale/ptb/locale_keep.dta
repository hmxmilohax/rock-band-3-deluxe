)
(pants "calças")
(pantsandlegwarmers_laced "Polainas & Renda Velha")
(pantsandlegwarmers_laced_desc
   "Não fique aí parado esperando ser amarrado e arrastado para o palco! Estas calças discretamente listradas ficam perfeitas amarradas sobre polainas combinando."
)
(pantsspandex_spandex "Armado e Apertado")
(pantsspandex_spandex_desc
