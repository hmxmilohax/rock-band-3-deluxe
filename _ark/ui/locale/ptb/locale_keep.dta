(synth_break "Parada Sintetizador")
(synth_solo "Solo Sintetizador")
(tallboots_solid "Botas de Combate")
(tallboots_solid_desc
   "Você nunca mais terá medo de uma roda punk — nem de uma poça — usando estas clássicas botas de combate."
)
(tallbuttonboots_embroidered "Cisnes Líricos")
(tallbuttonboots_embroidered_desc
   "Elimine aquela tristeza de patinho feio com as botas mais detalhadas e bonitas do lugar."
)
(talldocsfolded_solid "Botas Infinitas")
(talldocsfolded_solid_desc "Você tem botas. Sabe como usá-las!")
(tallfoldedboots_solid "Botas para Caminhar")
(tallfoldedboots_solid_desc "Estas botas foram feitas para isso.")
(tallgogos_vinyl "Me Acorde Antes das Go-Go")
(tallgogos_vinyl_desc
