(suitbottom_solid "Calças de Terno para Impressionar")
(suitbottom_solid_desc
   "Experimente estas calças e prove de uma vez por todas quem realmente manda na sua banda."
)
(suitpants_cotton "Calças de Trabalhador")
(suitpants_cotton_desc
   "Corra e compre estas elegantes calças -- garantia de ajudar você a viver sua vida muito melhor do que imagina."
)
(suittop_solid "Blazer para Impressionar")
(suittop_solid_desc
   "O mundo do trabalho pode realmente colocar você para baixo, para baixo, para baixo. Mas pelo menos você vai estar com um visual de um milhão de dólares."
)
(summonerleggings_burlap "Leggings do Invocador")
(summonerleggings_burlap_desc
   "Ah, Invocador, que poder você tem para fazê-los sofrer e ainda gostar disso."
)
(summonerrobe_burlap "Manto do Invocador")
(summonerrobe_burlap_desc
   "No meio do inverno, você finalmente descobrirá que existe um Invocador invencível dentro de você."
)
(summonershoes_burlap "Sapatos do Invocador")
(summonershoes_burlap_desc
   "Os sapatos de Invocador normalmente têm uma vida curta demais, mas não estes! A construção resistente significa que vão durar por muitos e muitos feitiços."
)
(sunburst "Two-color Sunburst")
(sunburstblack "Black & 2-color Sunburst")
(sunburstpearl "Pearl & 2-color Sunburst")
(sunbursttortoise "Tortoiseshell & Sunburst")
(sunburstwhite "White & 2-color Sunburst")
(superhightops_leopard "Ultratops de Pele de Leopardo")
(superhightops_leopard_desc
   "Você vai ficar superferoz com estes tênis de cano superalto!"
)
(supersonic "Squier<sup>TM</sup> Super-Sonic<sup>TM</sup>")
(supersonic_desc
   "A silhueta única da Super-Sonic<sup>TM</sup> só poderia ser mais irada se conseguisse dar um chute giratório na cara de um terremoto. Com headstock invertido e corpo de basswood, é difícil acreditar que a Fender<sup>TM</sup> tenha descontinuado esta fera."
)
(surf "Surf")
(suspendedpants_plaid "Shorts Longos Molotov")
(suspendedpants_plaid_desc
   "Com certeza vão incentivar suas tendências revolucionárias, estes shorts incendiários são xadrez e anárquicos!"
)
(suspenderpants_frayed "Edição Cemitério")
(suspenderpants_frayed_desc
   "Estes shorts cortados foram deixados apodrecendo no chão até adquirirem aquele visual de \qrecém-saído da cova\q que você deseja."
)
(suspendersteeshirt_suspenders "Preparado para a Briga")
(suspendersteeshirt_suspenders_desc
   "Calce suas botas de biqueira de aço com 14 ilhoses -- estes suspensórios com tachas vão fazer todo mundo gritar \qOi!\q"
)
(suspenders_solid "Mamma Mia")
(suspenders_solid_desc
   "Esta blusa estilosa é ainda mais quente do que uma massagem nos pés proibida. Perfeita para uma noite na lanchonete ou para sair pela cidade!"
)
(suspenders_studded "Suspensórios com Tachas")
(suspenders_studded_desc
   "Você não vai querer que suas calças caiam, vai?"
)
(sweatervest_patched "Colete Argyle de Brechó")
(sweatervest_patched_desc
   "Resgatado da seção de um dólar do brechó e usado com orgulho grunge."
)
(swinger "Fender<sup>TM</sup> Swinger")
(swinger_desc
   "Também chamada de Musiclander ou Arrow, a Fender<sup>TM</sup> Swinger é uma curiosa Franken-guitarra composta por peças de instrumentos Fender<sup>TM</sup> anteriores -- realmente um pequeno monstro e tanto."
)
(swing_riff_1 "Swing Riff 1")
(swing_riff_2 "Swing Riff 2")
(swing_riff_3 "Swing Riff 3")
(swing_riff_4 "Swing Riff 4")
(switch_record_labels "Trocar de Gravadora")
(sydney "Sydney")
(symbol_sort "0-9")
(synchromatic
   "Gretsch<sup>TM</sup> G6040MCSS Synchromatic<sup>TM</sup> Cutaway, Filter'Tron<sup>TM</sup>"
)
(synchromatic_desc
   "Coloque uma grande fivela de cinto e faça todos chorarem com esta versão personalizada da inovadora 400C, equipada com as desejadas aberturas acústicas Cat's Eye e uma exclusiva ponte em degraus."
)
(synth "Sintetizador")
(synth_break "Parada de Sintetizador")
(synth_solo "Solo de Sintetizador")
(tallboots_solid "Botas de Combate")
(tallboots_solid_desc
   "Você nunca mais vai temer uma roda de mosh (ou uma poça) usando estas clássicas botas de combate."
)
(tallbuttonboots_embroidered "Cisnes Líricos")
(tallbuttonboots_embroidered_desc
   "Acabe com aquela tristeza de patinho feio usando as botas mais belas e detalhadas destas terras."
)
(talldocsfolded_solid "Botas Infinitas")
(talldocsfolded_solid_desc "Você tem botas. E sabe muito bem como usá-las!")
(tallfoldedboots_solid "Botas de Caminhada")
(tallfoldedboots_solid_desc "Estas botas foram feitas para isso.")
(tallgogos_vinyl "Wake Me Up Before You Go-Gos")
(tallgogos_vinyl_desc
   "Você vai colocar o boom-boom no coração deles com estas ferozes botas go-go retrô."
)
(tamb_rating_1 "PÉSSIMO")
(tamb_rating_2 "CONFUSO")
(tamb_rating_3 "FRACO")
(tamb_rating_4 "OK")
(tamb_rating_5 "DEDICADO")
(tamb_rating_6 "INCRÍVEL!")
(tanktopscarf_unionjack "União Negativa")
(tanktopscarf_unionjack_desc
   "Encha-se de Esperança e Glória da próxima vez que destruir seu equipamento nos bastidores."
)
(tanktop_bostonmass "Apelo em Massa")
(tanktop_bostonmass_desc
   "Massachusetts: leis puritanas, caras barulhentos chamados Murph e impostos altos pra caramba. Como não amar?"
)
(tanktop_lasurfteam "Regata Venice Beach")
(tanktop_lasurfteam_desc
   "Perfeita para passear por Los Angeles, fazer hang ten e levantar surfistas de araque."
)
(tanktop_montrealleaf "Fã de Hóquei de Montréal")
(tanktop_montrealleaf_desc
   "...Como se fosse possível ser do Canadá e NÃO ser fã de hóquei."
)
(tanktop_nyhc "Hardcore de NY")
(tanktop_nyhc_desc
   "Nova York, Nova York, é uma cidade e tanto. O X está em cima e o Y está embaixo."
)
(tanktop_prismaticcheetah "Sem Mangas em Seattle")
(tanktop_prismaticcheetah_desc
   "Regata de oncinha procura Diva do Rock para ensaios fotográficos cheios de estilo e longas noites em shows."
)
(tanktop_rioparrot "Vida Selvagem do Rio")
(tanktop_rioparrot_desc
   "Que estranho papagaios, algumas das criaturas mais inteligentes da Terra, terem se tornado associados a festas em estacionamentos, camisas espalhafatosas e tios embriagados."
)
(tanktop_solid "Regata do Topo")
(tanktop_solid_desc "Esta regata vai levar você direto ao topo!")
(tanktop_sydneysurf "Isca de Tubarão de Sydney")
(tanktop_sydneysurf_desc
   "Regra nº 1 de Bondi: nade entre as bandeiras ou acabe com uma baita mordida na tampa do seu cooler ou na sua prancha favorita."
)
(tanktop_tokyooctopus "Cefalópodes sobre Tóquio")
(tanktop_tokyooctopus_desc "É imparável! Corram por suas vidas!")
(tartan_plaid "Xadrez com Fogo")
(tartan_plaid_desc
   "...Mas você não se queimou com esta desconstrução moderna."
)
(tatteredshoe_dirty "Chuteiras de Adolescentes")
(tatteredshoe_dirty_desc
   "Estes velhos tênis esfarrapados já passaram por muita coisa com você. Como detenção. E aula de educação física."
)
(tatteredshoe_homeless "Tênis de Cano Alto de Andarilho")
(tatteredshoe_homeless_desc
   "Estes tênis esfarrapados combinam muito bem com miojo, luvas sem dedos e apartamentos com cheiro de removedor de esmalte."
)
(tattoo_left_arm "Braço Esquerdo")
(tattoo_left_leg_back "Perna Esquerda (Atrás)")
(tattoo_left_leg_front "Perna Esquerda (Frente)")
(tattoo_left_shoulder "Ombro Esquerdo")
(tattoo_right_arm "Braço Direito")
(tattoo_right_leg_back "Perna Direita (Atrás)")
(tattoo_right_leg_front "Perna Direita (Frente)")
(tattoo_right_shoulder "Ombro Direito")
(tattoo_torso_back "Costas")
(tattoo_torso_front "Peitoral")
(tc90 "Fender<sup>TM</sup> TC-90 Thinline")
(tc90_desc
   "Com corpo semiacústico de cutaway duplo e ferragens cromadas fumê, a TC-90 é pura classe, destinada a fazer seu ex se arrepender de ter trocado você por um assistente jurídico."
)
(tc_deploy "Você deve ativar o Overdrive!")
(tc_drums_collect_overdrive "Você deve coletar todo o Overdrive")
(tc_hopo_all "Você deve executar Hammer-On ou Pull-Off nas notas corretas")
(tc_rg_roll_all "Você deve acertar todas as notas com palhetada tremolo")
(tc_rg_trill_all "Você deve acertar todas as notas de trinado")
(tc_rk_whammy
   "Você deve usar a faixa de pitch por um segundo após ativar o Overdrive"
)
(tc_roll_all "Você deve acertar todas as notas de rufo")
(tc_sustain "Você deve sustentar todas as notas")
(tc_trill_all "Você deve acertar todas as notas de trinado")
(teardropbass_resource "O Baixo Lágrima")
(teardropbass_resource_desc
   "Com suas linhas limpas, design revolucionário e braço pintado à mão, O Lágrima remete a uma época anterior às guitarras com formato de lobisomens enfurecidos."
)
(teardrop_resource "O Lágrima")
(teardrop_resource_desc
   "Com suas linhas limpas, design revolucionário e braço pintado à mão, O Lágrima remete a uma época anterior às guitarras com formato de lobisomens enfurecidos."
)
(techno "Techno")
(teen "Adolescente")
(telebass "Squier<sup>TM</sup> Vintage Modified Precision Bass® TB")
(telebass_desc
   "Com seu grande captador humbucker e linhas clássicas, este baixo traz de volta tudo o que havia de melhor no rock dos anos 70, uma década em que você provavelmente nem era nascido."
)
(telecaster01 "Fender<sup>TM</sup> Classic '50s Telecaster<sup>TM</sup>")
(telecaster01_desc
   "Conhecida primeiro como Esquire<sup>TM</sup>, e depois como Broadcaster, esta guitarra clássica acabou recebendo o nome de uma invenção popular da época - a televisão."
)
(telecaster02 "Fender<sup>TM</sup> 1969 Thinline Telecaster<sup>TM</sup>")
(telecaster02_desc
   "A Thinline Tele<sup>TM</sup> incorpora câmaras ocas, que reduzem o peso da guitarra, proporcionam um timbre mais ressonante e permitem que uma Tele ostente aquela elegante abertura em f."
)
(telecaster03 "Fender<sup>TM</sup> 1972 Telecaster<sup>TM</sup> Deluxe")
(telecaster03_desc
   "Os anos 70 foram uma época de excessos tanto para os músicos quanto para seus instrumentos. Esta Tele<sup>TM</sup> tem dois captadores humbucker, um escudo com curvas voluptuosas e até um headstock de Stratocaster<sup>TM</sup>."
)
(telecaster04 "Fender<sup>TM</sup> Custom Telecaster<sup>TM</sup> FMT HH")
(telecaster04_desc
   "Às vezes, os escudos simplesmente atrapalham. E às vezes você precisa de dois captadores humbucker para garantir que seja ouvido alto e claro. Se este é um desses momentos, você precisa desta guitarra."
)
(telecaster05
   "Fender<sup>TM</sup> J5 Triple Telecaster<sup>TM</sup> Deluxe"
)
(telecaster05_desc
   "Se você quer que sua guitarra grite \qagressividade,\q esta Tele<sup>TM</sup>, com seu terceiro captador humbucker, ponte de tremolo vintage e escudo cromado, é ideal. Só não tente passar com ela escondida por nenhum detector de metais."
)
(telecaster06 "Fender<sup>TM</sup> 1959 Custom Telecaster<sup>TM</sup>")
(telecaster06_desc
   "Alguns dizem que o segredo do inimitável twang da Tele<sup>TM</sup> da era de ouro está em alguma influência alquímica da tampa ferrosa \qcinzeiro\q da ponte sobre o campo magnético ao redor do captador da ponte."
)
