(tanktopscarf_unionjack "União Negativa")
(tanktopscarf_unionjack_desc
   "Encha-se de Esperança e Glória na próxima vez que destruir seu equipamento nos bastidores."
)
(tanktop_bostonmass "Apelo de Massa")
(tanktop_bostonmass_desc
   "Massachusetts: leis puritanas, sujeitos barulhentos chamados Murph e impostos absurdamente altos. Como não amar?"
)
(tanktop_lasurfteam "Regata Venice Beach")
(tanktop_lasurfteam_desc
   "Perfeita para passear por Los Angeles, pegar ondas e impressionar os surfistas."
)
(tanktop_montrealleaf "Fã de Hóquei de Montréal")
(tanktop_montrealleaf_desc
   "...Como se fosse possível ser do Canadá e NÃO gostar de hóquei."
)
(tanktop_nyhc "Hardcore de Nova York")
(tanktop_nyhc_desc
   "Nova York, Nova York, é uma cidade e tanto. O X fica em cima e o Y embaixo."
)
(tanktop_prismaticcheetah "Sem Mangas em Seattle")
(tanktop_prismaticcheetah_desc
   "Regata com Estampa de Leopardo procura Diva do Rock para sessões de fotos modernas e longas noites de show."
)
(tanktop_rioparrot "Vida Selvagem do Rio")
(tanktop_rioparrot_desc
   "É estranho que papagaios, algumas das criaturas mais inteligentes da Terra, tenham sido associados a festas em estacionamentos, camisas chamativas e tios embriagados."
)
(tanktop_solid "Regata Topo")
(tanktop_solid_desc "Esta regata levará você direto ao topo!")
(tanktop_sydneysurf "Isca de Tubarão de Sydney")
(tanktop_sydneysurf_desc
   "Regra nº 1 de Bondi: nade entre as bandeiras ou acabe com uma enorme mordida na tampa do seu cooler ou na sua prancha favorita."
)
(tanktop_tokyooctopus "Cefalópodes sobre Tóquio")
(tanktop_tokyooctopus_desc "É imparável! Corram por suas vidas!")
(tartan_plaid "Xadrez em Chamas")
(tartan_plaid_desc
   "...Mas você não se queimou com esta desconstrução moderna."
)
(tatteredshoe_dirty "Chutes Adolescentes")
(tatteredshoe_dirty_desc
   "Estes velhos tênis esfarrapados passaram por muita coisa com você. Como detenção. E aula de educação física."
)
(tatteredshoe_homeless "Tênis de Cano Alto de Mendigo")
(tatteredshoe_homeless_desc
   "Estes tênis esfarrapados combinam muito bem com miojo, luvas sem dedos e apartamentos com cheiro de removedor de esmalte."
)
