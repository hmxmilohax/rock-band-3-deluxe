(boapants_boaprint "Calças com Estampa de Jiboia")
(boapants_boaprint_desc
   "Eles vão saber que você é uma cobra, mas ainda assim não conseguirão resistir a você com estas calças estampadas."
)
(bodiddley "Gretsch<sup>TM</sup> G6138 Bo Diddley")
(bodiddley_desc
   "\qO pioneiro\q do rock and roll, Bo Diddley revolucionou a forma de tocar guitarra e mudou o rumo da história da música. Preste sua homenagem com esta reprodução fiel de sua exclusiva Gretsch<sup>TM</sup> retangular de 1958. Descanse em paz, Bo Diddley."
)
(bodiddley_resource "Gretsch<sup>TM</sup> G6138 Bo Diddley")
(bodiddley_resource_desc
   "\qO pioneiro\q do rock and roll, Bo Diddley revolucionou a forma de tocar guitarra e mudou o rumo da história da música. Preste sua homenagem com esta reprodução fiel de sua exclusiva Gretsch<sup>TM</sup> retangular de 1958. Descanse em paz, Bo Diddley."
)
