)
(femaleundies_cotton "Exemplos de Calcinhas")
(femaleundies_cotton_desc
   "Você já viu Londres, já viu a França e ainda não aprendeu a colocar uma calça?"
)
(femalewrist_avrilsock "Aquecedor de Pulso Listrado")
(femalewrist_avrilsock_desc
   "Somente as melhores meias previamente usadas foram utilizadas para fabricar este aquecedor de pulso cheio de buracos."
)
(femalewrist_barbedwire "Pulseiras de Corda do Diabo")
(femalewrist_barbedwire_desc
   "As farpas foram dobradas para fora para sua proteção, mas seus fãs não saberão disso. Eles apenas verão o quanto você é radical!"
)
(femalewrist_barbedwire_right "Corda do Diabo (Individual)")
(femalewrist_barbedwire_right_desc
   "As farpas foram dobradas para fora para sua proteção, mas seus fãs não saberão disso. Eles apenas verão o quanto você é radical!"
)
(femalewrist_checkerpyramids "Munhequeiras de Missão Cumprida")
(femalewrist_checkerpyramids_desc
   "Sua lista de conquistas impressionantes continua crescendo. Use estas munhequeiras como lembrança de tudo o que ficou destruído em seu caminho."
)
(femalewrist_checkerpyramids_right "Munhequeira de Missão Cumprida (Individual)")
(femalewrist_checkerpyramids_right_desc
   "Sua lista de conquistas impressionantes continua crescendo. Use esta munhequeira como lembrança de tudo o que ficou destruído em seu caminho."
)
(femalewrist_eagle "Braçadeira Usada nos EUA")
(femalewrist_eagle_desc
   "Voe livre nas asas da grandiosidade com esta braçadeira extremamente patriótica."
)
(femalewrist_gauntlet "Manoplas com Fivelas")
(femalewrist_gauntlet2 "Manopla com Espinhos")
(femalewrist_gauntlet2_desc
   "Nunca é possível ter manoplas com espinhos demais... sério."
)
(femalewrist_gauntlet_desc
   "Estes incríveis acessórios de couro também são valiosos por sua capacidade de sustentar os pulsos."
)
(femalewrist_gauntlet_right "Manopla com Fivelas (Individual)")
(femalewrist_gauntlet_right_desc
   "Este incrível acessório de couro também é valioso por sua capacidade de sustentar o pulso."
)
(femalewrist_hercules "Munhequeiras do Herói")
(femalewrist_hercules_desc
   "Seria necessário um esforço hercúleo para ficar melhor do que você fica usando estas munhequeiras com duas fivelas."
)
(femalewrist_hercules_right "Munhequeira do Herói (Individual)")
(femalewrist_hercules_right_desc
   "Seria necessário um esforço hercúleo para ficar melhor do que você fica usando esta munhequeira com duas fivelas."
)
(femalewrist_jelly "Pulseiras de Gel")
(femalewrist_jelly_desc
   "Elas combinam com qualquer roupa como manteiga de amendoim e.... bem, você sabe."
)
(femalewrist_jelly_right "Pulseira de Gel (Individual)")
(femalewrist_jelly_right_desc
   "Combina com qualquer roupa como manteiga de amendoim e.... bem, você sabe."
)
(femalewrist_laceduparm "Bem Amarradas")
(femalewrist_laceduparm_desc
   "Estas mangas de borracha precisam ser bem apertadas. Peça ajuda aos seus companheiros de banda."
)
(femalewrist_longspikes "Munhequeiras de Cão de Quintal")
(femalewrist_longspikes_desc
   "Estes espinhos compridos não servem mais apenas para coleiras."
)
(femalewrist_longspikes_right "Munhequeira de Cão de Quintal (Individual)")
(femalewrist_longspikes_right_desc
   "Estes espinhos compridos não servem mais apenas para coleiras."
)
(femalewrist_nailgauntlet "Manopla de Brad, o Empalador")
(femalewrist_nailgauntlet_desc
   "Estes espinhos extremamente afiados deixarão você com um visual extremamente afiado. Apenas tente não deixar que façam jus ao nome."
)
(femalewrist_pyramids "Munhequeiras com Espinhos Piramidais")
(femalewrist_pyramids_desc
   "Duas fileiras de rebites piramidais dão a estas munhequeiras uma aparência feroz, mas leve."
)
(femalewrist_starstuds "Estrelas e Rebites")
(femalewrist_starstuds_desc
   "Seja uma estrela e arrase com estas braçadeiras totalmente americanas."
)
(femalewrist_studdedbracer "Braçadeira com Rebites")
(femalewrist_studdedbracer_desc
   "Prepare-se! Estes rebites são coisa séria."
)
(femalewrist_studdedbracer_right "Braçadeira com Rebites (Individual)")
(femalewrist_studdedbracer_right_desc
   "Prepare-se! Estes rebites são coisa séria."
)
(femalewrist_studdedgauntlet "Manoplas com Rebites")
(femalewrist_studdedgauntlet_desc
   "Elas ficam ótimas no palco ou em sua próxima batalha bárbara."
)
(femalewrist_studdedgauntlet_right "Manopla com Rebites (Individual)")
(femalewrist_studdedgauntlet_right_desc
   "Fica ótima no palco ou em sua próxima batalha bárbara."
)
(femalewrist_studdedwatchcombo "Bons Tempos")
(femalewrist_studdedwatchcombo_desc
   "Chegue no horário a todos os seus shows e fique estilosa enquanto faz isso com este pontual conjunto de acessórios."
)
(femalewrist_studdedwatchcombo_right "Bom Tempo (Individual)")
(femalewrist_studdedwatchcombo_right_desc
   "Chegue no horário a todos os seus shows e fique estilosa enquanto faz isso com este pontual conjunto de acessórios."
)
(femalewrist_sweatband "Perspicácia")
(femalewrist_sweatbandcharmscombo "Doce & Azedo")
(femalewrist_sweatbandcharmscombo_desc
   "Como é doce ser usada por você."
)
(femalewrist_sweatbandcombo "Transpiração & Pirâmides")
(femalewrist_sweatbandcombo_desc
   "Uma desordeira como você pode usar quantas coisas quiser nos pulsos!"
)
(femalewrist_sweatbandstuddedcombo "Suor & Espinhos")
(femalewrist_sweatbandstuddedcombo_desc
   "Enxugue o rosto com a faixa, não com os espinhos!"
)
(femalewrist_sweatband_desc
   "Ser musicista é um trabalho suado. Enxugue tudo com estas munhequeiras."
)
(femalewrist_sweatband_right "Perspicácia (Individual)")
(femalewrist_sweatband_right_desc
   "Ser musicista é um trabalho suado. Enxugue tudo com esta munhequeira."
)
(femalewrist_watchcalculator "Relógio-Calculadora Xt4000")
(femalewrist_watchcalculator_desc
   "A mais absoluta novidade da tecnologia dos anos 80 - nada consegue ser mais estiloso do que este relógio de pulso com calculadora, pessoal."
)
(femalewrist_watchleaterstrap "Relógio Hora da Festa")
(femalewrist_watchleaterstrap_desc
   "Que horas são? Isso mesmo: é hora do rock."
)
(femalewrist_wristbandterrycloth "Aquecedores de Pulso")
(femalewrist_wristbandterrycloth_desc
   "Às vezes, a caminho do palco, os músicos ficam com os pés frios. E às vezes ficam com os pulsos frios."
)
(femalewrist_wristbandterrycloth_right "Aquecedor de Pulso (Individual)")
(femalewrist_wristbandterrycloth_right_desc
   "Às vezes, a caminho do palco, os músicos ficam com os pés frios. E às vezes ficam com os pulsos frios."
)
(female_bandana_camo "Super Soldado")
(female_bandana_camo_desc
   "Você está preparada para a batalha e pronta para uma patrulha que durará a noite inteira com este clássico visual do exército e da marinha."
)
(female_bandana_cotton "Bandido")
(female_bandana_cotton_desc
   "Se o público do seu show deixar sua banda sem dinheiro, você sempre poderá usar esta máscara para roubar um banco próximo. (Observação: não recomendamos assaltar bancos.)"
)
(female_bandana_flag_ameterdam "Bandana Holandesa")
(female_bandana_flag_ameterdam_desc
   "Os Países Baixos: um lugar conhecido e amplamente apreciado por sua tolerância social e suas políticas liberais em relação aos moinhos de vento."
)
(female_bandana_flag_berlin "Bandana Alemã")
(female_bandana_flag_berlin_desc
   "Não é tão elegante quanto um Dirndl, mas é melhor do que Lederhosen."
)
(female_bandana_flag_london "Bandana do Reino Unido")
(female_bandana_flag_london_desc
   "Embora este preço possa parecer injustamente alto, você precisa considerar o imposto IVA, o preço de varejo sugerido, os custos de envio... ninguém está tentando explorar você."
)
(female_bandana_flag_mexico "Bandana Mexicana")
(female_bandana_flag_mexico_desc
   "Represente a bandeira com esta bandana e mostre aos seus fãs que seu coração nunca está longe do México."
)
(female_bandana_flag_moscow "Bandana Russa")
(female_bandana_flag_moscow_desc
   "Todo mundo estará \qcorrendo\q para ver sua banda tocar quando você aparecer usando esta orgulhosa bandana. Na zdorovye!"
)
(female_bandana_flag_paris "Bandana Francesa")
(female_bandana_flag_paris_desc
   "Esta bandana fará todos os seus fãs quererem \qafrancesar\q você. Ooh la la!"
)
(female_bandana_flag_reykjavik "Bandana Islandesa")
(female_bandana_flag_reykjavik_desc
   "Dizem que uma grande porcentagem da população da Islândia acredita na existência de elfos. Então, claramente, os elfos de lá não são muito bons em se esconder."
)
(female_bandana_flag_rio "Bandana Brasileira")
(female_bandana_flag_rio_desc
   "Existe um consenso geral de que o Carnaval é a maior festa do mundo, por melhor que tenha sido sua última noitada no camarim."
)
(female_bandana_flag_rome "Bandana Italiana")
(female_bandana_flag_rome_desc
   "Em turnê pela Itália: se você estava em um relacionamento quando chegou aqui, agora não está mais!"
)
(female_bandana_flag_sydney "Bandana Australiana")
(female_bandana_flag_sydney_desc
   "Ser amigo de um australiano não garante que, em algum momento, você poderá abraçar um coala. Portanto, não está claro qual é exatamente a utilidade dos australianos, Teasdale."
)
(female_bandana_flag_tokyo "Bandana Japonesa")
(female_bandana_flag_tokyo_desc
   "Mostre seu amor pelo país que quase certamente criará os robôs que um dia matarão todos nós!"
)
(female_bandana_flag_usa "Bandana dos EUA")
(female_bandana_flag_usa_desc "Somos o número oito! Somos o número oito!")
(female_bandana_glam "Bandana Glamurosa")
(female_bandana_glam_desc "Você é linda, não importa o que digam!")
(female_bandana_medical "Contágio Furioso")
(female_bandana_medical_desc
   "Todo mundo sabe que a música não é a única coisa contagiante em sua banda. Proteja-se com esta elegante máscara cirúrgica."
)
(female_bandana_skull "Caveira Gritante")
(female_bandana_skull_desc
   "Além de deixar você assustadora e descolada, ela demonstrará os benefícios de escovar os dentes três vezes ao dia."
)
(female_eyebrows_01_resource "Franzidas")
(female_eyebrows_01_resource_desc
   "Há tantas coisas com que uma musicista precisa se preocupar: falhas no equipamento... empresários suspeitos... mononucleose... Não é de admirar que suas sobrancelhas estejam carregadas de preocupação!"
)
(female_eyebrows_02_resource "Confiáveis")
(female_eyebrows_02_resource_desc
   "Estas sobrancelhas dizem ao mundo que você é honesta, confiável e que provavelmente nunca chamaria seus companheiros de banda de \qfarejadores de virilha nefastos\q pelas costas."
)
(female_eyebrows_03_resource "Elegantes")
(female_eyebrows_03_resource_desc
   "Uma escolha refinada para uma artista sofisticada e cosmopolita como você, estas sobrancelhas representam o máximo em luxo."
)
(female_eyebrows_04_resource "Intimidadoras")
(female_eyebrows_04_resource_desc
   "Podem chamar você de idiota o quanto quiserem; você é a única durona o bastante para convencer seus companheiros de banda de que ensaiar não é \qcoisa de fracotes.\q"
)
(female_eyebrows_05_resource "Grossas e Preocupadas")
(female_eyebrows_05_resource_desc
   "É perfeitamente natural ficar nervosa antes dos shows. Porém, esconder-se no banheiro com os pés apoiados na borda do vaso é um pouco exagerado."
)
(female_eyebrows_06_resource "Arque-tipo")
(female_eyebrows_06_resource_desc
   "Parece que alguém anda lendo a revista \qSobrancelhas Perfeitamente Modeladas Semanal\q... e não apenas pelos artigos!"
)
(female_eyebrows_07_resource "Recuadas")
(female_eyebrows_07_resource_desc
   "Você se empolgou um pouco demais com a pinça? Teve que desenhá-las novamente com um lápis? Não se esconda em casa, aproveite o que você tem. Isso acontece com as melhores."
)
(female_eyebrows_08_resource "Liga dos Arbustos")
(female_eyebrows_08_resource_desc
   "Estas sobrancelhas severas definitivamente NÃO são para iniciantes -- são necessários anos para dominar somente a arte da \qcarranca sensual\q."
)
(female_eyebrows_09_resource "Alta Classe")
(female_eyebrows_09_resource_desc
   "Com este visual dramaticamente arqueado, fica fácil olhar para o proletariado com desprezo. Hmph!"
)
(female_eyebrows_10_resource "Surpresa, Surpresa")
(female_eyebrows_10_resource_desc
   "Quando você ostenta sobrancelhas permanentemente levantadas, fica muito mais fácil fingir surpresa com a notícia de que \qalguém\q saqueou novamente a geladeira do local de ensaio."
)
(female_eyebrows_11_resource "Arqui-Inimiga")
(female_eyebrows_11_resource_desc
   "Nada como uma sobrancelha artisticamente arqueada para dizer ao mundo que, apesar de seu charme refinado, você está secretamente planejando a destruição global."
)
(female_eyebrows_12_resource "Sobrancelhas Circunflexas")
(female_eyebrows_12_resource_desc "Mmm... circunflexos.")
(female_eyebrows_13_resource "Cheias de Angústia")
(female_eyebrows_13_resource_desc
   "Se sua coleção de LPs obscuros de death metal norueguês não estiver transmitindo a mensagem, estas sobrancelhas dirão ao mundo que você carrega uma angústia muito séria."
)
(female_eyebrows_14_resource "Urso Peludo")
(female_eyebrows_14_resource_desc
   "Esperamos que ninguém confunda suas adoráveis sobrancelhas felpudas com a larva de uma Pyrrharctia isabella!"
)
(female_eyebrows_15_resource "Nada Impressionadas")
(female_eyebrows_15_resource_desc
   "O formato de sobrancelha ideal para comunicar silenciosamente aos seus companheiros de banda que as \qmelhorias\q feitas por eles nas letras que você escreveu não estão agradando."
)
(female_eyebrows_16_resource "Martelos de Garra")
(female_eyebrows_16_resource_desc
   "Com este visual agressivo, você pode realmente \qmartelar\q a ideia de que, apesar de sua paixão por filhotes de animais, não se deve brincar com você."
)
(female_eyebrows_17_resource "Ralas")
(female_eyebrows_17_resource_desc
   "A menos que você seja uma verdadeira especialista com o lápis de sobrancelha, este visual é mais fácil de conseguir naturalmente."
)
(female_feet_naked "Descalça")
(female_feet_naked_desc
   "Embora andar descalça faça você parecer \qhumilde\q e \qligada à natureza\q, isso também traz o risco de fazer você parecer \qgravemente ferida\q ao pisar em um pedaço de \qgarrafa quebrada.\q"
)
(female_hair_50sbandana_resource "Rabo de Cavalo Retrô")
(female_hair_50sbandana_resource_desc
   "O detalhe perfeito da bandana decora seu brilhante rabo de cavalo retrô."
)
(female_hair_60spony_resource "Bufante")
(female_hair_60spony_resource_desc
   "Você sempre gostou de provocar. Mostre seu lado brincalhão com este rabo de cavalo bem armado."
)
(female_hair_70sbisset_resource "A Jacqueline")
(female_hair_70sbisset_resource_desc
   "Pareça um anjo com este estilo dos anos 70."
)
(female_hair_beehive_resource "Colmeia")
(female_hair_beehive_resource_desc
   "É necessário muito tempo e spray de cabelo para conseguir este visual retrô. Portanto, se alguém tentar tocar em seu penteado, não hesite em ferroar essa pessoa com toda a força."
)
(female_hair_bettybangs_resource "A Betty")
(female_hair_bettybangs_resource_desc "Prenda para cima ou use solto.")
(female_hair_blownback_resource "Toda Produzida")
(female_hair_blownback_resource_desc
   "Este estilo romântico fará você se lembrar de sua boneca favorita da infância... mas sem a parte careca e o lamentável bigode feito com tinta permanente."
)
(female_hair_bunhead_resource "Princesa Instrumentista")
(female_hair_bunhead_resource_desc
   "Um visual adorável para sua hora mais desesperadora... para consegui-lo, os grampos são sua única esperança."
)
(female_hair_buzzcut_resource "Corte Raspado")
(female_hair_buzzcut_resource_desc
   "Claro, é um visual mais comum entre militares do que entre estrelas do rock... mas quem não gosta de ficar ligada de vez em quando?"
)
(female_hair_chunli_gothveilhat "Chapéu Lolita Escarlate")
(female_hair_chunli_gothveilhat_desc
   "Nada poderia ser mais fofo do que esta combinação de chapéu com véu e coques odango."
)
(female_hair_chunli_resource "Coques de Anime")
(female_hair_chunli_resource_desc "Kawaii não?")
(female_hair_cutepigtails_resource "Maria-Chiquinhas")
(female_hair_cutepigtails_resource_desc
   "Estas porquinhas dizem \qQuente! Quente! Quente!\q durante todo o caminho até as capas das revistas."
)
(female_hair_dreadpony_resource
   "...E Você Nos Conhecerá pelo Rabo de Dreads"
)
(female_hair_dreadpony_resource_desc
   "Este visual definitivamente fará você se destacar da multidão. Mas, a menos que goste de cheirar como uma bolsa de academia cheia de bananas velhas, seja extremamente cuidadosa ao lavar seus dreads."
)
(female_hair_emobuzz_resource "Emofilia")
(female_hair_emobuzz_resource_desc
   "Este visual contemporâneo combina melhor com muita maquiagem vermelha nos olhos e uma tatuagem de um robô cronicamente deprimido, mas adorável."
)
(female_hair_farah_resource "Asas de Anjo")
(female_hair_farah_resource_desc
   "Você nunca esteve tão 'farrah' quanto com este penteado luxuoso."
)
(female_hair_feathered_short_resource "Emplumado")
(female_hair_feathered_short_resource_desc
   "Levante-se e deixe que vejam você sacudir as penas de seu cabelo!"
)
(female_hair_femover_resource "Femover")
(female_hair_femover_resource_desc
   "Precisa colocar seus sentimentos para fora? Corte o cabelo."
)
(female_hair_flapper_resource "A Melindrosa")
(female_hair_flapper_resource_desc
   "Ora, veja só, esta garota não é simplesmente sensacional? Tudo em ordem!"
)
(female_hair_gothdreads_resource "Cascatas de Dreads")
(female_hair_gothdreads_resource_desc
   "O visual dos dreads sem o compromisso."
)
(female_hair_hilldreads_resource "Dreads Livres")
(female_hair_hilldreads_resource_desc
   "Nada se movimenta melhor no palco do que dreads naturais! Além disso, exigem pouca manutenção. Só vantagens."
)
(female_hair_hippybangs_resource "Franja Hippie")
(female_hair_hippybangs_resource_desc "Paz, amor e um belo cabelo.")
(female_hair_hornhair_resource "Chifres para Cima")
(female_hair_hornhair_resource_desc
   "Semeie um pouco de travessura e caos com este penteado divertido e cheio de chifres."
)
(female_hair_japan_resource "Hairajuku")
(female_hair_japan_resource_desc
   "Mostre seu amor pelo estilo de rua japonês com este visual urbano e ousado."
)
(female_hair_ladydreads_resource "Dreads")
(female_hair_ladydreads_resource_desc
   "Cabelo sublime? Para você, é um \qloc.\q"
)
(female_hair_ladyfrosmall_resource "T.W.A.")
(female_hair_ladyfrosmall_resource_desc
   "Quando seu cabelo ficar danificado demais pelo estilo de vida severo das turnês, seja ousada e corte tudo, deixando um afro bem pequenininho!"
)
(female_hair_ladyfro_resource "A Natural")
(female_hair_ladyfro_resource_desc "Este penteado é simplesmente explosivo.")
(female_hair_ladylayered_resource "Em Camadas")
(female_hair_ladylayered_resource_desc
   "Seu cabelo tem mais camadas do que uma parede de som."
)
(female_hair_ladypunk_resource "Toda Punk")
(female_hair_ladypunk_resource_desc
   "De manhã, diante do espelho, ao grito da navalha, seu cabelo clama: \qMais! Mais! Mais!\q"
)
(female_hair_lolita_resource "Lolita")
(female_hair_lolita_resource_desc
   "Nem o próprio Nabokov resistiria a este estilo longo e exuberante."
)
(female_hair_longlayered_resource "Longo e em Camadas")
(female_hair_longlayered_resource_desc
   "Todos vão querer amar, tocar e apertar seu cabelo."
)
(female_hair_longstraight_resource "Longo e Liso")
(female_hair_longstraight_resource_desc "Escovado e liiiiiiso.")
(female_hair_longwavy_resource "Longo e Ondulado")
(female_hair_longwavy_resource_desc
   "Este estilo pode exigir muito trabalho e óleo quente, mas seu cabelo deslumbrante vale a pena."
)
(female_hair_long_resource "Cabelo Longo")
(female_hair_long_resource_desc
   "É um longo caminho até o topo, mas não para o seu cabelo."
)
(female_hair_loosepony_resource "Hipster Casual")
(female_hair_loosepony_resource_desc
   "Perfeito para quem anda de bicicleta retrô, faz crochê e mora em Williamsburg."
)
(female_hair_messyshort_resource "Lindo Desastre")
(female_hair_messyshort_resource_desc
   "Este estilo cuidadosamente bagunçado atrai a atenção dos flashes dos paparazzi... desde que você se lembre de manter as pernas fechadas ao sair da limusine."
)
(female_hair_mulletbob_resource "Dama Valente")
(female_hair_mulletbob_resource_desc
   "Com efeito, este estilo retrô dá à milady uma desculpa para usar uma toalha como capa improvisada no palco."
)
(female_hair_nightcat_resource "Gata da Noite")
(female_hair_nightcat_resource_desc
   "Não pare de acreditar no quanto seu cabelo está incrível."
)
(female_hair_oddbob_resource "Bob Coisa e Tal")
(female_hair_oddbob_resource_desc
   "Este bob único e assimétrico apareceu primeiro nas passarelas da pouco conhecida (mas incrivelmente elegante) cidade de Thingama, na Suécia."
)
(female_hair_pigtails_resource "Marias-Chiquinhas Longas")
(female_hair_pigtails_resource_desc
   "Estas lindas marias-chiquinhas farão você guinchar de alegria."
)
(female_hair_pixie_resource "O Pixie")
(female_hair_pixie_resource_desc
   "Este penteado de corte irregular, inspirado em fadas, fica fofo em qualquer cor."
)
(female_hair_pulledback_resource "Puxado para Trás")
(female_hair_pulledback_resource_desc
   "Use este visual simples e elegante e precisará contratar seguranças extras para manter \qafastados\q os fãs que arranham as janelas da sua limusine."
)
(female_hair_reverseflip_resource "Virado ao Contrário")
(female_hair_reverseflip_resource_desc
   "O penteado perfeito para uma dona de casa que se tornou uma musicista de rock selvagem e devassa!"
)
(female_hair_shaggy_resource "Cabelo Desgrenhado")
(female_hair_shaggy_resource_desc
   "Tipo! Totalmente uau, cara! Seu cabelo está desgrenhástico."
)
(female_hair_shortbangs_resource "Pajem")
(female_hair_shortbangs_resource_desc
   "Toda a fofura de uma franja sem nenhum cabelo nos olhos."
)
(female_hair_shortspikes_resource "Espinhos Curtos")
(female_hair_shortspikes_resource_desc "Rebites para sua cabeça.")
(female_hair_short_resource "Cortado")
(female_hair_short_resource_desc
   "Às vezes, depois de um dia lidando com colegas de banda, transporte público e pedidos errados de sanduíche, tudo o que você quer é cortar tudo."
)
(female_hair_sideflip_resource "Bob Assimétrico")
(female_hair_sideflip_resource_desc
   "A inclinação suave deste estilo fica incrível sob as luzes do palco."
)
(female_hair_sidepony_resource "Rabo de Cavalo Lateral")
(female_hair_sidepony_resource_desc
   "Pareça uma verdadeira debutante ao usar este adorável rabo de cavalo."
)
(female_hair_spikyteased_resource "The Joan")
(female_hair_spikyteased_resource_desc
   "Quer tocar? Quer tocar no seu cabelo?"
)
(female_hair_test "Ondas de Mutilação")
(female_hair_test_desc
   "Este estilo simples e ondulado impedirá sua cabeleireira de fazer sons de desapontamento enquanto escova agressivamente seu cabelo."
)
(female_hair_trihawk_resource "Trihawk")
(female_hair_trihawk_resource_desc "Uma vez, duas vezes, três vezes mais estilo.")
(female_hair_visor_resource "Franja Contrastante")
(female_hair_visor_resource_desc
   "Quer festejar com a turma descolada? Adote este estilo."
)
(female_hair_youngozzy_resource "Cortinado")
(female_hair_youngozzy_resource_desc "As cortinas se fecham para você!")
(female_hands_bandage_wrap "Ataduras de Múmia")
(female_hands_bandage_wrap_desc
   "Estas ataduras não apenas parecem assustadoras, como também ajudam a impedir que suas baquetas escorreguem das mãos."
)
(female_hands_drivinggloves_leather "Luvas de Motorista")
(female_hands_drivinggloves_leather_desc
   "Seja jogando golfe ou viajando na van, estas luvas manterão suas mãos no comando."
)
(female_hands_fingergloves_leather "Luvas com Dedos")
(female_hands_fingergloves_leather_desc
   "Se precisar fazer um gesto rude para um fotógrafo intrometido, você poderá explicar depois que estava apenas exibindo seu novo visual descolado."
)
(female_hands_fingerless_leather "Aquecedores de Palma")
(female_hands_fingerless_leather_desc
   "Só porque está frio não significa que você precise esconder uma manicure incrível pra caramba."
)
(female_hands_fishnetgloves_fishnet "Luvas Materiais")
(female_hands_fishnetgloves_fishnet_desc
   "Porque você vive em um mundo material, e a rede arrastão é um material perfeitamente funcional."
)
(female_hands_glove_cotton "Luvas de Algodão")
(female_hands_glove_cotton_desc
   "Escolha estas luvas em uma cor clara e você poderá constranger seus colegas de banda a tirar o pó dos equipamentos de vez em quando."
)
(female_hands_hobogloves_cotton "Mãos Enluvadas")
(female_hands_hobogloves_cotton_desc
   "As pessoas vão olhar, mas você não vai se importar com este estilo descolado e sem dedos."
)
(female_hands_kidgloves_leather "Luvas de Pelica")
(female_hands_kidgloves_leather_desc
   "Usar estas luvas não fará de você automaticamente uma pessoa mais delicada; chamar seus colegas de banda de \qbaldes de ranho detestáveis\q continuará sendo mal recebido, independentemente da sua roupa."
)
(female_hands_long_leather "Um Montão de Luvas")
(female_hands_long_leather_desc
   "Enquanto você fica na sua, os fãs vão babar por este visual inteiramente de couro."
)
(female_hands_naked "[nenhum]")
(female_hands_naked_desc " ")
(female_hands_skeletongloves_desc
   "Toque até gastar os dedos com estas luvas sinistras."
)
(female_hands_skeletongloves_skeleton "Luvas Esqueléticas")
(female_hands_skeletongloves_skeleton_desc
   "Toque até gastar os dedos com estas luvas sinistras."
)
(female_hat_bowler_messyshort_resource "Santo Chapéu-Coco")
(female_hat_bowler_messyshort_resource_desc
   "Este chapéu retrô fará todos elogiarem seu senso de moda e testemunharem a glória que é você."
)
(female_hat_bowler_short_resource "Santo Chapéu-Coco c/ Cabelo Curto")
(female_hat_bowler_short_resource_desc
   "Este chapéu retrô fará todos elogiarem seu senso de moda e testemunharem a glória que é você."
)
(female_hat_brete_longwavy_resource "Perdão pelo Francês c/ Cabelo Longo")
(female_hat_brete_longwavy_resource_desc
   "Esta boina francesa clássica fará todos perguntarem: \qposso pegar um grampeador emprestado?\q"
)
(female_hat_brete_shaggybob_resource "Perdão pelo Francês c/ Cabelo Curto")
(female_hat_brete_shaggybob_resource_desc
   "Esta boina francesa clássica fará todos gritarem: \qooh-la-la, um croque monsieur!\q"
)
(female_hat_brete_solid "Perdão pelo Francês")
(female_hat_brete_solid_desc
   "Esta boina francesa clássica fará todos perguntarem: \qonde fica a biblioteca?\q"
)
(female_hat_cophat_longhair_resource "Boné de Motoqueira")
(female_hat_cophat_longhair_resource_desc
