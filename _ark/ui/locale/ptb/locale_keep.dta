(sort_setting "Sorteado Por")
(soul "Soul")
(southernrock "Southern Rock")
(spacey "Espacial")
(space_jam "Improviso Espacial")
(sparkle "Brilho")
(sparklefade "Degradê Brilhante")
(spats_twotone "Polainas Jack")
(spats_twotone_desc "Entre estes dois sapatos, você deixará o palco completamente limpo.")
(speed "Velocidade")
(speedup "Aceleração")
(speedup_a "Aceleração A")
(speedup_b "Aceleração B")
(spikedarmorboots_leather "Cavaleiros da República do Metal")
(spikedarmorboots_leather_desc
   "Estas botas dizem ao mundo que você cavalgou com reis em corcéis poderosos e agora reina sobre seu próprio reino musical."
)
(spikedarmorleggings_spandex "Perfuradores de Joelhos Oni")
(spikedarmorleggings_spandex_desc
   "Os demônios tremerão de medo quando virem sua feroz armadura de joelho."
)
(spikedarmor_leather "Armadura do Senhor dos Dragões")
(spikedarmor_leather_desc
   "Você é um Senhor dos Dragões. Raios anunciam sua chegada. Entre trovejando na arena com esta armadura digna."
)
(spikedboots_leather "Botas Spiketress")
(spikedboots_leather_desc
   "Estas botas foram feitas para combinar com as outras peças da Spiketress, mas você pode usá-las com qualquer coisa."
)
(spikedcollar_spiked "Algemado e Encoleirado")
(spikedcollar_spiked_desc
   "Inevitavelmente você acabará algemado quando a polícia o prender por suas loucuras no palco — então é melhor estar vestido a caráter!"
)
(spikedjacket_leather "Crepúsculo Espetado")
(spikedjacket_leather_desc
   "Dê as boas-vindas à noite usando esta aberração cheia de espinhos."
)
(spikedleatherjacket_spiked "Casacotônico")
(spikedleatherjacket_spiked_desc
   "Caracterizado por anormalidades marcantes da moda, incluindo estrelato e atividade excessiva de fotógrafos."
)
(spikedleather_clean "Espinhos do Superestado Sônico")
(spikedleather_clean_desc
   "Sem promessas, mas é possível que esta bela jaqueta cheia de espinhos, rebites e estrelas torne você invencível!"
)
(spikedleggings_leather "Leggings Spiketress")
(spikedleggings_leather_desc
   "Estas leggings com espinhos darão uma vantagem a você sobre a concorrência."
)
(spikedplatformboots_solid "Anquilossauros de Plataforma")
(spikedplatformboots_solid_desc
   "Não se preocupe em ser extinto, pois com estas botas você viverá mais do que os mamíferos!"
)
(spikedshoes_leather "Espinhos Poderosos")
(spikedshoes_leather_desc "Sério, não tropece usando estes sapatos.")
(spikedshoulder_metal "Armadura Carregue o Fardo")
(spikedshoulder_metal_desc
   "Esta armadura de metal é realmente pesada — ainda bem que você já está acostumado a carregar o peso de ser mais incrível do que todos no planeta."
)
(spikedtrackjacket_thinleather "Charles, o Sangrento")
(spikedtrackjacket_thinleather_desc
   "Com espinhos absurdamente grandes, esta fina jaqueta esportiva de couro é uma verdadeira aula de intimidação."
)
(spikedvest_leather "Colete de Troll")
(spikedvest_leather_desc
   "Destaque-se com correntes, espinhos e couro. Você ficará mais do que intimidador com este colete de couro."
)
(spikepads_distressed "Espaldeiras de Metal")
(spikepads_distressed_desc
   "Você usa couro, usa espinhos e domina a noite com esta armadura assustadora. Valhalla!"
)
(spikydocs_solid "Botas Caos Motociclístico")
(spikydocs_solid_desc
   "Acelere os motores! Estas botas são seu bilhete para a estrada."
)
(spinyboots_iron "Botas Arrepio na Espinha")
(spinyboots_iron_desc
   "Uma única olhada nestes calçados espinhosos fará o segurança pensar duas vezes antes de limitar os convidados da sua lista."
)
(spiralsolid "Espiral Sólida")
(spiraltrans "Espiral Transparente")
(splash_loading "Carregando...")
(sportbikeboots_leather "Botas Hanzo")
(sportbikeboots_leather_desc
   "Estas botas são tão ferozes que às vezes são chamadas de \qHanzos do Diabo.\q"
)
(sportbikeleggings_leather "Couros Hanzo")
(sportbikeleggings_leather_desc
   "Aprimore suas habilidades marciais com estas leggings \qtestadas por samurais e aprovadas por ninjas\q."
)
(sportysneaks_pleather "Tênis de Basquete")
(sportysneaks_pleather_desc
   "Crie a ilusão de estar em forma com estes tênis esportivos, ideais para carregar equipamentos ou disputar uma partida improvisada às 3 da manhã."
)
(spurboots_leather "Vênus de Esporas")
(spurboots_leather_desc
   "A plateia beijará suas botas de couro brilhante, muito brilhante."
)
(standins "Sustitutos")
(standins_help
   "Os Membros Substitutos tocam no seu grupo quando algum jogador faltar na banda."
)
(standins_select_character "Selecionar Personagem")
(starcaster "Fender<sup>TM</sup> Starcaster<sup>TM</sup>")
(starcaster_desc
   "Procurando uma guitarra tão única quanto sua tendência de escrever baladas sobre salgadinhos? A Starcaster<sup>TM</sup> possui um headstock diferente de qualquer outra guitarra Fender<sup>TM</sup> já produzida."
)
