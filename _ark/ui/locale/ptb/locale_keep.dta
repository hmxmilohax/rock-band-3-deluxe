(thermalshirt_threadbare "Térmica GoTag")
(thermalshirt_threadbare_desc "Pegou! Esta térmica está totalmente \qna moda!\q")
(thermalundertee_amsterdamcuckoo "Cuco de Amsterdã")
(thermalundertee_amsterdamcuckoo_desc
   "CUCO! CUCO! CUCO! CUCO! CUCO! CUCO!"
)
(thermalundertee_berlinwall "Tijolo no Muro de Berlim")
(thermalundertee_berlinwall_desc "Ei! Professores! Deixem esta camisa em paz!")
(thermalundertee_bostonlobstah "Lagosta de Boston")
(thermalundertee_bostonlobstah_desc
   "O babador pode parecer bobo, mas protegerá sua camiseta novinha de toda aquela manteiga."
)
(thermalundertee_dublinup "Dublin em Dobro!")
(thermalundertee_dublinup_desc
   "Com certeza, por São Patrício, esta é mesmo uma bela camisa."
)
(thermalundertee_fenderbirds "Térmica Fender<sup>TM</sup>")
(thermalundertee_fenderbirds_desc
   "A Fender<sup>TM</sup> sempre manteve seu som descolado, e agora também manterá você aquecido!"
)
(thermalundertee_laretro "Camiseta Hollywood em Vinil")
(thermalundertee_laretro_desc
   "O que seria de uma visita a Hollywoodland sem uma camiseta comemorativa?"
)
(thermalundertee_moped "Devoto de Ciclomotor")
(thermalundertee_moped_desc
   "Eles são bonitos, rápidos e baratos — os ciclomotores, não seus colegas de banda."
)
(thermalundertee_nyliberty "No Punk Confiamos")
(thermalundertee_nyliberty_desc
   "Deem-nos seus pobres, suas camisetas e suas massas de mosh sedentas por bater cabeça..."
)
(thermalundertee_panther "Pantera Cibernética")
(thermalundertee_panther_desc
   "O que é mais ameaçador do que uma pantera? Sim. Exatamente. Uma pantera cibernética."
)
(thermalundertee_reykjavikhekla "Que Hekla é Essa?")
(thermalundertee_reykjavikhekla_desc
   "Cada camiseta foi resgatada da boca do Hekla, o vulcão ativo mais agitado da Islândia!"
)
(thermalundertee_reykjavikviking "Reykjaviking")
(thermalundertee_reykjavikviking_desc
   "Usar esta camisa faz você sentir que realizou sua própria viagem particular a Valhalla."
)
(thermalundertee_romestatue "A Vênus de Chitarra")
(thermalundertee_romestatue_desc
   "Até as deusas do amor precisam estourar os alto-falantes de um amplificador de vez em quando."
)
(thermalundertee_sanfranciscobigone "O Grande Abalo!")
(thermalundertee_sanfranciscobigone_desc
   "Seu último show atingiu 8,5 na escala Richter!"
)
(thermalundertee_seattlecoffee "Homem do Café de Seattle")
(thermalundertee_seattlecoffee_desc "Café quente? Ah, simmm!")
(thermalundertee_seattleumbrellas "Chuva Sobre Você")
(thermalundertee_seattleumbrellas_desc
   "Sem estes guarda-chuvas, a chuva de Seattle encharcará seu cavanhaque e sua camisa de flanela."
)
(thermalundertee_thermal "Termostato")
(thermalundertee_thermal_desc
   "Sua mãe sempre disse para você se vestir em camadas. Nada destaca melhor sua camiseta favorita do que esta térmica."
)
(thicksweater_damaged "Suéter Desfeito")
(thicksweater_damaged_desc
   "Caso queira destruir seu suéter, faça buracos nele e prenda tudo novamente com alfinetes."
)
(thighboots_leather "Botas Acima das Coxas")
(thighboots_leather_desc
   "Estas botas ousadas são tão poderosas que talvez você precise adotar um novo apelido, como \qSenhora Perigosa\q ou \qA Caçadora de Aberrações.\q"
)
(thighhighheel_pvc "Saltos da Senhora")
(thighhighheel_pvc_desc
   "Domine seus fãs com estas formidáveis botas de salto alto."
)
(thintank_amsterdamwindmill "O Moinho")
(thintank_amsterdamwindmill_desc
   "Esteja você moendo produtos agrícolas ou fazendo sua melhor imitação de roqueiro de arena, o Moinho é realmente icônico."
)
(thintank_ludwig "Regata Ludwig®")
(thintank_ludwig_desc
   "Adora seu kit Ludwig? Mostre isso ao mundo usando esta regata!"
)
(thintank_parisbikes "Bicyclettes de Paris")
(thintank_parisbikes_desc "Uma lembrança do seu próprio Tour de France.")
(thintank_printed "Passeio Mágico de Regata")
(thintank_printed_desc
   "Você nunca sabe o que pode encontrar quando usa esta pequena regata."
)
(thintank_riokidney "Regata Rio")
(thintank_riokidney_desc "Quando seu amor sorrir para você, vá para o Rio.")
(thintank_solid "Regata Chamado de Camden")
(thintank_solid_desc
   "Esta linda regata levará você direto ao topo do dial."
)
(thintank_vater "Regata Baquetas Vater")
(thintank_vater_desc
   "Marque o ritmo com suas baquetas Vater usando esta regata encantadora."
)
(thrash "Thrash")
(tiedshirt_plaid "Reputação Xadrez")
(tiedshirt_plaid_desc
   "Você pode fazer o que quiser usando este top ousado."
)
(tiedshirt_plain "Noites em Cetim Justo")
(tiedshirt_plain_desc
   "Sua mãe não ensinou a diferença entre \qatenção boa\q e \qatenção ruim\q?"
)
(tiedtallboots_suede "Princesa Guerreira")
(tiedtallboots_suede_desc "Calce estas botas e mostre sua espada a eles!")
(tiedtube_cotton "Balé Bandeau")
(tiedtube_cotton_desc
   "Este top bandeau justo fará a plateia dar piruetas pelo seu battement fondu. Humm... fondue."
)
(tie_token "Empate!")
(tightcottonpants_pattern "Doces & Tartans")
(tightcottonpants_pattern_desc
   "É uma maravilha usar estas calças de algodão com caimento impecável."
)
(tightdistressedpants_jeans "Especiais de Seattle")
(tightdistressedpants_jeans_desc
   "Assim como os anos 90, o grunge e a flanela, estes jeans nos levam de volta a uma época em que nunca lavar o cabelo era descolado."
)
(tighterpants_plaidpunx "Calças Imprudentes")
(tighterpants_plaidpunx_desc
   "Abandone imprudentemente suas ideias preconcebidas sobre estilo. Com estas calças, você se destacará até na roda punk mais lotada."
)
(tightjeans_denim "Abraça-Coxas")
(tightjeans_denim_desc
   "Você não passa todo esse tempo na academia à toa — balance o que sua mãe e seu personal trainer deram a você com estes jeans justos."
)
(tightjeans_faded "Hipsters Trágicos")
(tightjeans_faded_desc
   "Procurando um lugar para acontecer? Estas calças de cintura baixa são esse lugar!"
)
(tightpants_checkered "Damas ou Xadrez")
(tightpants_checkered_desc
   "Seja a rainha do tabuleiro sem precisar penhorar suas coisas! Estas calças quadriculadas darão um xeque-mate depois do show!"
)
(tightpants_sequins "Lantejoulencial")
(tightpants_sequins_desc
   "Lantejoulas brilhantes transformam estas calças em uma bola de discoteca de talento metálico!"
)
(tightpants_skeletonprint "Calças Esqueleto")
(tightpants_skeletonprint_desc
   "Estas calças que afinam a silhueta possuem detalhes assustadores que brilham no escuro. Use-as com a Camisa Esqueleto para obter o efeito máximo."
)
(timberlandboots_muddy "Nubucks")
(timberlandboots_muddy_desc
   "Nada melhor para carregar equipamentos pela lama e pelo granizo. Aparentemente, também são muito boas para caminhadas."
)
(tirearmor_rubber "Armadura de Pneu")
(tirearmor_rubber_desc
   "Combine agressividade bruta com compromisso ambiental usando esta armadura feroz feita de pneus de trailers."
)
