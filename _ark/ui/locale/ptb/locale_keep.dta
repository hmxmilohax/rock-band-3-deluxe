(award_generic "Novas Opções de Personalização Disponíveis!")
(award_genericdesc
   "Você pode vestir e utilizar os itens ganhos acessando \qPersonalizar Personagem\q no menu Personalizar do Menu Principal."
)
(award_halloffame "Você alcançou o Hall da Fama!")
(award_halloffame_desc
   "Você conseguiu fãs suficientes para ser convidado ao Hall da Fama! Vá ao modo Carreira e jogue o repertório do Hall da Fama ou jogue o último Desafio de Turnê para ser incluído!"
)
(award_hoarder "Acumulador de Overdrive")
(award_jet "Você ganhou um Jatinho!")
(award_jet_desc
   "Parabéns, você agora se tornou importante com seu novo e sofisticado Jatinho! Você sequer está lendo isso, ou contratou um assistente para fazer isso por você? Novos Desafios de Turnê já estão disponíveis!"
)
(award_keysonguitar "Teclado na Guitarra!")
(award_keysonguitar_desc
   "Agora você pode tocar partes de Teclado usando sua Guitarra! Vamos ver se você realmente aguenta tocar as partes de Teclado na Guitarra..."
)
(award_legend_solo "Solista Lendário")
(award_most_gutsy "O mais Corajoso")
(award_professional_streaker "Deus do Combo de Notas")
(award_real_bassist "Baixista Autêntico")
(award_renameband "Você Decidiu um Nome para sua Banda!")
(award_renameband_desc
   "Parabéns, você conseguiu escolher um nome para sua banda! Como escolher o nome da banda é oficialmente a parte mais difícil de todo progresso, você deve conseguir tudo facilmente daqui pra frente."
)
(award_savior "Salvador")
(award_secret_title "Secreto")
(award_serious_skills "Sérias Habilidades")
(award_serious_style_points "O Mais Energético")
(award_spirited_survivor "Sobrevivente Espiritual")
(award_tattoos "Loja de Tatuagem!")
(award_tattoos_desc
   "Agora você tem credibilidade suficiente para fazer uma tatuagem! Dê uma olhada na seção de Tatuagens no menu \qPersonalizar Personagem\q."
)
(award_test1 "Prêmio Provisório 1")
(award_test1_desc "Você ganhou alguns instrumentos, eu acho?")
(award_test2 "Prêmio Provisório #2")
(award_test2_desc "Você ganhou um pônei! UM PÔNEI, EU DISSE!")
(award_test3 "Prêmio Provisório 3")
(award_test3_desc "Você ganhou um encontro com Dan Teasdale!")
(award_top_performer "Melhor Performer")
(award_unconscious "Inconsciente")
(award_van "Você Ganhou uma Van!")
(award_van_desc
   "Agora que você tem esta van irada, pode encarar Desafios de Turnê mais longos! E não exagere no aromatizante... isso só vai piorar o cheiro."
)
(award_videovenues "Locais para Videoclipes Desbloqueados!")
(award_videovenues_desc
   "Muito bem, agora você tem fãs suficientes para começar a fazer videoclipes! Tente garantir que sempre filmem o seu melhor ângulo..."
)
(award_win "Você Completou o Rock Band 3!")
(award_win_desc
   "Uau. Isso é incrível! Você faz parte de um grupo muito seleto de pessoas que triunfaram em tudo o que os jogos musicais modernos têm a oferecer. Parabéns por vencer o Rock Band 3, de todos nós da Harmonix!"
)
(awesome_solo "Solo Incrível!")
(axebass_resource "O Baixo Carrasco")
(axebass_resource_desc
   "Se a plateia não gritar alto o bastante, cabeças vão rolar..."
)
(axe_resource "O Carrasco")
(axe_resource_desc
   "Se a plateia não gritar alto o bastante, cabeças vão rolar..."
)
(aztecarmor_hide "Peitoral de Toci")
(aztecarmor_hide_desc
   "Adorne-se como uma deusa asteca com esta elaborada peça de cima."
)
(aztecboots_hide "Pés de Toci")
(aztecboots_hide_desc
   "Para saber de verdade como é governar o mundo, caminhe um pouco com estas botas."
)
(aztecleggings_hide "Pernas de Toci")
(aztecleggings_hide_desc
   "Quando a sede de batalha tomar conta de você, vai querer estar usando estas calças feitas para uma deusa guerreira asteca."
)
(back "VOLTAR")
