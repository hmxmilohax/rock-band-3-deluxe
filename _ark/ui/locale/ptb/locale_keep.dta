)
(female_makeup_eyes_19 "Poeira Estelar")
(female_makeup_eyes_19_desc "Este visual é totalmente glamarravilhoso!")
(female_makeup_eyes_1_desc
   "Cores esfumaçadas que lembram a manhã seguinte a uma noite muito, muito longa."
)
(female_makeup_eyes_2 "Tordo-dos-Bosques")
(female_makeup_eyes_20 "Film Noir")
