(qst_tier1_accuracyfocus "Nos Holofotes")
(qst_tier1_accuracyfocus_desc
   "Para conquistar <alt>c</alt> de bônus, toque com precisão sempre que estiver nos holofotes!"
)
(qst_tier1_accuracyfocus_long_desc
   "Para conquistar <alt>c</alt> de bônus, alcance a precisão exigida quando estiver nos holofotes!\n\nMaximize seus <alt>c</alt> de bônus fazendo isso várias vezes seguidas!"
)
(qst_tier1_accuratesectioncount "Precisão")
(qst_tier1_accuratesectioncount_desc
   "Para conquistar <alt>c</alt> de bônus, toque cada seção da música com precisão!"
)
(qst_tier1_accuratesectioncount_long_desc
   "Para conquistar <alt>c</alt> de bônus, alcance a precisão exigida em cada seção da música!\n\nMaximize seu bônus fazendo isso várias vezes seguidas!"
)
(qst_tier1_bandaccuracy "Todos Por Um")
(qst_tier1_bandaccuracy_desc
   "Para ganhar <alt>c</alt> bônus, toque cada seção da música com precisão! Todos os jogadores devem tocar a seção com precisão para contar."
)
(qst_tier1_bandaccuracy_long_desc
   "Para ganhar <alt>c</alt> bônus, toque cada seção da música com precisão! Todos os jogadores devem tocar a seção com precisão para contar.\n\nMaximize seus <alt>c</alt> bônus fazendo isso múltiplas vezes em sequência!"
)
(qst_tier1_deploycount "Sobrecarga de Overdrive")
(qst_tier1_deploycount_desc
   "Para ganhar <alt>c</alt> bônus, ative o Overdrive o maior número de vezes possível!"
)
(qst_tier1_deploycount_long_desc
   "Para ganhar <alt>c</alt>bônus, ative o Overdrive o maior número de vezes possível! Você não precisa encher completamente o seu medidor -- ative sempre que puder!"
)
(qst_tier1_fulldeploycount "Overdrive Cheio")
(qst_tier1_fulldeploycount_desc
   "Para conquistar <alt>c</alt>, ative o Overdrive com o medidor cheio quantas vezes conseguir!"
)
(qst_tier1_fulldeploycount_long_desc
   "Para conquistar <alt>c</alt> de bônus, ative o Overdrive quando seu medidor estiver cheio -- quanto mais vezes, melhor! Só contam as ativações com o Overdrive cheio."
)
(qst_tier1_maxmultdeploycount "Overdrive Otimizado")
(qst_tier1_maxmultdeploycount_desc
   "Para conquistar <alt>c</alt>, ative o Overdrive com o multiplicador no máximo quantas vezes conseguir!"
)
(qst_tier1_maxmultdeploycount_long_desc
   "Para conquistar <alt>c</alt> de bônus, ative o Overdrive quando seu multiplicador estiver no máximo -- quanto mais vezes, melhor!"
)
(qst_tier1_overdrivefocus "Ciclo de Overdrive")
(qst_tier1_overdrivefocus_desc
   "Para conquistar <alt>c</alt>, ative o Overdrive sempre que estiver nos holofotes!"
)
(qst_tier1_overdrivefocus_long_desc
   "Para conquistar <alt>c</alt> de bônus, ative o Overdrive quando estiver nos holofotes para passar a vez ao próximo jogador. Quanto mais passagens sua banda conseguir, melhor!"
)
(qst_tier1_overdrivegainfocus "Oportunidade de Overdrive")
(qst_tier1_overdrivegainfocus_desc
   "Para conquistar <alt>c</alt>, ganhe Overdrive sempre que for sua vez!"
)
(qst_tier1_overdrivegainfocus_long_desc
   "Para conquistar <alt>c</alt> de bônus, ganhe Energia de Overdrive quando estiver nos holofotes para passar a vez ao próximo jogador. Quanto mais passagens sua banda conseguir, melhor!"
)
(qst_tier1_overdrivetimer "Combo de Overdrive")
(qst_tier1_overdrivetimer_desc
   "Para conquistar <alt>c</alt> de bônus, mantenha o Overdrive pelo maior tempo possível!"
)
(qst_tier1_overdrivetimer_long_desc
   "Para conquistar <alt>c</alt> de bônus, mantenha o Overdrive pelo maior tempo possível!\n\nMaximize seus <alt>c</alt> de bônus encadeando suas ativações de Overdrive!"
)
(qst_tier1_perfectoverdrive "Série Perfeita de Overdrive")
(qst_tier1_perfectoverdrive_desc
   "Para conquistar <alt>c</alt> de bônus, mantenha um combo sempre que ativar o Overdrive!"
)
(qst_tier1_perfectoverdrive_long_desc
   "Para conquistar <alt>c</alt> de bônus, alcance o combo exigido enquanto estiver em Overdrive!\n\nMaximize seus <alt>c</alt> de bônus fazendo o maior combo possível enquanto estiver em Overdrive."
)
(qst_tier1_streak "Mania de Combos")
(qst_tier1_streakfocus "Compartilhe os Holofotes")
(qst_tier1_streakfocus_desc
   "Para conquistar <alt>c</alt> de bônus, mantenha um combo sempre que estiver nos holofotes!"
)
(qst_tier1_streakfocus_long_desc
   "Para conquistar <alt>c</alt> de bônus, alcance o combo exigido quando estiver nos holofotes para passar a vez ao próximo jogador. Quanto mais passagens sua banda conseguir, melhor!\n\nMaximize seus <alt>c</alt> de bônus mantendo o combo da banda!"
)
(qst_tier1_streak_desc
   "Para conquistar <alt>c</alt> de bônus, faça o maior número de combos que conseguir!"
)
(qst_tier1_streak_long_desc
   "Para conquistar <alt>c</alt> de bônus, alcance o combo exigido o maior número de vezes possível -- qualquer erro reiniciará seu combo!\n\nMaximize seus <alt>c</alt> de bônus fazendo isso várias vezes seguidas!"
)
