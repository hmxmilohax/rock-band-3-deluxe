)
(female_hat_outlaw_farrah_resource "Foragida do Metal c/ Cabelo Longo")
(female_hat_outlaw_farrah_resource_desc
   "Este visual de \qgarota má\q é ideal para fugir da cidade depois de partir corações demais e enfurecer gerentes de casas noturnas demais."
)
(female_hat_outlaw_shortspikes_resource "Foragida do Metal c/ Cabelo Curto")
(female_hat_outlaw_shortspikes_resource_desc
   "Este visual de \qgarota má\q é ideal para fugir da cidade depois de partir corações demais e enfurecer gerentes de casas noturnas demais."
)
(female_hat_rockheaddress_resource "Adorno de Virar Cabeças")
(female_hat_rockheaddress_resource_desc
   "Use este adorno artesanal com orgulho e veja as cabeças invejosas se virarem!"
)
(female_hat_rockhelmet_eagle_resource "Inferno sobre Rodas")
(female_hat_rockhelmet_eagle_resource_desc
