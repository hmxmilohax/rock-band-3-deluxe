(tc_sustain "Deve sustentar todas as notas longas")
(tc_trill_all "Deve acertar todas as notas de trinado")
(teardropbass_resource "O Baixo Lágrima")
(teardropbass_resource_desc
   "Com suas linhas limpas, design revolucionário e braço pintado à mão, O Lágrima remete a uma época anterior às guitarras com formato de lobisomens enfurecidos."
)
(teardrop_resource "O Lágrima")
(teardrop_resource_desc
   "Com suas linhas limpas, design revolucionário e braço pintado à mão, O Lágrima remete a uma época anterior às guitarras com formato de lobisomens enfurecidos."
)
(techno "Techno")
(teen "Adolescente")
(telebass "Squier<sup>TM</sup> Vintage Modified Precision Bass® TB")
(telebass_desc
   "Com seu enorme captador humbucker e linhas clássicas, este baixo recupera tudo o que havia de ótimo no rock dos anos 70, uma década na qual você provavelmente nem era vivo."
)
(telecaster01 "Fender<sup>TM</sup> Classic '50s Telecaster<sup>TM</sup>")
(telecaster01_desc
   "Conhecida primeiro como Esquire<sup>TM</sup> e depois como Broadcaster, esta guitarra clássica finalmente recebeu o nome de uma invenção popular da época — a televisão."
)
(telecaster02 "Fender<sup>TM</sup> 1969 Thinline Telecaster<sup>TM</sup>")
(telecaster02_desc
   "A Thinline Tele<sup>TM</sup> possui câmaras ocas que reduzem o peso da guitarra, permitem um timbre mais ressonante e tornam possível que uma Tele exiba aquela elegante abertura em F."
)
(telecaster03 "Fender<sup>TM</sup> 1972 Telecaster<sup>TM</sup> Deluxe")
(telecaster03_desc
   "Os anos 70 foram uma época decadente tanto para os músicos quanto para seus instrumentos. Esta Tele<sup>TM</sup> possui dois captadores com cancelamento de ruído, um escudo de curvas voluptuosas e até um headstock de Stratocaster<sup>TM</sup>."
)
(telecaster04 "Fender<sup>TM</sup> Custom Telecaster<sup>TM</sup> FMT HH")
(telecaster04_desc
   "Às vezes, os escudos apenas atrapalham. E às vezes você precisa de dois captadores com cancelamento de ruído para garantir que seja ouvido em alto e bom som. Se este é um desses momentos, você precisa desta guitarra."
)
(telecaster05
   "Fender<sup>TM</sup> J5 Triple Telecaster<sup>TM</sup> Deluxe"
)
(telecaster05_desc
   "Caso queira que sua guitarra grite \qagressiva,\q esta Tele<sup>TM</sup>, com seu terceiro captador com cancelamento de ruído, ponte tremolo vintage e escudo cromado, é ideal. Só não tente passar com ela por nenhum detector de metais."
)
(telecaster06 "Fender<sup>TM</sup> 1959 Custom Telecaster<sup>TM</sup>")
(telecaster06_desc
   "Alguns dizem que o segredo do twang inimitável da Tele<sup>TM</sup> da era de ouro está na influência alquímica da tampa ferrosa de ponte em forma de \qcinzeiro\q sobre o campo magnético ao redor do captador da ponte."
)
