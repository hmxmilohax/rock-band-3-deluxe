(manage_staff "Gerenciar Staffs")
(manual_lag_instructions
   "Ajuste a Compensação de Latência pressionando Esquerda ou Direita do seu D-pad, e depois selecionando PRÓXIMO para confirmar a configuração."
)
(maple "Bordo Natural")
(marine "Marine FinishPly<sup>TM</sup>")
(maryjanes_retro "Mary Birds")
(maryjanes_retro_desc
   "Saltos altos e tiras charmosas tornam estes clássicos retrô perfeitos para qualquer ocasião."
)
(matadorjacket_bedazzled "Jaqueta Matadorável")
(matadorjacket_bedazzled_desc
   "Pegue o touro pelos chifres com esta peça deslumbrante."
)
(matadorpants_bedazzled "Leggings Matadoráveis")
(matadorpants_bedazzled_desc
