(weight "Peso")
(westernfringe_applique "Camisa Coração Partido")
(westernfringe_applique_desc
   "Porque, se você contar para minha camisa, minha camisa de coração partido... certo, já chega disso."
)
(westernslipons_embroidered "Sapatos Wango Tango")
(westernslipons_embroidered_desc
   "Dance tango a noite inteira com estes elegantes slip-ons de couro."
)
(whiteflaircumber_cotton "Mercury Poderoso")
(whiteflaircumber_cotton_desc "Com estas calças... você é o campeão.")
(wifebeaterplain_biohazard "Regata Biohazard")
(wifebeaterplain_biohazard_desc
   "Um talento como o seu precisa de um rótulo de advertência; esta regata tóxica pode ser exatamente o que faltava."
)
(wifebeater_amsterdamwindmill "O Moinho")
(wifebeater_amsterdamwindmill_desc
   "Esteja você moendo produtos agrícolas ou fazendo sua melhor imitação de roqueiro de arena, o Moinho é realmente icônico."
)
(wifebeater_berlinboot "Caneca-Bota de Berlim")
(wifebeater_berlinboot_desc
   "O segredo é girar a bota quando estiver chegando ao fundo."
)
(wifebeater_bostonmass "Apelo de Massa")
(wifebeater_bostonmass_desc
   "Massachusetts: leis puritanas, sujeitos barulhentos chamados Murph e impostos absurdamente altos. Como não amar?"
)
(wifebeater_chicagoloop "Camiseta Autoridade de Transporte")
(wifebeater_chicagoloop_desc
   "Visite o centro de Chicago, conhecido como \qThe Loop,\q mas lembre-se de que, assim como a música, você apenas ficará dando voltas."
)
(wifebeater_istanbulmosque "Preso numa Mesquita")
(wifebeater_istanbulmosque_desc
   "A Mesquita do Sultão Ahmed é uma das principais atrações turísticas de Istambul e rende um logotipo de camisa incrível."
)
(wifebeater_nyhc "Hardcore de Nova York")
(wifebeater_nyhc_desc
   "Nova York, Nova York, é uma cidade e tanto. O X fica em cima e o Y embaixo."
)
(wifebeater_rioparrot "Vida Selvagem do Rio")
(wifebeater_rioparrot_desc
   "É estranho que papagaios, algumas das criaturas mais inteligentes da Terra, tenham sido associados a festas em estacionamentos, camisas chamativas e tios embriagados."
)
(wifebeater_riowax "Camiseta Depilação Brasileira")
(wifebeater_riowax_desc "Ah, Rio, Rio, depilar é realmente maravilhoso.")
(wifebeater_worn "Regata Stella")
(wifebeater_worn_desc
   "Grite para seu amor na sacada ou para seus fãs lá do palco usando esta regata já bem amaciada."
)
(wildwood "Fender<sup>TM</sup> Wildwood<sup>TM</sup>")
(wildwoodbass "Fender<sup>TM</sup> Wildwood<sup>TM</sup> Bass")
(wildwoodbass_desc
   "Este baixo lindamente construído com madeira multicolorida certamente iniciará conversas ainda melhores do que sua camiseta irônica \qNão Sou Turista, Moro Aqui\q."
)
(wildwood_desc
   "Para criar a atraente variação de cores da Fender<sup>TM</sup> Wildwood<sup>TM</sup>, árvores vivas de faia receberam injeções de corante. O resultado: uma linda guitarra de tampo plano e faias levemente irritadas."
)
(windbreaker_punked "Selvagem & Remendado")
(windbreaker_punked_desc
   "O charme brutal deste corta-vento equipado será um sucesso entre seus amigos."
)
(wingsbass_resource "O Baixo Anjo Caído")
(wingsbass_resource_desc
   "Acrescente uma boa dose de drama melancólico à sua música com esta bela obra de arte esculpida."
)
(wings_resource "O Anjo Caído")
(wings_resource_desc
   "Acrescente uma boa dose de drama melancólico à sua música com esta bela obra de arte esculpida."
)
(winner "VENCEDOR!")
(win_congrats "Parabéns!")
(with "com")
(wizardpants_dragons "Jardineiras e Dragões")
(wizardpants_dragons_desc
   "Você lançará feitiços em todos os seus fãs usando estas calças dignas de um mago."
)
(woodash "Freixo")
(woodmaple "Maple")
(workjacket_canvas "Trabalhador Elegante")
(workjacket_canvas_desc
   "Convença seus fãs de que você é \qapenas um deles\q usando esta peça essencial do guarda-roupa operário."
)
(workjacket_grimey "Frentista")
(workjacket_grimey_desc
   "Bem-vindo à semana de trabalho. Pode verificar o óleo enquanto está nisso?"
)
(workpants_grimey "Trabalhando Horas Extras")
(workpants_grimey_desc "Direto da fábrica para o palco.")
(world "Mundial")
(wornleatherpants_worn "Calças de Couro Pele de Toupeira")
(wornleatherpants_worn_desc
   "Estas calças são feitas do couro mais macio e flexível que você já vestiu."
)
(wornlongsleeveshirt_amsterdamcuckoo "Cuco de Amsterdã")
(wornlongsleeveshirt_amsterdamcuckoo_desc
   "CUCO! CUCO! CUCO! CUCO! CUCO! CUCO!"
)
(wornlongsleeveshirt_bostonlobstah "Lagosta de Boston")
(wornlongsleeveshirt_bostonlobstah_desc
   "O babador pode parecer bobo, mas protegerá sua camiseta novinha de toda aquela manteiga."
)
(wornlongsleeveshirt_chicagonight "Camiseta Vida Noturna de Chicago")
(wornlongsleeveshirt_chicagonight_desc
   "A vida noturna de Chicago é ótima, caso você goste de sair com dois bombeiros falando sem parar sobre salsichas, cervejas e o Crosstown Classic."
)
(wornlongsleeveshirt_elfcrossing "Travessia de Elfos em Reykjavik")
(wornlongsleeveshirt_elfcrossing_desc
   "Olhe para os dois lados antes de atravessar a Austurstraeti."
)
(wornlongsleeveshirt_fender "Camisa Fender<sup>TM</sup>")
(wornlongsleeveshirt_fender_desc
   "Apaixonado pela sua Fender<sup>TM</sup>? Sua camisa também!"
)
(wornlongsleeveshirt_lasurgery "Cirurgia Infernal de Los Angeles")
(wornlongsleeveshirt_lasurgery_desc
   "Você precisa estar no seu melhor na Cidade dos Anjos."
)
(wornlongsleeveshirt_montrealfrench "Parlez-vous Québécois?")
(wornlongsleeveshirt_montrealfrench_desc
   "Montréal: uma cidade de enorme história e beleza. E também poutine!"
)
(wornlongsleeveshirt_romewolf "Vá a Roma se Quiser")
(wornlongsleeveshirt_romewolf_desc
   "Esta camisa retrata os gêmeos míticos Rômulo e Remo, que aparentemente foram criados por um texugo de olhos arregalados."
)
(wornlongsleeveshirt_sanfrantrolley "Camiseta Bonde de São Francisco")
(wornlongsleeveshirt_sanfrantrolley_desc
   "Ding ding! Faça uma viagem de bondinho até a Lombard Street, a única coisa na Terra mais tortuosa do que sua gerência!"
)
(wornlongsleeveshirt_striped "Zoom Rugby")
(wornlongsleeveshirt_striped_desc
   "Mangas compridas e listras de rúgbi fazem desta a camisa ideal para sair da van e tocar um pouco de música!"
)
(wornpleatedskirt_flower "Flor de Parede")
(wornpleatedskirt_flower_desc
   "Ei, não é como se você sequer QUISESSE dançar."
)
(wornpleatedskirt_plain "Seu Coração Plissado")
(wornpleatedskirt_plain_desc
   "Conservadora E fabulosa, como um republicano do Log Cabin."
)
(wornpleatedskirt_poodle "Saia Poodle")
(wornpleatedskirt_poodle_desc
   "A única peça de roupa com a qual sua avó e sua paixão rockabilly concordarão!"
)
(worntshirt_blood "Camiseta Sangue dos Seus Inimigos")
(worntshirt_blood_desc
   "A banda do fim dos anos 80 que provou que baladas chorosas só precisam ser intercaladas com um ou dois hinos de metal para parecerem totalmente incríveis."
)
(worntshirt_dublinup "Dublin em Dobro!")
