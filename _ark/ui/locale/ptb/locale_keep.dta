)
(maple "Bordo Natural")
(marine "Acabamento Marinho FinishPly<sup>TM</sup>")
(maryjanes_retro "Mary Birds")
(maryjanes_retro_desc
   "Saltos altos e tiras delicadas tornam estes clássicos retrô perfeitos para qualquer ocasião."
)
(matadorjacket_bedazzled "Jaqueta Matadorável")
(matadorjacket_bedazzled_desc
   "Agarre o touro pelos chifres com esta peça deslumbrante."
)
(matadorpants_bedazzled "Leggings Matadoráveis")
(matadorpants_bedazzled_desc
   "Porque, como musicista de rock, você terá que lidar com muita conversa fiada."
)
