)
(miniskirtandleggings_worn "Stevie Knickers")
(miniskirtandleggings_worn_desc
   "Você vai ficar mais bonito que uma pomba de asas brancas com esta combinação de minissaia e leggings com acabamento de renda."
)
(miniskirt_leathergothy "Minissaia Assombre-me, Assombre-me")
