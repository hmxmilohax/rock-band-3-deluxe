(qst_tier1_accuracyfocus "Sob os Holofotes")
(qst_tier1_accuracyfocus_desc
   "Para ganhar <alt>c</alt> bônus, toque com precisão sempre que estiver sob os holofotes!"
)
(qst_tier1_accuracyfocus_long_desc
   "Para ganhar <alt>c</alt> bônus, alcance a precisão exigida quando estiver sob os holofotes!\n\nMaximize seus <alt>c</alt> bônus fazendo isso várias vezes seguidas!"
)
(qst_tier1_accuratesectioncount "Precisão")
(qst_tier1_accuratesectioncount_desc
   "Para ganhar <alt>c</alt> bônus, toque cada seção da música com precisão!"
)
(qst_tier1_accuratesectioncount_long_desc
   "Para ganhar <alt>c</alt> bônus, alcance a precisão exigida em cada seção da música!\n\nMaximize seu bônus fazendo isso várias vezes seguidas!"
)
(qst_tier1_bandaccuracy "Todos Por Um")
(qst_tier1_bandaccuracy_desc
   "Para ganhar <alt>c</alt> bônus, toque cada sessão da música com precisão! Todos os jogadores devem tocar a sessão com precisão para contar."
)
(qst_tier1_bandaccuracy_long_desc
   "Para ganhar <alt>c</alt> bônus, toque cada sessão da música com precisão! Todos os jogadores devem tocar a sessão com precisão para contar.\n\nMaximize seus <alt>c</alt> bônus fazendo isso múltiplas vezes em sequência!"
)
(qst_tier1_deploycount "Sobrecarga de Overdrive")
(qst_tier1_deploycount_desc
   "Para ganhar <alt>c</alt> bônus, ative o Overdrive o maior número de vezes possível!"
)
(qst_tier1_deploycount_long_desc
   "Para ganhar <alt>c</alt>bônus, ative o Overdrive o maior número de vezes possível! Você não precisa encher completamente o seu medidor -- ative sempre que puder!"
)
(qst_tier1_fulldeploycount "Overdrive Completo")
(qst_tier1_fulldeploycount_desc
   "Para ganhar <alt>c</alt>, ative um medidor completo de Overdrive o maior número de vezes possível!"
)
(qst_tier1_fulldeploycount_long_desc
   "Para ganhar <alt>c</alt> bônus, ative o Overdrive quando o medidor estiver cheio -- quanto mais vezes, melhor! Apenas ativações com o Overdrive completo contam."
)
(qst_tier1_maxmultdeploycount "Overdrive Otimizado")
(qst_tier1_maxmultdeploycount_desc
   "Para ganhar <alt>c</alt>, ative o Overdrive com o multiplicador máximo o maior número de vezes possível!"
)
(qst_tier1_maxmultdeploycount_long_desc
   "Para ganhar <alt>c</alt> bônus, ative o Overdrive quando seu multiplicador estiver no máximo -- quanto mais vezes, melhor!"
)
(qst_tier1_overdrivefocus "Ciclo de Overdrive")
(qst_tier1_overdrivefocus_desc
   "Para ganhar <alt>c</alt>, ative o Overdrive sempre que estiver sob os holofotes!"
)
(qst_tier1_overdrivefocus_long_desc
   "Para ganhar <alt>c</alt> bônus, ative o Overdrive quando estiver sob os holofotes para passar a vez ao próximo jogador. Quanto mais passes sua banda conseguir, melhor!"
)
(qst_tier1_overdrivegainfocus "Oportunidade de Overdrive")
(qst_tier1_overdrivegainfocus_desc
   "Para ganhar <alt>c</alt>, obtenha Overdrive sempre que for sua vez!"
)
(qst_tier1_overdrivegainfocus_long_desc
   "Para ganhar <alt>c</alt> bônus, obtenha Energia do Overdrive quando estiver sob os holofotes para passar a vez ao próximo jogador. Quanto mais passes sua banda conseguir, melhor!"
)
(qst_tier1_overdrivetimer "Sequência de Overdrive")
(qst_tier1_overdrivetimer_desc
   "Para ganhar <alt>c</alt> bônus, mantenha o Overdrive pelo maior tempo possível!"
)
(qst_tier1_overdrivetimer_long_desc
   "Para ganhar <alt>c</alt> bônus, mantenha o Overdrive pelo maior tempo possível!\n\nMaximize seus <alt>c</alt> bônus encadeando suas ativações de Overdrive!"
)
(qst_tier1_perfectoverdrive "Série Perfeita de Overdrive")
(qst_tier1_perfectoverdrive_desc
   "Para ganhar <alt>c</alt> bônus, mantenha uma sequência sempre que ativar o Overdrive!"
)
(qst_tier1_perfectoverdrive_long_desc
   "Para ganhar <alt>c</alt> bônus, alcance a sequência exigida enquanto estiver em Overdrive!\n\nMaximize seus <alt>c</alt> bônus mantendo a maior sequência possível enquanto estiver em Overdrive."
)
(qst_tier1_streak "Mania de Sequências")
(qst_tier1_streakfocus "Compartilhe os Holofotes")
(qst_tier1_streakfocus_desc
   "Para ganhar <alt>c</alt> bônus, mantenha uma sequência sempre que estiver sob os holofotes!"
)
(qst_tier1_streakfocus_long_desc
   "Para ganhar <alt>c</alt> bônus, alcance a sequência exigida quando estiver sob os holofotes para passar a vez ao próximo jogador. Quanto mais passes sua banda conseguir, melhor!\n\nMaximize seus <alt>c</alt> bônus mantendo a sequência da banda!"
)
(qst_tier1_streak_desc
   "Para ganhar <alt>c</alt> bônus, faça o maior número possível de sequências!"
)
(qst_tier1_streak_long_desc
   "Para ganhar <alt>c</alt> bônus, alcance a sequência exigida o maior número de vezes possível -- qualquer erro reiniciará sua sequência!\n\nMaximize seus <alt>c</alt> bônus fazendo isso várias vezes seguidas!"
)
