(blackjack "Gráficos de Blackjack")
(blankhoodie_ernieballheart "Moletom Coração Ernie Ball")
(blankhoodie_ernieballheart_desc
   "A pioneira das cordas de guitarra do rock and roll quer que você toque com o coração à mostra! Ou estampado no moletom, neste caso."
)
(blankhoodie_ludwigsticks "Moletom Ludwig®")
(blankhoodie_ludwigsticks_desc
   "Mostre sua devoção às baterias Ludwig com este moletom estiloso."
)
(blankhoodie_moscowsputnik "Grande Grande Sputnik")
(blankhoodie_moscowsputnik_desc
   "Se você acredita que colocaram um homem na Lua, não há nada escondido nestas mangas."
)
(blankhoodie_pearlscript "Moletom Pearl")
(blankhoodie_pearlscript_desc
   "Represente sua fabricante de baterias favorita, a Pearl, com este moletom descolado."
)
(blankhoodie_sennheiser "Moletom Sennheiser")
(blankhoodie_sennheiser_desc
   "Ama os microfones Sennheiser? Grite isso para o mundo com este belo moletom!"
)
(blankhoodie_solid "Bom Moletom")
(blankhoodie_solid_desc "Você pode se sentir bem usando moletons.")
(blankhoodie_vicfirth "Moletom Vic Firth®")
(blankhoodie_vicfirth_desc
   "Ama suas baquetas Vic Firth®? Mostre isso com este moletom quente e aconchegante."
)
(blank_01 "(Sem Palco)")
