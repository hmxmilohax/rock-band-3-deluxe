(trainer_drm_trickysnares1_13_info
   "Mantenha as mãos dominante e não dominante separadas para acrescentar a caixa antes do bumbo no tempo forte."
)
(trainer_drm_trickysnares2_14 "Caixas Complicadas 2")
(trainer_drm_trickysnares3_15 "Caixas Complicadas 3")
(trainer_drm_trickysnares4_16 "Caixas Complicadas 4")
(trainer_drm_triples2_9 "Tercinas 2")
(trainer_drm_triples2_9_info "Alterne a mão que inicia a cada batida.")
(trainer_drm_triples_8 "Tercinas 1")
(trainer_drm_triples_8_info "Alterne a mão que inicia na metade.")
(trainer_drm_tripletcym_10 "Caixas em Tercinas com Pratos de Ataque")
(trainer_drm_tripletcym_10_info
   "Toque os pratos com a mão dominante enquanto executa toques duplos na caixa com a mão não dominante."
)
(trainer_drm_tripletdoom_40 "Perdição em Tercinas")
(trainer_drm_tripletdoublestroke_12 "Toques Duplos em Tercinas")
(trainer_drm_tripletfill_13 "Tercinas Descendo pelo Kit")
(trainer_drm_tripletfill_13_info
   "Mantenha a mão não dominante no tom agudo enquanto alterna a mão dominante entre a caixa e o tom grave."
)
(trainer_drm_triplethehats1_34 "Chimbais em Tercinas 1")
(trainer_drm_triplethehats2_35 "Chimbais em Tercinas 2")
(trainer_drm_tripletsingleskick_2 "Toques Simples em Tercinas 1, com Bumbo")
(trainer_drm_tripletsingleskick_2_info
   "Acrescente o bumbo nas semínimas."
)
(trainer_drm_tripletsingles_1 "Toques Simples em Tercinas 1")
(trainer_drm_tripletsingles_1_info
   "Sempre que uma batida é dividida em três notas, ela é chamada de tercina. Tente iniciar as notas com a mão dominante."
)
(trainer_drm_tripoly2_6 "Polirritmia Tripla 2")
(trainer_drm_tripoly3_7 "Polirritmia Tripla 3")
(trainer_drm_tripoly_5 "Polirritmia Tripla 1")
(trainer_drm_tripoly_5_info "Use uma mão por pista.")
