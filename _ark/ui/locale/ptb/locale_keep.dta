(trainer_drm_snaredoubles2 "Duplas de Caixa 2")
(trainer_drm_snareonly_1 "Semínina de Caixas")
(trainer_drm_snareonly_1_desc
   "Ao segurar as baquetas, tente manter a pegada relaxada a cerca de um terço da distância a partir da base. Também tente prender a baqueta entre o polegar e o indicador."
)
(trainer_drm_snareonly_1_info
   "Tente tocar estas notas com sua mão esquerda não dominante. Se você for canhoto, tente tocá-las com sua mão direita não dominante."
)
(trainer_drm_snareonly_5 "Coletor de Energia")
(trainer_drm_snareonly_5_info
   "Toque perfeitamente as notas brancas brilhantes para coletar Energia."
)
(trainer_drm_snarepolyrhythm "Polirritmia de Caixa")
(trainer_drm_straightvsswing_1 "Sensação Reta vs. Swing")
(trainer_drm_straightvsswing_1_info
   "Alterne entre colcheias retas e swingadas usando uma mão. Sinta a diferença."
)
(trainer_drm_surfinon2hands_2 "Surfando com Duas Mãos")
(trainer_drm_surfinon2hands_2_info
   "Fique atento às batidas duplas de caixa."
)
(trainer_drm_surfsup_6 "Surf à Vista")
(trainer_drm_swingandstomp_31 "Swing e Pisada")
(trainer_drm_swinginmix_29 "Mistura Swingada 1")
(trainer_drm_swinginmix_29_info
   "Alterne a sensação de swing entre a caixa e o bumbo."
)
(trainer_drm_swingthehats_17 "Chimbais Swingados")
(trainer_drm_swingthekick_18 "Bumbo Swingado")
(trainer_drm_swingthekick_18_info
   "Mantenha as mãos e o pé separados acrescentando um bumbo swingado antes da caixa no tempo forte."
)
(trainer_drm_thebeatthatfeeds_26 "A Batida que Alimenta")
(trainer_drm_tomrollcym_09 "Tons e Pratos de Ataque em Semicolcheias")
(trainer_drm_tomrollcym_09_info
   "Toque cada prato de ataque com a mão dominante, trazendo a mão não dominante para tocar a primeira semicolcheia de cada rufo."
)
(trainer_drm_tomsofdoom_39 "Tons da Perdição")
(trainer_drm_tomsonly_5 "Semínima de Toms")
(trainer_drm_tomsonly_5_info
   "Para estas notas de tom, use as duas mãos juntas."
)
