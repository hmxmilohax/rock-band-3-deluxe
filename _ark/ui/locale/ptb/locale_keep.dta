   "Este visual clássico dos anos 70 é perfeito para sua próxima festa de Metal."
)
(female_makeup_eyes_16 "Olhar por Baixo")
(female_makeup_eyes_16_desc "Desfoque as linhas, não a sua imagem.")
(female_makeup_eyes_17 "Inveja")
(female_makeup_eyes_17_desc "Você está verde de inveja.")
(female_makeup_eyes_18 "Desvanecendo em Rosa")
