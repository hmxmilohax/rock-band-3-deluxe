(snake "Pele de Cobra")
(snare_red "caixa")
(snare_red3 "3 pistas")
(sneakerboots_vinyl "Botas-Tênis")
(sneakerboots_vinyl_desc
   "São tênis... E também são botas. O que será que aqueles cientistas malucos dos calçados inventarão depois?"
)
(sneakersbasketball_pleather "Saltos Estelares")
(sneakersbasketball_pleather_desc
   "Mire nas estrelas! Estes tênis versáteis de basquete ajudarão você a alcançar novas alturas."
)
(sneakersbasketball_sporty "Tênis Esportivos")
(sneakersbasketball_sporty_desc
   "Mostre seu talento atlético \qjogando a velha forma de torta\q por aí (ou qualquer outra expressão esportiva convincente)."
)
(sneakersstripes_nylon "Mercúrios")
(sneakersstripes_nylon_desc
   "Batizados em homenagem às sandálias aladas do deus romano, estes tênis listrados darão asas a você no palco."
)
(sneakerswrestling_canvas "Nº Treze")
(sneakerswrestling_canvas_desc "Os tênis mais sortudos que o dinheiro pode comprar.")
(sneakers_leather "Tênis Italianos")
(sneakers_leather_desc
   "Este belo par de tênis italianos de couro é simplesmente um clássico."
)
