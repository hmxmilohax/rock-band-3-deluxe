(award_secret_title "Secreto")
(award_serious_skills "Sérias Habilidades")
(award_serious_style_points "O Mais Energético")
(award_spirited_survivor "Sobrevivente Espiritual")
(award_tattoos "Loja de Tatuagem!")
(award_tattoos_desc
   "Agora você tem credibilidade suficiente para fazer uma tatuagem! Dê uma olhada na seção de Tatuagens no menu \qPersonalizar Personagem\q."
)
(award_test1 "Prêmio Placeholder 1")
(award_test1_desc "Você ganhou alguns instrumentos, eu acho?")
(award_test2 "Prêmio Placeholder #2")
(award_test2_desc "Você ganhou um pônei! UM PÔNEI, EU DIGO!")
(award_test3 "Prêmio Placeholder 3")
(award_test3_desc "Você ganhou um encontro com Dan Teasdale!")
(award_top_performer "Melhor Performer")
(award_unconscious "Inconsciente")
(award_van "Você ganhou uma Van!")
(award_van_desc
   "Agora que você tem essa van maneiríssima, pode encarar Desafios de Turnê mais longos! E não exagere no aromatizador de ar... isso só vai piorar o cheiro."
)
(award_videovenues "Locais de Videoclipe Desbloqueados!")
(award_videovenues_desc
   "Muito bem, agora você tem fãs suficientes para começar a fazer videoclipes! Tente garantir que eles sempre filmem seu lado bom..."
)
(award_win "Você completou Rock Band 3!")
(award_win_desc
   "Uau. Isso é incrível! Você é membro de um grupo seleto de pessoas que triunfaram em tudo que os jogos musicais modernos têm a oferecer. Parabéns por zerar Rock Band 3, de todos nós da Harmonix!"
)
(awesome_solo "Solo Incrível!")
(axebass_resource "O Baixo Executor")
(axebass_resource_desc
   "Se a multidão não gritar alto o bastante, cabeças vão rolar..."
)
(axe_resource "O Executor")
(axe_resource_desc
   "Se a multidão não gritar alto o bastante, cabeças vão rolar..."
)
