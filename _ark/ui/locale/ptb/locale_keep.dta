(flamehotrod "Gráficos de Chamas de Hot Rod")
(flameshoes_leather "Botas Chamas Mais Altas")
(flameshoes_leather_desc
   "As chamas do Inferno ungiram estas botas com o poder supremo do Rock. Use-as com orgulho."
)
(flametribal "Gráficos de Chamas Tribais")
(flametribalnatural "Gráficos Exóticos de Chamas Tribais")
(flannelcoat_checked "Flanela Ledbetter")
(flannelcoat_checked_desc
   "Seja o boxeador, não o saco de pancadas, com este casaco vintage de flanela."
)
(flaredistressedpants_bleachedjeans "Boca de Lis")
(flaredistressedpants_bleachedjeans_desc
   "Nada transmite melhor a ideia de \qartista legítima\q do que um jeans previamente usado e artisticamente desbotado. Perfeito para o palco ou para a exposição de arte mais badalada."
)
(flarejeans_worn "Cintura Baixa")
(flarejeans_worn_desc
   "Apertado nos lugares certos e perfeitamente solto nos demais, este jeans é um clássico."
)
(flatslips_stripe "Listras Largas")
(flatslips_stripe_desc
   "Você fica mais do que bonita com estas adoráveis sapatilhas listradas."
)
(flightjacket_solid "Jaqueta de Voo Clássica MA-1")
(flightjacket_solid_desc
   "Que visual elegante! E lembre-se: se você se perder, vire-a do avesso para que seus fãs encontrem você pelo amigável brilho laranja."
)
(flightsuitpants_canvas "Calças da Zona de Perigo")
(flightsuitpants_canvas_desc
   "Subindo ao palco, vou tocar um show esta noi-ite, i-ite, i-ite, i-ite."
)
(floppyboots_leather "Pisoteadores de Lama")
(floppyboots_leather_desc
   "Atravesse mares de fãs suados ou simplesmente pise com força nas poças de lama dos festivais usando estas botas de couro bem desgastadas."
)
(fmp_back "VOLTAR")
(fmp_continue "JOGAR COM A FORMAÇÃO ATUAL")
