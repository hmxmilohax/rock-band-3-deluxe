)
(basictee_rbmic "Camiseta Vox")
(basictee_rbmic_desc
   "Mostre sua lealdade ao seu instrumento ou músico favorito com esta camiseta com o logo do vocal."
)
(basictee_redlight "Camiseta Amster-Don't")
(basictee_redlight_desc
