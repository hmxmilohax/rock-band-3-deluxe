(southernrock "Southern Rock")
(spacey "Espacial")
(space_jam "Space Jam")
(sparkle "Brilho")
(sparklefade "Brilho em Degradê")
(spats_twotone "Jack Spats")
(spats_twotone_desc "Entre estes dois sapatos, você vai deixar o palco limpinho.")
(speed "Velocidade")
(speedup "Acelerar")
(speedup_a "Acelerar A")
(speedup_b "Acelerar B")
(spikedarmorboots_leather "Cavaleiros da República do Metal")
(spikedarmorboots_leather_desc
   "Estas botas mostram ao mundo que você cavalgou ao lado de reis em poderosos corcéis e agora reina sobre seu próprio reino musical."
)
(spikedarmorleggings_spandex "Espeta-Joelhos Oni")
(spikedarmorleggings_spandex_desc
   "Os demônios vão tremer de medo quando virem sua feroz armadura nos joelhos."
)
(spikedarmor_leather "Armadura do Senhor dos Dragões")
(spikedarmor_leather_desc
   "Você é um Senhor dos Dragões. Relâmpagos anunciam sua chegada. Entre na arena como um trovão usando esta armadura digna de você."
)
(spikedboots_leather "Botas Spiketress")
(spikedboots_leather_desc
   "Estas botas foram feitas para combinar com as outras peças da Spiketress, mas você pode usá-las com qualquer coisa."
)
(spikedcollar_spiked "Algemado e Encoleirado")
(spikedcollar_spiked_desc
   "Mais cedo ou mais tarde você vai acabar algemado quando a polícia pegar você pelas suas loucuras no palco -- então é melhor já estar vestido para a ocasião!"
)
(spikedjacket_leather "Crepúsculo Espinhado")
(spikedjacket_leather_desc
   "Dê as boas-vindas à noite usando esta abominação cheia de espinhos."
)
(spikedleatherjacket_spiked "Casacotônico")
(spikedleatherjacket_spiked_desc
   "Caracterizado por acentuadas normalidades da moda, incluindo estrelato e atividade excessiva de fotógrafos."
)
(spikedleather_clean "Espinhos do Superestado Sônico")
(spikedleather_clean_desc
   "Sem promessas, mas é possível que esta belíssima jaqueta cheia de espinhos, tachas e estrelas torne você invencível!"
)
(spikedleggings_leather "Leggings Spiketress")
(spikedleggings_leather_desc
   "Estas leggings com espinhos vão dar a você uma vantagem sobre a concorrência."
)
(spikedplatformboots_solid "Plataformas Anquilopé")
(spikedplatformboots_solid_desc
   "Não se preocupe em entrar em extinção, porque com estas botas você vai sobreviver até aos mamíferos!"
)
(spikedshoes_leather "Espinhos Poderosos")
(spikedshoes_leather_desc "Sério, não tropece usando isto.")
(spikedshoulder_metal "Armadura Peso nos Ombros")
(spikedshoulder_metal_desc
   "Esta armadura de metal é definitivamente pesada -- ainda bem que você já está acostumado a carregar o peso de ser mais incrível que todo mundo no planeta."
)
(spikedtrackjacket_thinleather "Charles, o Sangrento")
(spikedtrackjacket_thinleather_desc
   "Com espinhos absurdamente grandes, esta fina jaqueta esportiva de couro é uma verdadeira aula de intimidação."
)
(spikedvest_leather "Colete Troll")
(spikedvest_leather_desc
   "Destaque-se com correntes, espinhos e couro. Você vai parecer mais que intimidador com este colete de couro."
)
(spikepads_distressed "Espaldeiras de Metal")
(spikepads_distressed_desc
   "Você veste couro, usa espinhos e domina a noite com esta temível armadura. Valhalla!"
)
(spikydocs_solid "Botas Caos Motociclístico")
(spikydocs_solid_desc
   "Acelere os motores! Estas botas são seu passaporte para a estrada."
)
(spinyboots_iron "Botas Arrepio na Espinha")
(spinyboots_iron_desc
   "Basta uma olhada nestas botas espinhentas para o segurança da porta pensar duas vezes antes de limitar os lugares da sua lista de convidados."
)
(spiralsolid "Espiral Sólida")
(spiraltrans "Espiral Transparente")
(splash_loading "Carregando...")
(sportbikeboots_leather "Botas Hanzo")
(sportbikeboots_leather_desc
   "Estas botas são tão ferozes que às vezes são conhecidas como \qHanzos do Diabo.\q"
)
(sportbikeleggings_leather "Couros Hanzo")
(sportbikeleggings_leather_desc
   "Aprimore suas habilidades marciais com estas leggings \qtestadas por samurais e aprovadas por ninjas.\q"
)
(sportysneaks_pleather "Tênis de Basquete")
(sportysneaks_pleather_desc
   "Dê a impressão de que está em forma com estes tênis esportivos, ideais para carregar equipamentos ou disputar uma partida improvisada às 3 da manhã."
)
(spurboots_leather "Vênus de Esporas")
(spurboots_leather_desc
   "A plateia vai beijar suas botas de couro brilhante, brilhante."
)
(standins "Sustitutos")
(standins_help
   "Os Membros Substitutos tocam no seu grupo quando algum jogador faltar na banda."
)
