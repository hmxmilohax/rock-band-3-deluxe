; random change
#define DX_CALLBACK_HANDLES
((hit miss pass first_note check_fc check_missed track_instrument num_gems_hit num_gems_combo num_gems_miss num_gems_pass))
{func
   dx_add_player_sinks
   ($all)
   ;{dx_log_writer info {sprint "func: dx_add_player_sinks"}}
   ;{dx_log_writer info
   ;   {sprintf "Executed dx_add_player_sinks - time: %.4fms"
         {time
            {if $all {set $dx_player_check_ready TRUE}}
            {dx_active_player_var_reset}
            {beatmatch foreach_active_player $player ;dx - add our custom fc checking callbacks to the currently loaded player
               {unless {== {$player instrument} vocals}
                  {set $dx_num_active_instruments {+ $dx_num_active_instruments 1}}
               }
               {unless {&& {! $all} {$player get dx_sinks_added FALSE}}
                  {unless {&& {! $all} {== {$player instrument} vocals}}
                     {$player add_sink fc_callback (hit miss pass num_gems_hit num_gems_combo num_gems_miss num_gems_pass)}
                     {dx_create_instrument_callback {$player instrument} $player {{$player get_user} get_slot_num}}
                     {unless {== {$player instrument} vocals}
                        {$player add_sink {sprint "fc_" {$player instrument} "_callback"} DX_CALLBACK_HANDLES}
                     }
                     {$player add_sink dx_streak_callback (hit miss pass fetch_all_streaks update_streak)}
                  }
                  {unless $all {dx_reset_dropped_in_player $player}}
                  {$player set dx_sinks_added TRUE}
               }
               {switch {$player instrument}
                  (bass
                     {set $bassplayeractive true}
                     {set $dx_num_active_strings {+ $dx_num_active_strings 1}}
                  )
                  (real_guitar
                     {set $real_guitarplayeractive true}
                     {set $dx_num_active_strings {+ $dx_num_active_strings 1}}
                  )
                  (real_bass
                     {set $real_bassplayeractive true}
                     {set $dx_num_active_strings {+ $dx_num_active_strings 1}}
                  )
                  (keys
                     {set $keysplayeractive true}
                  )
                  (real_keys
                     {set $real_keysplayeractive true}
                  )
                  (guitar
                     {set $guitarplayeractive true}
                     {set $dx_num_active_strings {+ $dx_num_active_strings 1}}
                  )
                  (drum
                     {set $drumplayeractive true}
                  )
                  (real_drum
                     {set $drumplayeractive true}
                  )
                  (vocals
                     {if {modifier_mgr is_modifier_active mod_auto_vocals}
                        {set $vocal_track_out TRUE}
                     }
                     {if {! {modifier_mgr is_modifier_active mod_auto_vocals}}
                        {set $vocalsplayeractive true}
                        {set $dx_active_vocals TRUE}
                        {set $vocal_track_out TRUE}
                     }
                  )
               }
            }
         }
   ;   }
   ;}
}
{func dx_check_player_drops
   {do
      ($new FALSE)
      {foreach_int $i 0 4 {set_var {sprint "dx_slot_used_" $i} FALSE}}
      {beatmatch foreach_active_player $p
         {unless {$p get dx_sinks_added FALSE} {set $new TRUE}}
         {unless {== {$p instrument} vocals} {set_var {sprint "dx_slot_used_" {{$p get_user} get_slot_num}} TRUE}}
      }
      {if $new
         {dx_add_player_sinks {<= {beatmatch get_song_ms} 0}}
         {if {|| $dx_customizer {modifier_mgr is_modifier_active mod_auto_play} $otherautoplay}
            {dx_set_auto_play}
         }
      }
      {foreach_int $i 0 4
         {with {find_obj {{get_track_panel} loaded_dir} {sprint "track_" $i}}
            {if {exists countdown.grp}
               {if_else {eval {var {sprint "dx_slot_used_" $i}}}
                  {unless {== {countdown.grp countdown_state} hidden}
                     {dx_countdown_place}
                     {script_task kTaskUISeconds
                        (delay 1.5)
                        (script {countdown.grp set_trans_parent game.cam TRUE})
                     }
                  }
                  {countdown.grp set_countdown_state hidden}
               }
            }
         }
      }
   }
}
{func dx_reset_dropped_in_player
   ($player)
   {if_else {== {$player instrument} vocals}
      {if {with {{get_track_panel} loaded_dir} {exists vocals}}
         {dx_track_update_countdown {find_obj {{get_track_panel} loaded_dir} vocals}}
      }
      {do
         ($slot {{$player get_user} get_slot_num})
         ($inst {$player instrument})
         ($cb {sprint "fc_" $inst "_callback"})
         ($dir {find_obj {{get_track_panel} loaded_dir} {sprint "track_" $slot}})
         ($pass {max 1 {eval {var {sprint "num_gems_pass_" $inst}}}})
         {set_var {sprint $inst "_firstnote"} TRUE}
         {set_var {sprint $inst "_missed_once"} TRUE}
         {set_var {sprint $inst "_combo_broken"} TRUE}
         {$cb set num_gems_hit {eval {var {sprint "num_gems_hit_" $inst}}}}
         {$cb set num_gems_miss {eval {var {sprint "num_gems_miss_" $inst}}}}
         {$cb set num_gems_pass $pass}
         {$cb store_note_hit_info}
         {dx_fc_ring_textures $slot FALSE}
         {dx_create_track_labels $player}
         {set_var {sprint "track_out_" $slot} FALSE}
         {dx_reset_player_track_meshes $player}
         {dx_track_update_countdown $dir}
         {if $dx_fc_glow
            {with {$dir find streak_meter}
               {end_streak.trig trigger}
               {star_deploy_stop.trig trigger}
            }
         }
         {dx_indv_note_streak $dx_track_streak $player $slot 0 $pass 0}
      }
   }
}
{func dx_create_track_labels
   ($player)
   {dx_track_label dx_track_label_username $dx_track_username_size $dx_track_username_font $dx_track_username_alignment $dx_track_username_kerning {{$player get_user} get_slot_num} $dx_track_username_x $dx_track_username_y $dx_track_username_r $dx_track_username_g $dx_track_username_b TRUE}
   {dx_perfect_label $dx_track_perfect_size $dx_track_perfect_font $dx_track_perfect_alignment $dx_track_perfect_kerning {{$player get_user} get_slot_num} $dx_track_perfect_x $dx_track_perfect_y $dx_track_perfect_r $dx_track_perfect_g $dx_track_perfect_b TRUE}
   {dx_track_label_streak dx_track_label_perfect_ctr $dx_track_perfect_ctr_size $dx_track_perfect_ctr_font $dx_track_perfect_ctr_alignment $dx_track_perfect_ctr_kerning {{$player get_user} get_slot_num} $dx_track_perfect_ctr_x $dx_track_perfect_ctr_y $dx_gold_ui_r $dx_gold_ui_g $dx_gold_ui_b TRUE}
   {dx_track_label_streak dx_track_label_streak $dx_track_streak_size $dx_track_streak_font $dx_track_streak_alignment $dx_track_streak_kerning {{$player get_user} get_slot_num} $dx_track_streak_x $dx_track_streak_y $dx_track_streak_r $dx_track_streak_g $dx_track_streak_b TRUE}
   {dx_track_label_overdrive dx_track_label_overdrive $dx_track_overdrive_size $dx_track_overdrive_font $dx_track_overdrive_alignment $dx_track_overdrive_kerning {{$player get_user} get_slot_num} $dx_track_overdrive_x $dx_track_overdrive_y $dx_track_overdrive_r $dx_track_overdrive_g $dx_track_overdrive_b TRUE}
}
{func
   dx_send_leader_song_speed
   ;{dx_log_writer info {sprint "func: dx_send_leader_song_speed"}}
   ;{dx_log_writer info
   ;   {sprintf "Executed dx_send_leader_song_speed - time: %.4fms"
         {time
            {if {is_leader_local} ; dx - sync speeds only if currently the lobby leader
               {if {< $leaderspeed 1.001}
                  ; clamp leader speed to 1.0 if the user intended to do that
                  ; works around floating point weirdness
                  {set $leaderspeed 1.0}
               }
               {dx_log_writer beatmatch {sprint "Sending Leader Speed to peers, Leaderspeed: " $leaderspeed ""}}
               DX_DISCONNECT
               {set $speedmod $leaderspeed}
               ;{set $speedmod_top $leaderspeed}
               {unless {session_mgr is_local}
                  {session send_msg_to_all {'`' (set $speedmod  {',' $leaderspeed})} kNetReliable}
               }
            }
         }
   ;   }
   ;}
}
{func
   dx_trainer_checker
   ;{dx_log_writer info {sprint "func: dx_trainer_checker"}}
   ;{dx_log_writer info
   ;   {sprintf "Executed dx_trainer_checker - time: %.4fms"
         {time
            {if {gamemode in_mode trainer}
               {beatmatch foreach_active_player $player
                  {switch {{$player get_user} get_slot_num}
                     ((0 1 2 3)
                        {switch {$player instrument}
                           (real_bass
                              {if {== $dx_trainer_real_bass FALSE}
                                 {set $dx_skip_game_setup TRUE}
                                 {set $dx_trainer_error_msg dx_no_trainer_real_bass}
                                 {if {exists meta_performer} {meta_performer skip_song}}
                                 {overshell set_active_status kOvershellInShell}
                                 {overshell update_all}
                                 {meta_loading_continue_screen set state kMetaLoading_Loading}
                                 {ui goto_screen meta_loading_continue_screen}
                              }
                           )
                           (real_keys
                              {if {== $dx_trainer_real_keys FALSE}
                                 {set $dx_skip_game_setup TRUE}
                                 {set $dx_trainer_error_msg dx_no_trainer_real_keys}
                                 {if {exists meta_performer} {meta_performer skip_song}}
                                 {overshell set_active_status kOvershellInShell}
                                 {overshell update_all}
                                 {meta_loading_continue_screen set state kMetaLoading_Loading}
                                 {ui goto_screen meta_loading_continue_screen}
                              }
                           )
                           (real_guitar
                              {if {== $dx_trainer_real_guitar FALSE}
                                 {set $dx_skip_game_setup TRUE}
                                 {set $dx_trainer_error_msg dx_no_trainer_real_guitar}
                                 {if {exists meta_performer} {meta_performer skip_song}}
                                 {overshell set_active_status kOvershellInShell}
                                 {overshell update_all}
                                 {meta_loading_continue_screen set state kMetaLoading_Loading}
                                 {ui goto_screen meta_loading_continue_screen}
                              }
                           )
                           (fail kDataUnhandled)
                        }
                     )
                  }
               }
            }
         }
   ;   }
   ;}
}
{func
   dx_venue_setter
   ;{dx_log_writer info {sprint "func: dx_venue_setter"}}
   ;{dx_log_writer info
   ;   {sprintf "Executed dx_venue_setter - time: %.4fms"
         {time
            {if {session_mgr is_leader_local}
               {if_else $dx_customizer
                  {meta_performer set_venue none}
                  {if_else {== $force TRUE}
                     {switch $dx_venue
                        (small_venues {meta_performer set_venue {random_elem (SMALL_VENUES)}})
                        (big_venues {meta_performer set_venue {random_elem (BIG_VENUES)}})
                        (arena_venues {meta_performer set_venue {random_elem (ARENA_VENUES)}})
                        (festival_venues {meta_performer set_venue {random_elem (FESTIVAL_VENUES)}})
                        (venues_video {meta_performer set_venue {random_elem (VENUES_VIDEO)}})
                        (random
                           {if_else $dx_enable_mv_venues
                              {meta_performer set_venue {random_elem (ALL_VENUES)}}
                              {meta_performer set_venue {random_elem (VENUES)}}
                           }
                        )
                        (none
                           {if_else {&& {! {session_mgr is_local}} {is_leader_local}}
                              {meta_performer set_venue {random_elem (VENUES)}}
                              {meta_performer set_venue none}
                           }
                        )
                        {meta_performer set_venue $dx_venue}
                     }
                     {meta_performer select_random_venue}
                  }
               }
               ;{dx_log_writer default {sprint "Venue set to " $dx_venue " - Forced: " $force}}
            }
         }
   ;   }
   ;}
}
;this function sucks actually
{func
   dx_toggle_fail_feedback
   {if
      {exists beatmatch}
      {if
         {&&
            {! {gamemode in_mode practice}} {! {gamemode in_mode trainer}}
         }
         {foreach_int $i 0 {beatmatch num_active_players} 
            {
               {beatmatch active_player $i} set_crowd_rating_active
                  {||
                     {modifier_mgr is_modifier_active mod_brutalmode} ; force on crowd meter if on brutal mode
                     {== $dx_crowd_meter_hud dx_on}
                     {== $dx_crowd_meter_hud dx_off}
                     {! {session_mgr is_local}}
                  }
            }
         }
         {do
            ($show {! {modifier_mgr is_modifier_active mod_karaoke}})
            ($vox {if_else $vocalsplayeractive {{find_obj {{get_track_panel} loaded_dir} vocals} get vox_configuration} 0})
            ($score {coop_track_panel find scoreboard})
            {{coop_track_panel find crowd_meter} set_showing {&& $show {== $dx_crowd_meter_hud dx_on}}}
            {foreach $entry (star_display numbers.grp sb_lens backplate.grp)
               {{$score find $entry} set_showing $show}
            }
            {if {! $show}
               {if $vocalsplayeractive
                  {$vox set remote FALSE}
                  {foreach $entry
                     (
                        tubes.grp tubes_milo.grp tube_range.grp
                        pitched_effect01.grp pitched_effect02.grp
                        pitch_mid_marker.grp phoneme0.grp phoneme1.grp phoneme2.grp
                        main.grp lyrics.grp lyrics_harmony.grp
                     )
                     {{{{get_track_panel} find vocals} find $entry} set_showing FALSE}
                  }
                  {$vox milo_apply}
               }
            }
         }
      }
   }
}

{func dx_init_gold_flash ()
   {new Object gold_star_handler
      (show_stars
         {set_this {{coop_track_panel find scoreboard} find star_display}}
         {gold_star_flash.grp set showing TRUE}
      )
      (hide_stars
         {set_this {{coop_track_panel find scoreboard} find star_display}}
         {gold_star_flash.grp set showing FALSE}
      )
      (set_star_progress ($progress)
         {set_this {{coop_track_panel find scoreboard} find star_display}}
         {set $actual_scale {* $dx_star_mesh_scale $progress}}
         {set $unfilled {- 1.0 $progress}}
         {set $height {* 1.859 $dx_star_mesh_scale}}
         {$this iterate RndDir $dir {do
            {if {!= {$dir name} "star_indicator"}
               {{$dir find gold_star_flash.mesh} set_local_scale_index 2 $actual_scale}
               {{$dir find gold_star_flash.mesh} set_local_pos_index 2 {* $height {* $unfilled -1}}}
               {{$dir find gold_star_flash_border.mesh} set_local_pos_index 2 {* {* {- 0.5 $unfilled} $height} 2}}
            }
         }}
         {if {> $progress 0}
            {gold_star_flash.mat set (tex_xfm y_scale) $progress}
            {gold_star_flash.mat set (tex_xfm y) {/ {- 0.5 {* $progress 0.5}} $progress}}
         }
      )
      (start_anim
         {set_this {{coop_track_panel find scoreboard} find star_display}}
         {gold_star_flash.anim animate (loop 0 1) (period 2) (units kTaskBeats)}
      )
      (stop_anim
         {set_this {{coop_track_panel find scoreboard} find star_display}}
         {gold_star_flash.anim stop_animation}
      )
   }
   {set_this {{coop_track_panel find scoreboard} find star_display}}
   {new Group gold_star_flash.grp}
   {stars.grp add_object gold_star_flash.grp}
   {new Mat gold_star_flash.mat}
   {gold_star_flash.mat set diffuse_tex dx_star_gold_flash.tex}
   {gold_star_flash.mat set blend kBlendSrcAlpha}
   {gold_star_flash.mat set tex_gen kTexGenXfm}
   {gold_star_flash.mat set stencil_mode kStencilWrite}
   {gold_star_flash.mat set z_mode kZModeTransparent}
   {gold_star_flash.mat set alpha_cut TRUE}
   {gold_star_flash.mat set alpha_threshold 15}
   {new Mat gold_star_flash_border.mat}
   {gold_star_flash_border.mat set diffuse_tex plain.tex}
   {gold_star_flash_border.mat set stencil_mode kStencilTest}
   {gold_star_flash_border.mat set color {pack_color 0.98 0.95 0.51}}
   {gold_star_flash_border.mat set alpha 0.75}
   {gold_star_flash_border.mat set z_mode kZModeTransparent}
   {gold_star_flash_border.mat set blend kBlendSrcAlpha}
   {$this iterate RndDir $dir {do
      {if {!= {$dir name} "star_indicator"}
         {dx_create_gold_flash $dir {$this find gold_star_flash.mat} {$this find gold_star_flash.grp} {$this find gold_star_flash_border.mat}}
      }
   }}
   {new PropAnim gold_star_flash.anim}

   {gold_star_flash.anim add_keys gold_star_flash.mat (alpha) kPropFloat}
   {gold_star_flash.anim set_key_val gold_star_flash.mat (alpha) 0 1}
   {gold_star_flash.anim set_key_val gold_star_flash.mat (alpha) 1 0}
   ;{gold_star_flash.anim set_interp_type gold_star_flash.mat (alpha) kPropEaseIn}

   {gold_star_flash.anim add_keys gold_star_flash_border.mat (alpha) kPropFloat}
   {gold_star_flash.anim set_key_val gold_star_flash_border.mat (alpha) 0 0.75}
   {gold_star_flash.anim set_key_val gold_star_flash_border.mat (alpha) 1 0}
   ;{gold_star_flash.anim set_interp_type gold_star_flash_border.mat (alpha) kPropEaseIn}

   {set $dx_gold_flash_spawned TRUE}
}

{func dx_create_gold_flash ($stardir $starmat $stargrp $bordermat)
   {set_this $stardir}
   {new Mesh gold_star_flash.mesh}
   {gold_star_flash.mesh copy star_frame_gold.mesh kCopyShallow}
   {gold_star_flash.mesh set mat $starmat}
   {gold_star_flash.mesh set showing TRUE}
   {$stargrp add_object gold_star_flash.mesh}
   {set $dx_star_mesh_scale {gold_star_flash.mesh get_local_scale_index 0}}
   {new Mesh gold_star_flash_border.mesh}
   #ifndef HX_WII
   {dx_generate_quad_mesh gold_star_flash_border.mesh {* 1.859 $dx_star_mesh_scale} 0.17}
   {gold_star_flash_border.mesh set mat $bordermat}
   {gold_star_flash_border.mesh set showing TRUE}
   {gold_star_flash_border.mesh set_trans_parent star.grp}
   {gold_star_flash_border.mesh set_local_scale 2 2 2}
   {$stargrp add_object gold_star_flash_border.mesh}
   #endif
}

{func
   dx_check_for_real_guitar_cheat
   ($player $inst $user)
   {if {&& {$user is_local} {modifier_disabled mod_auto_play}}
      {if {|| {== $inst real_guitar} {== $inst real_bass}}
         {if
            {&&
               {!= {joypad_controller_type_padnum {$user get_pad_num}} hx_midi_guitar_xbox}
               {!= {joypad_controller_type_padnum {$user get_pad_num}} hx_midi_guitar_ps3}
               {!= {joypad_controller_type_padnum {$user get_pad_num}} hx_midi_guitar_wii}
            }
            {dx_reset_score}
         }
      }
   }
}
 
;super jank way of setting score to 0 and disabling scoring
{func
   dx_reset_score
   {unless {beatmatch is_invalid_score}
      {beatmatch set_invalid_score TRUE}
      {foreach_int $i 0 4
         {cheat_toggle_difficulty}
      }
   }
}

{func dx_load_synth ($synth)
   {if {game is_instrument_synth_on}
      {game toggle_instrument_synth}
   }
   {set $path {elem {find $syscfg sound instruments chamberlin_selections $synth} 1}}
   {dx_log_writer insane {sprint "Loading synth " $path}}
   {set $newinstrument {load_objects $path}}
   {$dx_chamberlin_dir iterate Object $obj
      {dx_log_writer insane {sprint "old: " $obj}}
      {unless {$obj is_a ObjectDir}
         {delete $obj}
      }
   }
   {$newinstrument iterate Object $obj
      {dx_log_writer insane {sprint "new: " $obj}}
      {unless {$obj is_a ObjectDir}
         {$obj set_name {$obj name} $dx_chamberlin_dir}
      }
   }
   {delete $newinstrument}
   {dx_log_writer insane {sprint "Loaded synth " $synth}}
   {set $dx_loaded_synth $synth}
}

{func dx_update_synth
   {if_else $dx_synth_enabled
      {do
         {if {!= $dx_loaded_synth $dx_selected_synth}
            {dx_load_synth $dx_selected_synth}
         }
         {unless {game is_instrument_synth_on}
            {game toggle_instrument_synth}
         }
         {game set_instrument_synth_volume 100}
      }
      {if {game is_instrument_synth_on}
         {game toggle_instrument_synth}
      }
   }
}