   (dxState_ControllerMenu
      (view
         os_instrumentswap
         os_pad_mapping
         os_button_remapper
         os_slot_options
         os_nav_controller
      )
      (select
         (os_instrumentswap {dx_state dxState_InstrumentSwap})
         (os_pad_mapping {dx_state dxState_PadMappingSwap})
         (os_button_remapper {dx_state dxState_ButtonRemapper})
         (os_slot_options
            ;{if_else $dx_slot_options_warn_seen
               {dx_state dxState_SlotOptions}
            ;   {dx_state dxState_SlotOptionsWarn}
            ;}
         )
         (os_nav_controller {dx_state dxState_NavController}) 
      )
      (cancel {dx_state dxState_DeluxeSettings})
   )

   (dxState_SlotOptions
      (view
         os_reset_everything
         os_allowed_instruments
         {if_else $dx_linear_join_order os_linear_join_order_on os_linear_join_order_off}
      )
      (enter
         ; temp until overshell size is fixed for warn list
         {unless $dx_slot_options_warn_seen
            {dx_passive_messenger os_slot_options_warn}
            {set $dx_slot_options_warn_seen TRUE}
         }
      )
      (select
         (os_reset_everything
            {set $dx_linear_join_order FALSE}

            {set $dx_instruments_slot_1 (guitar real_guitar keys)}
            {set $dx_instruments_slot_2 (drum)}
            {set $dx_instruments_slot_3 (vocals)}
            {set $dx_instruments_slot_4 (guitar real_guitar keys)}

            {set $dx_instruments_aim_slot_1 (guitar real_guitar keys drum vocals)}
            {set $dx_instruments_aim_slot_2 (guitar real_guitar keys drum vocals)}
            {set $dx_instruments_aim_slot_3 (guitar real_guitar keys drum vocals)}
            {set $dx_instruments_aim_slot_4 (guitar real_guitar keys drum vocals)}
            
            {set $dx_slot_restart_required TRUE}
            #ifdef RB3E
            {set $dx_slot_options_changed TRUE}
            #else
            {set $dx_slot_options_changed FALSE}
            #endif

            {if {! $dx_prompt_save} {dx_settings_dta_writer}}
         )
         (os_allowed_instruments {dx_state dxState_AllowedInstruments})
         (os_linear_join_order {set $dx_linear_join_order {! $dx_linear_join_order}} {set $dx_slot_options_changed TRUE} {set $dx_slot_restart_required TRUE})
      )
      (cancel
         #ifdef RB3E
         {if_else {&& $dx_slot_options_changed {! $dx_prompt_save}}
            {dx_state dxState_SlotOptionsReboot}
            {dx_state dxState_ControllerMenu}
         }
         #else
         {if {&& $dx_slot_options_changed {! $dx_prompt_save}} {dx_settings_dta_writer}}
         {set $dx_slot_options_changed FALSE}
         {dx_state dxState_ControllerMenu}
         #endif
      )
   )

   (dxState_AllowedInstruments
      (view
         os_allowed_instruments_normal
         mod_auto_vocals
      )
      (select
         (os_allowed_instruments_normal {set $editing_aim_slots FALSE} {dx_state dxState_Slots})
         (mod_auto_vocals {set $editing_aim_slots TRUE} {dx_state dxState_Slots})
      )
      (cancel {dx_state dxState_SlotOptions})
   )

   (dxState_Slots
      (view
         os_slot1
         os_slot2
         os_slot3
         os_slot4
      )
      (select
         (os_slot1 {set $slot_to_edit slot1} {dx_state dxState_AllowedInstrumentsForSlot})
         (os_slot2 {set $slot_to_edit slot2} {dx_state dxState_AllowedInstrumentsForSlot})
         (os_slot3 {set $slot_to_edit slot3} {dx_state dxState_AllowedInstrumentsForSlot})
         (os_slot4 {set $slot_to_edit slot4} {dx_state dxState_AllowedInstrumentsForSlot})
      )
      (cancel {dx_state dxState_AllowedInstruments})
   )


#define DX_APPLY_SLOT_OPTIONS
(
   {cond
      ({== $slot_to_edit slot1}
         {if_else $editing_aim_slots
            {set $dx_instruments_aim_slot_1 $current_slot_array}
            {set $dx_instruments_slot_1 $current_slot_array}
         }
      )
      ({== $slot_to_edit slot2}
         {if_else $editing_aim_slots
            {set $dx_instruments_aim_slot_2 $current_slot_array}
            {set $dx_instruments_slot_2 $current_slot_array}
         }
      )
      ({== $slot_to_edit slot3}
         {if_else $editing_aim_slots
            {set $dx_instruments_aim_slot_3 $current_slot_array}
            {set $dx_instruments_slot_3 $current_slot_array}
         }
      )
      ({== $slot_to_edit slot4}
         {if_else $editing_aim_slots
            {set $dx_instruments_aim_slot_4 $current_slot_array}
            {set $dx_instruments_slot_4 $current_slot_array}
         }
      )
   }
   {set $dx_slot_options_changed TRUE}
   {set $dx_slot_restart_required TRUE}
   {dx_state dxState_Slots}
)

   (dxState_AllowedInstrumentsForSlot
      (view
         os_allow_all
         os_strings_keys_only
         os_all_but_drums
         os_drums_only
         os_all_but_vocals
         os_vocals_only
         os_all_but_keys
         os_keys_only
      )
      (select
         (os_allow_all {set $current_slot_array (guitar real_guitar keys drum vocals)} DX_APPLY_SLOT_OPTIONS)
         (os_strings_keys_only {set $current_slot_array (guitar real_guitar keys)} DX_APPLY_SLOT_OPTIONS)
         (os_all_but_drums {set $current_slot_array (guitar real_guitar keys vocals)} DX_APPLY_SLOT_OPTIONS)
         (os_drums_only {set $current_slot_array (drum)} DX_APPLY_SLOT_OPTIONS)
         (os_all_but_vocals {set $current_slot_array (guitar real_guitar keys drum)} DX_APPLY_SLOT_OPTIONS)
         (os_vocals_only {set $current_slot_array (vocals)} DX_APPLY_SLOT_OPTIONS)
         (os_all_but_keys {set $current_slot_array (guitar real_guitar drum vocals)} DX_APPLY_SLOT_OPTIONS)
         (os_keys_only {set $current_slot_array (keys)} DX_APPLY_SLOT_OPTIONS)
      )
      (cancel {dx_state dxState_Slots})
   )

   (dxState_PadMappingSwap
      (view
         os_pad
         os_rbguitar
         os_ghguitar
         os_rbdrums
         os_rb2drums
         os_ghdrums
      )
      (message os_pad_mapping_select_desc)
      (select
         (os_pad {set $dx_joypad_pad_mapping joypad} DX_REMAP_PAD)
         (os_rbguitar {set $dx_joypad_pad_mapping #ifdef HX_PS3 hx_guitar_ps3 #else #ifdef HX_WII wii_guitar #else ro_guitar_xbox #endif #endif} DX_REMAP_PAD)
         (os_ghguitar {set $dx_joypad_pad_mapping #ifdef HX_PS3 ro_guitar_ps3 #else #ifdef HX_WII wii_guitar #else ro_guitar_xbox #endif #endif} DX_REMAP_PAD)
         (os_rbdrums {set $dx_joypad_pad_mapping #ifdef HX_PS3 hx_drums_ps3 #else #ifdef HX_WII wii_drums #else hx_drums_xbox #endif #endif} DX_REMAP_PAD)
         (os_rb2drums {set $dx_joypad_pad_mapping #ifdef HX_PS3 hx_drums_ps3 #else #ifdef HX_WII wii_drums #else hx_drums_xbox_rb2 #endif #endif} DX_REMAP_PAD)
         (os_ghdrums {set $dx_joypad_pad_mapping #ifdef HX_PS3 ro_drums_ps3 #else #ifdef HX_WII wii_rodrums #else ro_drums_xbox #endif #endif} DX_REMAP_PAD)
      )
      (cancel {dx_state dxState_ControllerMenu})
   )

   (dxState_InstrumentSwap
      (slot_swapped FALSE)
      (view
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 0}} os_blnk os_instreset}
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 1}} os_blnk all_instruments}
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 2} {!= $dx_list_pos 1}} os_blnk
            {sprint " - " {localize guitar} " -> " 
               {localize 
                  {switch $dx_joypad_type_guitar
                     (kControllerGuitar guitar)
                     (kControllerDrum drum)
                     (kControllerVocals vocals)
                     (kControllerKeys keys)
                     (kControllerRealGuitar pro_guitar)
                  }
               }
               " + "
            }
         }
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 3} {!= $dx_list_pos 1}} os_blnk
            {sprint " - " {localize drum} " -> " 
               {localize 
                  {switch $dx_joypad_type_drum
                     (kControllerGuitar guitar)
                     (kControllerDrum drum)
                     (kControllerVocals vocals)
                     (kControllerKeys keys)
                     (kControllerRealGuitar pro_guitar)
                  }
               }
               " + "
            }
         }
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 4} {!= $dx_list_pos 1}} os_blnk
            {sprint " - " {localize vocals} " -> " 
               {localize 
                  {switch $dx_joypad_type_vocals
                     (kControllerGuitar guitar)
                     (kControllerDrum drum)
                     (kControllerVocals vocals)
                     (kControllerKeys keys)
                     (kControllerRealGuitar pro_guitar)
                  }
               }
               " + "
            }
         }
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 5} {!= $dx_list_pos 1}} os_blnk
            {sprint " - " {localize keys} " -> " 
               {localize 
                  {switch $dx_joypad_type_keys
                     (kControllerGuitar guitar)
                     (kControllerDrum drum)
                     (kControllerVocals vocals)
                     (kControllerKeys keys)
                     (kControllerRealGuitar pro_guitar)
                  }
               }
               " + "
            }
         }
         {if_else {&& $dx_list_item_selected {!= $dx_list_pos 6} {!= $dx_list_pos 1}} os_blnk
            {sprint " - " {localize pro_guitar} " -> " 
               {localize 
                  {switch $dx_joypad_type_real_guitar
                     (kControllerGuitar guitar)
                     (kControllerDrum drum)
                     (kControllerVocals vocals)
                     (kControllerKeys keys)
                     (kControllerRealGuitar pro_guitar)
                  }
               }
               " + "
            }
         }
      )
      (message none)
      #define APPLY_TRACK_SWAP_TO_ALL
      (
         {set $dx_joypad_type_drum
            $dx_joypad_type_guitar
         }
         {set $dx_joypad_type_vocals
            $dx_joypad_type_guitar
         }
         {set $dx_joypad_type_keys
            $dx_joypad_type_guitar
         }
         {set $dx_joypad_type_real_guitar
            $dx_joypad_type_guitar
         }
      )
      #define LIST_INST_TYPE_SWAP
      (
         {if {!= {$current_list selected_data} 0}
            {switch {$current_list selected_data}
               (1
                  {set $this_var dx_joypad_type_guitar}
               )
               (2
                  {set $this_var dx_joypad_type_guitar}
               )
               (3
                  {set $this_var dx_joypad_type_drum}
               )
               (4
                  {set $this_var dx_joypad_type_vocals}
               )
               (5
                  {set $this_var dx_joypad_type_keys}
               )
               (6
                  {set $this_var dx_joypad_type_real_guitar}
               )
               
            }
            ;track our current list position for hiding other list elements while we have selected this one
            {set $dx_list_pos {$current_list selected_data}}
            ;actually set our variable, based on the pressed action
            {switch $action
               ((kAction_Left kAction_Down)
                  {if {> {eval {var {sprint $this_var}}} 0}
                     {set_var {sprint $this_var} {- {eval {var $this_var}} 1}}
                     {set_elem {find $syscfg dx_settings dxState_InstrumentSwap slot_swapped} 1 TRUE}
                  }
                  {if {== {$current_list selected_data} 1}
                     APPLY_TRACK_SWAP_TO_ALL
                  }
                  DX_SWAP_INSTRUMENT_TYPE
               )
               ((kAction_Right kAction_Up)
                  {if {< {eval {var {sprint $this_var}}} {- {size $dx_controller_type_list} 1}}
                     {set_var {sprint $this_var} {+ {eval {var $this_var}} 1}}
                     {set_elem {find $syscfg dx_settings dxState_InstrumentSwap slot_swapped} 1 TRUE}
                  }
                  {if {== {$current_list selected_data} 1}
                     APPLY_TRACK_SWAP_TO_ALL
                  }
                  DX_SWAP_INSTRUMENT_TYPE
               )
            }
         }
      )
      (enter
         {set $dx_pos_interval_list (0.01 0.02 0.05 0.10 0.15 0.20 0.25 0.30)}
         {set $dx_pos_current_interval {elem $dx_pos_interval_list $dx_pos_remapper_array_number}} ;1 unit
         {do
            ($arr {find $syscfg dx_settings $this_state view})
            ($data {array 0})
            {foreach $entry $arr
               {if {!= $entry view}
                  {push_back $data $entry}
               }
            }
            {$current_list set_data $data}
         }
         {set_elem {find $syscfg dx_settings dxState_InstrumentSwap slot_swapped} 1 FALSE}
      )
      (button
         (kAction_Confirm
            {if_else $dx_list_item_selected
               {set $dx_list_item_selected FALSE}
               {if_else {== {$current_list selected_data} 0} ;if we click reset
                  {do
                     DX_RESET_INST_TYPES
                     DX_SWAP_INSTRUMENT_TYPE
                     {set_elem {find $syscfg dx_settings dxState_InstrumentSwap slot_swapped} 1 TRUE}
                  }
                  {do
                     {set $dx_list_item_selected TRUE}
                     {set $dx_list_pos {$current_list selected_data}}
                  }
               }
            }
         )
         (kAction_Cancel
            {if_else $dx_list_item_selected
               {set $dx_list_item_selected FALSE}
               {do
                  {if_else {elem {find $syscfg dx_settings dxState_InstrumentSwap slot_swapped} 1}
                     {do
                        DX_SWAP_INSTRUMENT_TYPE
                        {if {! $dx_prompt_save} {dx_settings_dta_writer}}
                        {leave_dx_settings}
                        {overshell update_all}
                     }
                     {dx_state dxState_ControllerMenu}
                  }
               }
            }
         )
         ;if we pressed Up or Down while inside a selected list item
         (kAction_Down LIST_INST_TYPE_SWAP)
         (kAction_Up LIST_INST_TYPE_SWAP)
         ;if we pressed left or right while hovering on a specific list item
         (kAction_Left LIST_INST_TYPE_SWAP)
         (kAction_Right LIST_INST_TYPE_SWAP)
      )
      (exit
         {set $dx_list_pos 0}
         {set $dx_list_item_selected FALSE}
         {set $dx_pos_remapper_array_number 3}
      )
      ;(cancel {dx_state dxState_ControllerMenu})
   )
   
   (dxState_NavController
      (selected_pad FALSE)
      (view
         {sprint {if_else {== $dx_nav_controller_port -1} "> " "  "} {localize os_nav_pad_disabled}}
         {sprint {if_else {== $dx_nav_controller_port 1}  "> " "  "} {localize player} " 2"}
         {sprint {if_else {== $dx_nav_controller_port 2}  "> " "  "} {localize player} " 3"}
         {sprint {if_else {== $dx_nav_controller_port 3}  "> " "  "} {localize player} " 4"}
         #ifdef HX_PS3
         {sprint {if_else {== $dx_nav_controller_port 4}  "> " "  "} {localize player} " 5"}
         {sprint {if_else {== $dx_nav_controller_port 5}  "> " "  "} {localize player} " 6"}
         {sprint {if_else {== $dx_nav_controller_port 6}  "> " "  "} {localize player} " 7"}
         #endif
      )
      (enter
         {set_elem {find $syscfg dx_settings dxState_NavController selected_pad} 1 FALSE}
      )
      (message os_nav_controller_desc)
      (button
         (kAction_Confirm
            {switch {$current_list selected_data}
               (0 {set $dx_nav_controller_port -1})
               {if_else {== {{$this get_user} get_pad_num} {$current_list selected_data}}
                  {do
                     {set_elem {find $syscfg dx_settings dxState_NavController selected_pad} 1 {$current_list selected_data}}
                     {dx_state dxState_NavWarn}
                  }
                  {set $dx_nav_controller_port {$current_list selected_data}}
               }
            }
         )
         (kAction_Cancel {dx_state dxState_ControllerMenu})
      )
   )
   
   (dxState_NavWarn
      (view
         overshell_continue
         overshell_cancel
      )
      (enter
         {handle
            ($this set_confirm_actions dx_nav_warn (overshell_continue overshell_cancel))})
      (select
         (overshell_continue
            {set $dx_nav_controller_port {elem {find $syscfg dx_settings dxState_NavController selected_pad} 1}}
            {leave_dx_settings}
            {$this remove_user}
            {overshell update_all}
         )
         (overshell_cancel
            {dx_state dxState_NavController}
         )
      )
      (cancel
         {dx_state dxState_NavController}
      )
   )

