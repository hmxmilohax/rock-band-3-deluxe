(settings_state_main
    (back goto_tabs)
    (entries
        (header_test
            (type header)
        )
        (lyric_display
            (type setting_bool)
            (var dx_lyric_display_enabled)
            (on_changed {dx_log_writer insane {sprint "New value: " $new_value}})
        )
        (crowd_meter
            (type setting_enum)
            (var dx_crowd_meter_hud)
            (values (dx_on dx_off dx_disabled))
        )
        (something_whatever
            (type setting_bool)
            (var test)
        )

        (header_more_stuff
            (type header)
        )
        (progress_bar
            (type setting_bool)
            (var dx_song_progress_bar)
        )
        (fc_sound
            (type setting_bool)
            (var test)
        )
    )
)
(settings_state_more
    (back goto_tabs)
    (entries
        (header_hello
            (type header)
        )

        (test_setting
            (type setting_bool)
            (var test)
        )
    )
)