   {unless {== $dx_vocal_notes none} {set $dx_vocal_notes_needs_reset TRUE}}

   {unless {== $dx_vocal_overdrive none} {set $dx_vocal_overdrive_needs_reset TRUE}}

   {unless {== $dx_multiangle 1} {set $dx_use_multiangle TRUE}}

   {unless {== $dx_animated_gem none} {do {set $dx_animated_gems_enabled TRUE} {set $dx_animated_gem_needs_reset TRUE}}}
}
{func
   dx_track_theme_name
   ($dx_dta_name)
   #ifdef HX_XBOX {sprint "GAME:/dx_track_theme_" $dx_dta_name ".dta"} #endif
   #ifdef HX_WII {sprint "SD:/dx_track_theme_" $dx_dta_name ".dta"} #endif
   #ifdef HX_PS3 {sprint "GD:/dev_hdd0/game/" DX_TITLE_ID "/USRDIR/dx_track_theme_" $dx_dta_name ".dta"} #endif
}

{func
   dx_admin_mode
   {if {&& {== $dx_detected_platform platform_rpcs3} $dx_admin_mode}
      {if {! {exists dx_admin_script}}
         {thread_task kTaskSeconds (name dx_admin_script)
            (script
               {run {sprint "GD:/dev_hdd0/game/" DX_TITLE_ID "/USRDIR/ace_admin.dta"}}
               {if {== $dx_command_ran 1}
                  {write_file {sprint "GD:/dev_hdd0/game/" DX_TITLE_ID "/USRDIR/ace_admin.dta"} ""}
                  {set $dx_command_ran 0}
               }
               {$task sleep 1.5}
               {$task loop}
            )
         }
      }
   }
}
{func get_trill_interval
   ($default $pro)
   {do
      ($return $default)
      ;looser lanes from lysix, only apply to the correct input var if enabled
      ;{if {&& $extended_lanes {== $default 165}}
         ;extended is 190, but you can change it here
      ;   {set $return {+ $default 15}}
      ;} This was breaking all trill making them only visible but not applying their functionality.
      {if
         {&&
            {! $pro}
            ;if we do not have rb4 lanes enabled
            {! {modifier_mgr is_modifier_active mod_rb4_lanes}}
            ;and its an updated song
            {file_exists {sprint "songs/updates/" {meta_performer song} "/" {meta_performer song} "_update.mid"}}
            ; the song is a candidate within the list of valid pre rb3 sources
            {||
               {== $sourcevar rb1} {== $sourcevar rb1_dlc} {== $sourcevar rb2}
               {== $sourcevar ugc1} {== $sourcevar rbtp_vol_1} {== $sourcevar dlc}
               {== $sourcevar rbtp_vol_2} {== $sourcevar rbtp_classic_rock}
               {== $sourcevar rbtp_country_1} {== $sourcevar rbtp_metal}
               {== $sourcevar lego} {== $sourcevar rbtp_acdc} {== $sourcevar greenday}
            }
         }
         ;disable lanes
         {set $return -100}
      }
      ;if lanes are disabled
      {if {modifier_mgr is_modifier_active mod_nolanes}
         ;disable lanes
         {set $return -100}
      }
      ;return proper interval
      $return
   }
}
{func get_lane_interval
   ($default $pro)
   {do
      ($return $default)
      ;looser lanes from lysix, only apply to the correct input var if enabled
      {if {&& $extended_lanes {== $default 165}}
         ;extended is 190, but you can change it here
         {set $return {+ $default 15}}
      }
      {if
         {&&
            {! $pro}
            ;if we do not have rb4 lanes enabled
            {! {modifier_mgr is_modifier_active mod_rb4_lanes}}
            ;and its an updated song
            {file_exists {sprint "songs/updates/" {meta_performer song} "/" {meta_performer song} "_update.mid"}}
            ; the song is a candidate within the list of valid pre rb3 sources
            {||
               {== $sourcevar rb1} {== $sourcevar rb1_dlc} {== $sourcevar rb2}
               {== $sourcevar ugc1} {== $sourcevar rbtp_vol_1} {== $sourcevar dlc}
               {== $sourcevar rbtp_vol_2} {== $sourcevar rbtp_classic_rock}
               {== $sourcevar rbtp_country_1} {== $sourcevar rbtp_metal}
               {== $sourcevar lego} {== $sourcevar rbtp_acdc} {== $sourcevar greenday}
            }
         }
         ;disable lanes
         {set $return -100}
      }
      ;if lanes are disabled
      {if {modifier_mgr is_modifier_active mod_nolanes}
         ;disable lanes
         {set $return -100}
      }
      ;return proper interval
      $return
   }
}
; Labels use UTF-8 but DTA strings are latin-1. The only way (i think) to get proper UTF-8 strings is through locale.
{func fix_special_chars ($str)
   ; ISO 8859-1 (Latin-1) Entities
   ; Special Characters
   ;{search_replace $str " " {localize non_breaking_space} $str}
   {search_replace $str "¡" {localize inverted_exclamation_mark} $str}
   {search_replace $str "¢" {localize cent_sign} $str}
   {search_replace $str "£" {localize pound_sterling_sign} $str}
   {search_replace $str "¤" {localize general_currency_sign} $str}
   {search_replace $str "¥" {localize yen_sign} $str}
   {search_replace $str "¦" {localize broken_vertical_bar} $str}
   {search_replace $str "§" {localize section_sign} $str}
   {search_replace $str "¨" {localize spacing_dieresis_or_umlaut} $str}
   {search_replace $str "©" {localize copyright_sign} $str}
   {search_replace $str "ª" {localize feminine_ordinal_sign} $str}
   {search_replace $str "«" {localize left_double_angle_quote_or_guillemet} $str}
   {search_replace $str "¬" {localize logical_not_sign} $str}
   ;{search_replace $str "­" {localize soft_hyphen} $str}
   {search_replace $str "®" {localize registered_trademark_sign} $str}
   {search_replace $str "¯" {localize spacing_macron_long_accent} $str}
   {search_replace $str "°" {localize degree_sign} $str}
   {search_replace $str "±" {localize plus_or_minus_sign} $str}
   {search_replace $str "²" {localize superscript_2} $str}
   {search_replace $str "³" {localize superscript_3} $str}
   {search_replace $str "´" {localize spacing_acute_accent} $str}
   {search_replace $str "µ" {localize micro_sign_mu} $str}
   {search_replace $str "¶" {localize paragraph_sign_pilcrow_sign} $str}
   {search_replace $str "·" {localize middle_dot_centered_dot} $str}
   {search_replace $str "¸" {localize spacing_cedilla} $str}
   {search_replace $str "¹" {localize superscript_1} $str}
   {search_replace $str "º" {localize masculine_ordinal_indicator} $str}
   {search_replace $str "»" {localize right_double_angle_quote_or_guillemet} $str}
   {search_replace $str "¼" {localize fraction_one_quarter} $str}
   {search_replace $str "½" {localize fraction_one_half} $str}
   {search_replace $str "¾" {localize fraction_three_quarters} $str}
   {search_replace $str "¿" {localize inverted_question_mark} $str}

   ; Upper Case Latin-1 Letters
   {search_replace $str "À" {localize capital_a_grave} $str}
   {search_replace $str "Á" {localize capital_a_acute} $str}
   {search_replace $str "Â" {localize capital_a_circumflex} $str}
   {search_replace $str "Ã" {localize capital_a_tilde} $str}
   {search_replace $str "Ä" {localize capital_a_dieresis_or_umlaut} $str}
   {search_replace $str "Å" {localize capital_a_ring} $str}
   {search_replace $str "Æ" {localize capital_ae_ligature} $str}
   {search_replace $str "Ç" {localize capital_c_cedilla} $str}
   {search_replace $str "È" {localize capital_e_grave} $str}
   {search_replace $str "É" {localize capital_e_acute} $str}
   {search_replace $str "Ê" {localize capital_e_circumflex} $str}
   {search_replace $str "Ë" {localize capital_e_dieresis_or_umlaut} $str}
   {search_replace $str "Ì" {localize capital_i_grave} $str}
   {search_replace $str "Í" {localize capital_i_acute} $str}
   {search_replace $str "Î" {localize capital_i_circumflex} $str}
   {search_replace $str "Ï" {localize capital_i_dieresis_or_umlaut} $str}
   {search_replace $str "Ð" {localize capital_eth} $str}
   {search_replace $str "Ñ" {localize capital_n_tilde} $str}
   {search_replace $str "Ò" {localize capital_o_grave} $str}
   {search_replace $str "Ó" {localize capital_o_acute} $str}
   {search_replace $str "Ô" {localize capital_o_circumflex} $str}
   {search_replace $str "Õ" {localize capital_o_tilde} $str}
   {search_replace $str "Ö" {localize capital_o_dieresis_or_umlaut} $str}
   {search_replace $str "×" {localize multiplication_sign} $str}
   {search_replace $str "Ø" {localize capital_o_slash} $str}
   {search_replace $str "Ù" {localize capital_u_grave} $str}
   {search_replace $str "Ú" {localize capital_u_acute} $str}
   {search_replace $str "Û" {localize capital_u_circumflex} $str}
   {search_replace $str "Ü" {localize capital_u_dieresis_or_umlaut} $str}
   {search_replace $str "Ý" {localize capital_y_acute} $str}
   {search_replace $str "Þ" {localize capital_thorn} $str}
   {search_replace $str "ß" {localize small_sharp_s_sz_ligature} $str}

   ; Lower Case Latin-1 Letters
   {search_replace $str "à" {localize small_a_grave} $str}
   {search_replace $str "á" {localize small_a_acute} $str}
   {search_replace $str "â" {localize small_a_circumflex} $str}
   {search_replace $str "ã" {localize small_a_tilde} $str}
   {search_replace $str "ä" {localize small_a_dieresis_or_umlaut} $str}
   {search_replace $str "å" {localize small_a_ring} $str}
   {search_replace $str "æ" {localize small_ae_ligature} $str}
   {search_replace $str "ç" {localize small_c_cedilla} $str}
   {search_replace $str "è" {localize small_e_grave} $str}
   {search_replace $str "é" {localize small_e_acute} $str}
   {search_replace $str "ê" {localize small_e_circumflex} $str}
   {search_replace $str "ë" {localize small_e_dieresis_or_umlaut} $str}
   {search_replace $str "ì" {localize small_i_grave} $str}
   {search_replace $str "í" {localize small_i_acute} $str}
   {search_replace $str "î" {localize small_i_circumflex} $str}
   {search_replace $str "ï" {localize small_i_dieresis_or_umlaut} $str}
   {search_replace $str "ð" {localize small_eth} $str}
   {search_replace $str "ñ" {localize small_n_tilde} $str}
   {search_replace $str "ò" {localize small_o_grave} $str}
   {search_replace $str "ó" {localize small_o_acute} $str}
   {search_replace $str "ô" {localize small_o_circumflex} $str}
   {search_replace $str "õ" {localize small_o_tilde} $str}
   {search_replace $str "ö" {localize small_o_dieresis_or_umlaut} $str}
   {search_replace $str "÷" {localize division_sign} $str}
   {search_replace $str "ø" {localize small_o_slash} $str}
   {search_replace $str "ù" {localize small_u_grave} $str}
   {search_replace $str "ú" {localize small_u_acute} $str}
   {search_replace $str "û" {localize small_u_circumflex} $str}
   {search_replace $str "ü" {localize small_u_dieresis_or_umlaut} $str}
   {search_replace $str "ý" {localize small_y_acute} $str}
   {search_replace $str "þ" {localize small_thorn} $str}
   {search_replace $str "ÿ" {localize small_y_dieresis_or_umlaut} $str}
   $str
}
