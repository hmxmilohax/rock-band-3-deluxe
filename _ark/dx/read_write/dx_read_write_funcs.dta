         {do
            {set $dx_values {array 0}}
            {mmm_writin_dat_dta dx_values}
            {if {! {session is_in_game}}
               {write_file DX_VALUES_FILE_PATH $dx_values}
            }
            {set $dx_values {array 0}}
         }
   ;   }
   ;}
}
