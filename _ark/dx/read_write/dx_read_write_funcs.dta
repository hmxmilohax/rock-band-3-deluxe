#ifdef _SHIP
{func dx_settings_dta_writer
   ($type)
   ;we cant do this right now because xbox crashes on startup, presumabely these modifiers arent populated?
   {set $dx_settings {array 0}}
   ;prep some values before save
   {if {== {sprint $type} dx_settings}
      #ifndef HX_WII
      {set $platform_audio_latency {profile_mgr get_platform_audio_latency}}
      {set $platform_video_latency {profile_mgr get_platform_video_latency}}
      #endif
      {set $dx_pad_lag_gamepad {profile_mgr get_joypad_extra_lag PAD_NUM_GAMEPAD 0}}
      {set $dx_pad_lag_guitar_rb1 {profile_mgr get_joypad_extra_lag PAD_NUM_GUITAR_RB1 0}}
      {set $dx_pad_lag_guitar_rb2 {profile_mgr get_joypad_extra_lag PAD_NUM_GUITAR_RB2 0}}
      {set $dx_pad_lag_guitar_gh {profile_mgr get_joypad_extra_lag PAD_NUM_GUITAR_GH 0}}
      {set $dx_pad_lag_drums_rb1 {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_RB1 0}}
      {set $dx_pad_lag_drums_rb2 {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_RB2 0}}
      {set $dx_pad_lag_drums_gh {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_GH 0}}
      {set $dx_pad_lag_keys {profile_mgr get_joypad_extra_lag PAD_NUM_KEYS 0}}
      {set $dx_pad_lag_pro_guitar {profile_mgr get_joypad_extra_lag PAD_NUM_PRO_GUITAR 0}}
      {set $dx_pad_lag_pro_guitar_squier {profile_mgr get_joypad_extra_lag PAD_NUM_PRO_GUITAR_SQUIER 0}}
      #ifdef HX_PS3 {set $dx_pad_lag_drums_rr {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_RR 0}} #endif
      #ifdef HX_XBOX {set $dx_pad_lag_stage_kit {profile_mgr get_joypad_extra_lag PAD_NUM_STAGE_KIT 0}} #endif
   }
   {mmm_writin_dat_dta $type}
   {switch $type
      (dx_settings
         ;really kinda need to figure this one out
         {dx_setting_saver dx_settings dx_rb3dx_venue
            {if_else
               {&&
                  {== $force TRUE}
                  {contains $dx_valid_venues $dx_venue}
               }
               $dx_venue
               FALSE
            }
            {array 0}
         }
         {write_file DX_SETTINGS_FILE_PATH $dx_settings}
      )
      (dx_track_theme
         {write_file {dx_track_theme_name $dx_track_theme_name} $dx_settings}
         {if_else {file_exists {dx_track_theme_name $dx_track_theme_name}}
            {dx_passive_messenger track_theme_successfully_written}
            {dx_passive_messenger track_theme_failed_writing}
         }
      )
      (dx_values
         {write_file DX_VALUES_FILE_PATH $dx_settings}
      )
      (dx_modifiers
         {write_file DX_MODIFIER_FILE_PATH $dx_settings}
      )
   }
   {set $dx_settings {array 0}}
}
#endif
