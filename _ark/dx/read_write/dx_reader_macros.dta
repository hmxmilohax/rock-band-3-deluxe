#include dx_paths.dta
#include dx_writer_macros.dta
#define LOADING_DX_SETTINGS_OPTIONS
(
   {do
      ($truth FALSE)
      {foreach $elem {find $syscfg setting_storage}
         {if {== {type $elem} kDataArray}
            {if {== {elem $elem 0} {elem $entry 0}}
               {set $truth {find $syscfg setting_storage {elem $entry 0}}}
            }
         }
      }
      {if_else $truth
         {if {== {type $entry} kDataArray}
            {do
               ($size {size $truth})
               ($name {elem $truth 0})
               ($type {elem $truth 1})
               ($arr {if_else {== $size 3} {elem $truth 2} 0})
               {if_else {&& {!= {type $type} kDataInt} {== {sprint $type} "triple"}}
                  {if_else {&& $arr {== {type $arr} kDataArray}}
                     {dx_read_setting_triplet $name $arr}
                     kDataUnhandled
                  }
                  {if_else {== {type $type} kDataInt}
                     {do
                        ($hold {array 0})
                        {foreach_int $i 1 $type
                           {push_back $hold {eval {var {sprint $name $i}}}}
                        }
                        {dx_read_num_of_settings $type $name $name}
                     }
                     {dx_read_setting $name $type}
                  }
               }
            }
         }
         {if {== {elem $entry 0} debug_mode}
            {dx_log_writer insane
               {sprint
                  "DEBUG_MODE REJECTED: entry="
                  $entry
                  " truth="
                  $truth
               }
            }
         }
      }
   }

   {dx_fps_counter set_visible $dx_fps_counter}
   #ifndef HX_WII
   {profile_mgr set_platform_audio_latency $platform_audio_latency}
   {profile_mgr set_platform_video_latency $platform_video_latency}
   #endif
   {profile_mgr set_joypad_extra_lag PAD_NUM_GAMEPAD 0 $dx_pad_lag_gamepad}
   {profile_mgr set_joypad_extra_lag PAD_NUM_GUITAR_RB1 0 $dx_pad_lag_guitar_rb1}
   {profile_mgr set_joypad_extra_lag PAD_NUM_GUITAR_RB2 0 $dx_pad_lag_guitar_rb2}
   {profile_mgr set_joypad_extra_lag PAD_NUM_GUITAR_GH 0 $dx_pad_lag_guitar_gh}
   {profile_mgr set_joypad_extra_lag PAD_NUM_DRUMS_RB1 0 $dx_pad_lag_drums_rb1}
   {profile_mgr set_joypad_extra_lag PAD_NUM_DRUMS_RB2 0 $dx_pad_lag_drums_rb2}
   {profile_mgr set_joypad_extra_lag PAD_NUM_DRUMS_GH 0 $dx_pad_lag_drums_gh}
   {profile_mgr set_joypad_extra_lag PAD_NUM_KEYS 0 $dx_pad_lag_keys}
   {profile_mgr set_joypad_extra_lag PAD_NUM_PRO_GUITAR 0 $dx_pad_lag_pro_guitar}
   {profile_mgr set_joypad_extra_lag PAD_NUM_PRO_GUITAR_SQUIER 0 $dx_pad_lag_pro_guitar_squier}
   #ifdef HX_PS3
   {profile_mgr set_joypad_extra_lag PAD_NUM_DRUMS_RR 0 $dx_pad_lag_drums_rr}
   #endif
   #ifdef HX_XBOX
   {profile_mgr set_joypad_extra_lag PAD_NUM_STAGE_KIT 0 $dx_pad_lag_stage_kit}
   #endif
)
#define LOADING_TRACK_THEME_OPTIONS
(
   {do
      ($truth
         {if {find_exists $syscfg theme_storage {elem $entry 0}}
            {find $syscfg theme_storage {elem $entry 0}}
         }
      )
      {if $truth
         {if {== {type $entry} kDataArray}
            {do
               ($size {size $truth})
               ($name {elem $truth 0})
               ($type {elem $truth 1})
               ($arr {if_else {== $size 3} {elem $truth 2} 0})
               {if_else {&& {!= {type $type} kDataInt} {== {sprint $type} "triple"}}
                  {if_else {&& $arr {== {type $arr} kDataArray}}
                     {dx_read_setting_triplet $name $arr}
                     kDataUnhandled
                  }
                  {if_else {== {type $type} kDataInt}
                     {do
                        ($hold {array 0})
                        {foreach_int $i 1 $type
                           {push_back $hold {eval {var {sprint $name $i}}}}
                        }
                        {dx_read_num_of_settings $type $name $name}
                     }
                     {dx_read_setting $name $type}
                  }
               }
            }
         }
      }
   }
)
#define LOADING_VALUES_OPTIONS
(
   {dx_read_setting_triplet mic_vols (mic_vol_1 mic_vol_2 mic_vol_3)}
   {dx_read_setting default_slot0 string}
   {dx_read_setting default_slot1 string}
   {dx_read_setting default_slot2 string}
   {dx_read_setting default_slot3 string}
   {dx_read_setting default_diff0 string}
   {dx_read_setting default_diff1 string}
   {dx_read_setting default_diff2 string}
   {dx_read_setting default_diff3 string}
   {dx_read_setting dx_song_select_sort_setting_1 int}
   {dx_read_setting dx_song_select_score_setting_strings unsafe}
   {dx_read_setting dx_song_select_score_setting_drums unsafe}
   {dx_read_setting dx_song_select_score_setting_vocals unsafe}
   {dx_read_setting dx_song_select_score_setting_keys unsafe}
   {dx_read_setting dx_song_select_score_setting_pro_strings unsafe}
   {dx_read_setting dx_entered_play_a_show bool}
)
#define LOADING_EVENT_OPTIONS
(
   {dx_read_setting dx_event_mode bool}
   {if $dx_event_mode
      {dx_read_setting dx_event_name string}
      ;{dx_read_setting dx_event_passcode}
      {dx_read_setting dx_event_logo_path unsafe}
      {dx_read_setting dx_event_type string}
      {dx_read_setting dx_event_service bool}
   }
)
