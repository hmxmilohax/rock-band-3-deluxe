#define DX_SETTINGS_POPULATION
(
   #ifndef HX_WII
   {set $platform_audio_latency {profile_mgr get_platform_audio_latency}}
   {set $platform_video_latency {profile_mgr get_platform_video_latency}}
   #endif
   {set $dx_pad_lag_gamepad {profile_mgr get_joypad_extra_lag PAD_NUM_GAMEPAD 0}}
   {set $dx_pad_lag_guitar_rb1 {profile_mgr get_joypad_extra_lag PAD_NUM_GUITAR_RB1 0}}
   {set $dx_pad_lag_guitar_rb2 {profile_mgr get_joypad_extra_lag PAD_NUM_GUITAR_RB2 0}}
   {set $dx_pad_lag_guitar_gh {profile_mgr get_joypad_extra_lag PAD_NUM_GUITAR_GH 0}}
   {set $dx_pad_lag_drums_rb1 {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_RB1 0}}
   {set $dx_pad_lag_drums_rb2 {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_RB2 0}}
   {set $dx_pad_lag_drums_gh {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_GH 0}}
   {set $dx_pad_lag_keys {profile_mgr get_joypad_extra_lag PAD_NUM_KEYS 0}}
   {set $dx_pad_lag_pro_guitar {profile_mgr get_joypad_extra_lag PAD_NUM_PRO_GUITAR 0}}
   {set $dx_pad_lag_pro_guitar_squier {profile_mgr get_joypad_extra_lag PAD_NUM_PRO_GUITAR_SQUIER 0}}
   #ifdef HX_PS3 {set $dx_pad_lag_drums_rr {profile_mgr get_joypad_extra_lag PAD_NUM_DRUMS_RR 0}} #endif
   #ifdef HX_XBOX {set $dx_pad_lag_stage_kit {profile_mgr get_joypad_extra_lag PAD_NUM_STAGE_KIT 0}} #endif

   {foreach $entry {find $syscfg setting_storage}
      {if {== {type $entry} kDataArray}
         {do
            ($size {size $entry})
            ($name {elem $entry 0})
            ($type {elem $entry 1})
            ($arr {if_else {== $size 3} {elem $entry 2} 0})
            {if_else {&& {!= {type $type} kDataInt} {== {sprint $type} "triple"}}
               {if_else {&& $arr {== {type $arr} kDataArray}}
                  {do
                     ($hold {array 0})
                     {push_back $hold {eval {var {elem $arr 0}}}}
                     {push_back $hold {eval {var {elem $arr 1}}}}
                     {push_back $hold {eval {var {elem $arr 2}}}}
                     {dx_setting_saver dx_settings $name {eval $hold}}
                  }
                  kDataUnhandled
               }
               {if_else {== {type $type} kDataInt}
                  {do
                     ($hold {array 0})
                     {foreach_int $i 1 $type
                        {push_back $hold {eval {var {sprint $name $i}}}}
                     }
                     {dx_setting_saver dx_settings $name {eval $hold}}
                  }
                  {dx_setting_saver dx_settings $name {eval {var $name}}}
               }
            }
         }
      }
   }
   {dx_setting_saver dx_settings dx_rb3dx_venue
      {if_else
         {&&
            {== $force TRUE}
            {contains $dx_valid_venues $dx_venue}
         }
         $dx_venue
         FALSE
      }
   }
)
#define DX_TRACK_THEME_POPULATION
(
   {foreach $entry {find $syscfg theme_storage}
      {if {== {type $entry} kDataArray}
         {do
            ($size {size $entry})
            ($name {elem $entry 0})
            ($type {elem $entry 1})
            ($arr {if_else {== $size 3} {elem $entry 2} 0})
            {if_else {&& {!= {type $type} kDataInt} {== {sprint $type} "triple"}}
               {if_else {&& $arr {== {type $arr} kDataArray}}
                  {do
                     ($hold {array 0})
                     {push_back $hold {eval {var {elem $arr 0}}}}
                     {push_back $hold {eval {var {elem $arr 1}}}}
                     {push_back $hold {eval {var {elem $arr 2}}}}
                     {dx_setting_saver dx_track_theme $name {eval $hold}}
                  }
                  kDataUnhandled
               }
               {if_else {== {type $type} kDataInt}
                  {do
                     ($hold {array 0})
                     {foreach_int $i 1 $type
                        {push_back $hold {eval {var {sprint $name $i}}}}
                     }
                     {dx_setting_saver dx_track_theme $name {eval $hold}}
                  }
                  {dx_setting_saver dx_track_theme $name {eval {var {elem $entry 0}}}}
               }
            }
         }
      }
   }
)
#define DX_VALUES_POPULATION
(
   
   {dx_setting_saver dx_values mic_vols ({profile_mgr get_mic_vol 0} {profile_mgr get_mic_vol 1} {profile_mgr get_mic_vol 2})}
   {dx_setting_saver dx_values default_slot0 $default_slot0}
   {dx_setting_saver dx_values default_slot1 $default_slot1}
   {dx_setting_saver dx_values default_slot2 $default_slot2}
   {dx_setting_saver dx_values default_slot3 $default_slot3}
   {dx_setting_saver dx_values default_diff0 $default_diff0}
   {dx_setting_saver dx_values default_diff1 $default_diff1}
   {dx_setting_saver dx_values default_diff2 $default_diff2}
   {dx_setting_saver dx_values default_diff3 $default_diff3}
   {dx_setting_saver dx_values dx_song_select_sort_setting_1 $dx_song_select_sort_setting_1}
   {dx_setting_saver dx_values dx_song_select_score_setting_strings $dx_song_select_score_setting_strings}
   {dx_setting_saver dx_values dx_song_select_score_setting_drums $dx_song_select_score_setting_drums}
   {dx_setting_saver dx_values dx_song_select_score_setting_vocals $dx_song_select_score_setting_vocals}
   {dx_setting_saver dx_values dx_song_select_score_setting_keys $dx_song_select_score_setting_keys}
   {dx_setting_saver dx_values dx_song_select_score_setting_pro_strings $dx_song_select_score_setting_pro_strings}
   {dx_setting_saver dx_values dx_entered_play_a_show $dx_entered_play_a_show}
)
#define DX_MODIFIER_POPULATION
(
   {dx_setting_saver dx_modifiers mod_static_fills {modifier_mgr is_modifier_active mod_static_fills}}
   {dx_setting_saver dx_modifiers mod_chord_numbers {modifier_mgr is_modifier_active mod_chord_numbers}}
   {dx_setting_saver dx_modifiers mod_nohud {modifier_mgr is_modifier_active mod_nohud}}
   {dx_setting_saver dx_modifiers mod_miss_sounds {modifier_mgr is_modifier_active mod_miss_sounds}}
   {dx_setting_saver dx_modifiers mod_remote_texture_sync {modifier_mgr is_modifier_active mod_remote_texture_sync}}
   {dx_setting_saver dx_modifiers mod_char_hide {modifier_mgr is_modifier_active mod_char_hide}}
   {dx_setting_saver dx_modifiers mod_practiceoverdrive {modifier_mgr is_modifier_active mod_practiceoverdrive}}
   {dx_setting_saver dx_modifiers mod_kick_bounce {modifier_mgr is_modifier_active mod_kick_bounce}}
   {dx_setting_saver dx_modifiers mod_nolanes {modifier_mgr is_modifier_active mod_nolanes}}
   {dx_setting_saver dx_modifiers mod_rb4_lanes {modifier_mgr is_modifier_active mod_rb4_lanes}}
   {dx_setting_saver dx_modifiers mod_synced_track_speeds {modifier_mgr is_modifier_active mod_synced_track_speeds}}
   {dx_setting_saver dx_modifiers mod_nopause {modifier_mgr is_modifier_active mod_nopause}}
   {dx_setting_saver dx_modifiers mod_dx_no_overdrive {modifier_mgr is_modifier_active mod_dx_no_overdrive}}
   {dx_setting_saver dx_modifiers mod_mhx_color_shuffle {modifier_mgr is_modifier_active mod_mhx_color_shuffle}}
   {dx_setting_saver dx_modifiers mod_highlight_key {modifier_mgr is_modifier_active mod_highlight_key}}
   {dx_setting_saver dx_modifiers mod_vocal_coda {modifier_mgr is_modifier_active mod_vocal_coda}}
)
#define DX_LOG_CLEAR
(
   {if {file_exists DX_LOG_FILE_PATH}
      {write_file DX_LAST_LOG_FILE_PATH {read_file DX_LOG_FILE_PATH}}
      {set $dx_log_reader ("start of log")}
      {write_file DX_LOG_FILE_PATH {array $dx_log_reader}}
   }
)
#define DX_DEPRECATED_DTA_WRITER
(
   ;{dx_log_writer info {sprint "Macro: DX_DEPRECATED_DTA_WRITER"}}
   ;{dx_log_writer info
   ;   {sprintf "Executed DX_DEPRECATED_DTA_WRITER - time: %.4fms"
         {time
            {if {file_exists DX_DEPRECATED_SETTINGS_FILE_PATH}
            	{write_file DX_DEPRECATED_SETTINGS_FILE_PATH
				      {array
				         (
				            "This RB3DX configuration file has been deprecated and is no longer in use."
				            "Navigate to 'dx_settings.dta' to find what you're looking for."
				            "You may safely delete this file."
				         )
				      }
				   }
            }
            {if {file_exists DX_DEPRECATED_TRACK_THEME_FILE_PATH}
               {write_file DX_DEPRECATED_TRACK_THEME_FILE_PATH
                  {array
                     (
                        "This RB3DX configuration file has been deprecated and is no longer in use."
                        "You may safely delete this file."
                     )
                  }
               }
            }
            {if {file_exists DX_DEPRECATED_MODIFIER_FILE_PATH}
            	{write_file DX_DEPRECATED_MODIFIER_FILE_PATH
				      {array
				         (
				            "This RB3DX configuration file has been deprecated and is no longer in use."
				            "Navigate to 'dx_modifiers.dta' to find what you're looking for."
				            "You may safely delete this file."
				         )
				      }
				   }
            }
            {if {file_exists DX_DEPRECATED_VALUES_FILE_PATH}
            	{write_file DX_DEPRECATED_VALUES_FILE_PATH
				      {array
				         (
				            "This RB3DX configuration file has been deprecated and is no longer in use."
				            "Navigate to 'dx_values.dta' to find what you're looking for."
				            "You may safely delete this file."
				         )
				      }
				   }
            }
            {if {file_exists "GAME:/playashow.dta"}
               {write_file "GAME:/playashow.dta"
                  {array
                     (
                        "This RB3DX configuration file has been deprecated and is no longer in use."
                        "Play a show no longer requires any configuration externally"
                        "You may safely delete this file."
                     )
                  }
               }
            }
         }
   ;   }
   ;}
)