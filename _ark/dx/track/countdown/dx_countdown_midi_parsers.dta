#define DX_COMMON_MIDI
(

   (track_name
      {switch {quasiquote {unquote $entry}}
         (guitar 'PART GUITAR') (bass 'PART BASS')
         (real_guitar 'PART REAL_GUITAR') (real_bass 'PART REAL_BASS')
         (vocals 'PART VOCALS') (harm 'HARM1')
         kDataUnhandled
      }
   )
   (inverted FALSE) (up FALSE) (append_length TRUE) (compress TRUE)
   (message_type midi_parser) (mp.up FALSE) (idle)
   (allowed_notes
      {switch {quasiquote {unquote $entry}}
         ((guitar bass) (96 97 98 99 100 103 120)) ;103 = solo, 120 = lowest of BRE
         ((real_guitar real_bass) (96 97 98 99 100 101 120)) ;120: BRE
         ((vocals harm) (105 106))
         kDataUnhandled
      }
   )
   (firstgem 0) (firstbeat 0) (breaknum 0) (note_start 0) (note_prevend 0)
   (last_note_start 0) (final_note 0) (tracker 1) (tracker2 0)
)
{foreach $entry (guitar bass real_guitar real_bass vocals harm)
   {do
      {set_var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}} {array 0}}
      {set_var {eval {quasiquote {sprint {unquote $entry} "_note_tracker_2"}}} {array 0}}
      {notify "inst: " {quasiquote {unquote $entry}}}
      {notify "inst: " {eval {quasiquote {sprint {unquote $entry} "_note_tracker_2"}}}}
      {notify "inst: " {eval {quasiquote {sprint {unquote $entry} "_note_tracker_2"}}}}
      ;first count notes and breaks to get the correct size for our actual parser next
      {new
         MidiParser
         {sprint "timer_" {unquote $entry}}
         DX_COMMON_MIDI
         (midi
            {unless [firstgem]
               {set [firstgem] TRUE}
               {set [firstbeat] {int $mp.start}}
               {set [last_note_start] 0} ; cache note start time
               {if {> [firstbeat] 16}
                  {++ [tracker]}
               }
            }
            {if {&& {>= $mp.prev_end 16} {< $mp.prev_end 10000}}
               {++ [tracker]}
            }
            {if {&& {!= {quasiquote {unquote $entry}} harm} {!= {quasiquote {unquote $entry}} vocals}}
               {if $dx_perfects_indicator
                  {if {&& {!= $mp.val 103} {!= $mp.val 120}}
                     {if {> {- $mp.start [last_note_start]} 0}
                        {++ [tracker2]}
                        {set [last_note_start] $mp.start} ; cache note start time
                     }
                  }
               }
            }
         )
         (term
            {set_var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}} {array [tracker]}}
            {set_var {eval {quasiquote {sprint {unquote $entry} "_note_tracker_2"}}} {array [tracker2]}}
            {notify {eval {quasiquote {sprint {unquote $entry} " tracker1: " [tracker]}}}}
            {notify {eval {quasiquote {sprint {unquote $entry} " tracker2: " [tracker2]}}}}
            {notify
               {eval
                  {quasiquote {sprint {unquote $entry} " note tracker: "}} 
                  {eval {var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}}}}
               }
            }
         )
      }
      {notify "eval: " {quasiquote {unquote $entry}}}
      {notify "eval: " {eval {quasiquote {sprint {unquote $entry} "_note_tracker_2"}}}}
      ;populate the previously sized arrays with data
      {new
         MidiParser
         {sprint "eval_" {unquote $entry}}
         DX_COMMON_MIDI
         (midi
            {unless [firstgem]
               {set [firstgem] TRUE}
               {set [breaknum] 0}
               {set [firstbeat] {int $mp.start}}
               {set [last_note_start] 0} ; cache note start time
               {if {> [firstbeat] 16}
                  {set_elem {eval {var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}}}}
                     [tracker]
                     {array ("delay_0" 0 [firstbeat])}
                  }
                  {set [breaknum] 1}
                  {++ [tracker]}
                  {notify {eval {quasiquote {sprint {unquote $entry} " _evaltracker1: " [tracker]}}}}
                  {notify {eval {quasiquote {sprint {unquote $entry} " _evaltracker2: " [tracker2]}}}}
                  {notify {eval {quasiquote {sprint {unquote $entry} " _evalnote tracker: "}}  {eval {var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}}}}}}
               }
            }
            {if {&& {>= $mp.prev_end 16} {< $mp.prev_end 10000}}
               {set [note_start] {int $mp.start}}
               {set [note_prevend] {int {- [note_start] $mp.prev_end}}}
               {set_elem {eval {var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}}}}
                  [tracker]
                  {array ({sprint "delay_" [breaknum]} [note_prevend] [note_start])}
               }
               {++ [breaknum]}
               {++ [tracker]}
            }
            {set [final_note] {int $mp.end}}
            {if {> [final_note] $dx_final_note}
               {set $dx_final_note [final_note]}
            }
            {if {&& {!= {quasiquote {unquote $entry}} harm} {!= {quasiquote {unquote $entry}} vocals}}
               {if $dx_perfects_indicator
                  {if {&& {!= $mp.val 103} {!= $mp.val 120}}
                     {if {> {- $mp.start [last_note_start]} 0}
                        {set_elem {eval {var {eval {quasiquote {sprint {unquote $entry} "_note_tracker_2"}}}}}
                           [tracker2]
                           {* {beat_to_seconds $mp.start} 1000}
                        }
                        {++ [tracker2]}
                        {set [last_note_start] $mp.start} ; cache note start time
                     }
                  }
               }
            }
         )
         (term
            {notify {eval {quasiquote {sprint {unquote $entry} " _evaltracker1: " [tracker]}}}}
            {notify {eval {quasiquote {sprint {unquote $entry} " _evaltracker2: " [tracker2]}}}}
            {notify {eval {quasiquote {sprint {unquote $entry} " _evalnote tracker: "}}  {eval {var {eval {quasiquote {sprint {unquote $entry} "_note_tracker"}}}}}}}
         )
      }
   }
}

{new
   MidiParser
   guitar_overdrive_timer
   (track_name 'PART GUITAR')
   (inverted FALSE)
   (up FALSE)
   (append_length TRUE)
   (compress TRUE)
   ;(message_type midi_parser)
   (mp.up FALSE)
   (idle)
   (allowed_notes
      (116)
   )
   (midi
      {push_back $guitar_note_tracker {array ({sprint "overdrive_" {int $mp.start}} {int $mp.start} {int $mp.end})}}
   )
}
