;the definitions to the dx stuff here are actually on track_panel, and defined in ../dx/track/beatmatch/dx_beatmatch_handles.dta
;I dont like it either. this isnt an object so i cant cleanly define and $this them all here
;all of the `beatmatch_task`s assume attached to coop_track_panel, so do that
(callbacks
   (sixteenth_note
      {if {! {gamemode in_mode trainer}}
         {if {|| $dx_od_ready_popups $dx_track_overdrive}
            {thread_task kTaskBeats (script {coop_track_panel dx_overdrive_calc})}
         }
         {if $dx_mtv_line_section
            {thread_task kTaskBeats (script {coop_track_panel dx_mtv_section_update})}
         }
         ; BAD - fix the scoreboard and star positions in case users drop in/out
         {thread_task kTaskBeats
            (script
               {dx_set_scoreboard_pos}
               {dx_set_star_display_pos}
            )
         }
         ; BAD - catch up bot deployments if someone deployed between beats
         {dx_bot_overdrive_handler}
      }
      {if_else #ifdef HX_WII FALSE #else $stagekit #endif
         {stagekit_left_right kStageSweepLeft_fast kStageSweepRight_fast}
         {handle (game quarterbeat)}
      }
   )
   (eighth_note
      #ifndef HX_WII
      {if $stagekit
         {stagekit_left_right kStageSweepLeft_medium kStageSweepRight_medium}
      }
      #endif
   )
   (beat
      {if {! {gamemode in_mode trainer}}
         {if {&& $dx_refresh_beatmatch $dx_customizer}
            {coop_track_panel track_texture_reset_handler}
            {color_me_milo_lite}
         }
         {if $dx_mtv_line_bpm
            {thread_task kTaskBeats (script {coop_track_panel dx_bpm_fetcher})}
         }
         {thread_task kTaskBeats (script {coop_track_panel dx_update_and_hide_guitar_fx})}
         {thread_task kTaskBeats (script {coop_track_panel dx_bot_overdrive})}
         {thread_task kTaskBeats (script {coop_track_panel dx_update_gold_flash})}
         {if {! {gamemode in_mode practice}}
            {if $dx_countdown_enabled
               {thread_task kTaskBeats (script {coop_track_panel dx_countdown})}
            }
            {if $dx_end_song_feedback
               {thread_task kTaskBeats (script {coop_track_panel dx_end_song_feedback})}
            }
         }
      }
      {if_else #ifdef HX_WII FALSE #else $stagekit #endif
         {stagekit_left_right kStageSweepLeft_slow kStageSweepRight_slow}
         {handle (game beat)}
      }
   )
   (downbeat
      {unless $stagekit
         {handle (game downbeat)}
      }
   )
   (reset)
)
#define DX_ROLL_INTERVAL_COMMON (
   {get_lane_interval 0}
   {get_lane_interval 0}
   {get_lane_interval 165}
   {get_lane_interval 165}
)
#define DX_TRILL_INTERVAL_COMMON_PRO (
   {get_trill_interval 0}
   {get_trill_interval 0}
   {get_trill_interval 160}
   {get_trill_interval 160}
)
(watcher
   (slop
      {cond
         ({modifier_enabled mod_precision} 50) ;precision mode, gh3/ch style
         ({modifier_enabled mod_calibration} 15) ;really strict window, great for calibrating
         ({modifier_enabled mod_chmode} 750) ;whale pussy mode
         ({> $speedmod 1.0} {* 100 $speedmod}) ;if speedup, compensate for song speed in the note window
         ({<= $speedmod 1.0} 100) ;if 100% or less, use stock 100ms window (which is proportional)
      }
   )
   (cheat_error 0)
   (autoplay_accuracy
      {switch $dx_bot_skill
         (0 50) ; 1 / 2
         (1 80) ; 1 / 5 
         (2 90) ; 1 / 10
         (3 95) ; 1 / 20
         (4 96.666) ; 1 / 30
         (5 98) ; 1 / 50
         (6 99) ; 1 / 100
         (7 99.6) ; 1 / 250
         (8 99.8) ; 1 / 500
         (9 99.9) ; 1 / 1000
         (10 99.96) ; 1 / 2500
         (11 100) ; 1 / infinity
      }
   )
   (pitch_bend_range 1)
   (ms_to_full_pitch_bend 1000)
   (cymbal_autoplay_ms 0) ;dx fix cymbal "glitch" - vanilla: 90
   (trill_interval_ms (DX_TRILL_INTERVAL_COMMON_PRO))
   (keyboard_miss_window_ms 200)
   (real_guitar_miss_window_ms 200)
   (keyboard_fat_finger_window_ms 100)
   (roll_interval_ms
      (drum
         (single_lane (DX_ROLL_INTERVAL_COMMON))
         (double_lane
            ({get_lane_interval 0 FALSE}
               {get_lane_interval 0 FALSE}
               {get_lane_interval 255 FALSE}
               {get_lane_interval 255 FALSE}
            )
         )
      )
      (guitar (DX_ROLL_INTERVAL_COMMON))
      (bass (DX_ROLL_INTERVAL_COMMON))
      (real_guitar (DX_ROLL_INTERVAL_COMMON))
      (real_guitar_22 (DX_ROLL_INTERVAL_COMMON))
      (real_bass (DX_ROLL_INTERVAL_COMMON))
      (real_bass_22 (DX_ROLL_INTERVAL_COMMON))
      (real_keys (DX_ROLL_INTERVAL_COMMON))
   )
)
(parser
   (drum_style_instruments (kAudioDrums))
   (vocal_style_instruments (kAudioVocals))
   (keyboard_range_shift_duration_ms 200)
   (player_slot 9)
)
(audio
   (default_style unmute)
   (mute_volume -96.0) ;dx full mute stems on miss - vanilla: -16.0
   (mute_volume_vocals -12.0)
   (multiplayer_scale 0.33)
   (multiplayer_attenuation 3.0)
   (multiplayer_common_attenuation 1.5)
   (background_attenuation 1.5)
   (cue_attenuation 0.0)
   (remote_attenuation 1.5)
   (drum_velocity_to_db (0.0 -13.0 -7.0 -3.0 -2.0 -0.5 0.0))
   (drum_sample_attenuation #ifdef HX_WII -12.0 #else 3.0 #endif)
   (whammy_enabled $dx_whammy_fx)
   (auto_miss_sound_timeout_seconds 5.0)
   (auto_miss_sound_timeout_gems 5)
   (auto_miss_sound_timeout_gems_remote 10)
   #include drum_mixes.dta
)
#merge ../../../system/run/config/beatmatch.dta